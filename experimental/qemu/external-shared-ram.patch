- *   static __thread AioContext *current_aio_context;
- *   ...
- *   static void coroutine_fn foo(void)
- *   {
- *       aio_notify(current_aio_context);
- *       qemu_coroutine_yield();
- *       aio_notify(current_aio_context); // <-- may be stale after yielding!
- *   }
