-    qatomic_rcu_set(&(head)->tqh_first, (elm));                         \
-    (elm)->field.tqe_circ.tql_prev = &(head)->tqh_circ;                 \
-} while (/*CONSTCOND*/0)
-
-#define QTAILQ_INSERT_TAIL_RCU(head, elm, field) do {                   \
