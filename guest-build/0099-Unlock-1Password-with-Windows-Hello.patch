+def unlock_onepassword(user: str) -> bool:
+    """Ask Windows Hello to approve one 1Password unlock for this desktop user.
+
+    The root-only 1Password agent calls this after polkit has asked it to
+    authenticate the installed 1Password app; it answers polkit itself only
+    when this returns success.
+    """
+    try:
+        guest_id, credential_id, key = load_state()
+        request = make_request("onepassword-unlock", guest_id, credential_id=credential_id, user=user, requesting_user=user)
+        verify_approval(request, exchange(request), key)
+        return True
+    except (ApprovalError, OSError, TimeoutError, ConnectionError, subprocess.SubprocessError):
+        return False
+
+
 def main() -> int:
+    if len(sys.argv) == 3 and sys.argv[1] == "onepassword-unlock":
+        if os.getuid() != 0 or os.geteuid() != 0:
+            return 1
+        return 0 if unlock_onepassword(sys.argv[2]) else 1
     if len(sys.argv) != 2 or sys.argv[1] not in {"enroll", "disable", "pam"}:
-        print("usage: windows-hello-broker enroll|disable|pam", file=sys.stderr)
+        print("usage: windows-hello-broker enroll|disable|pam|onepassword-unlock USER", file=sys.stderr)
         return 2
     if sys.argv[1] == "pam":
         return 0 if authenticate_pam() else 1
diff --git a/guest/factory-overlay/usr/local/sbin/try-omarchy-windows-hello b/guest/factory-overlay/usr/local/sbin/try-omarchy-windows-hello
