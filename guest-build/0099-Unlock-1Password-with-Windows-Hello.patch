--- a/guest/factory-overlay/usr/local/sbin/try-omarchy-windows-hello
+++ b/guest/factory-overlay/usr/local/sbin/try-omarchy-windows-hello
@@ -7,8 +7,40 @@ policy=/etc/pam.d/sudo
 rule=$'auth\t\tsufficient\tpam_exec.so quiet seteuid stdout /usr/local/lib/try-omarchy/windows-hello-broker pam'
 
 (( EUID == 0 )) || { echo 'Run with sudo to confirm your guest password.' >&2; exit 1; }
+
+# 1Password: unlock the installed app with the same Windows Hello pairing.
+onepassword() {
+  local user=${SUDO_USER:-} unit
