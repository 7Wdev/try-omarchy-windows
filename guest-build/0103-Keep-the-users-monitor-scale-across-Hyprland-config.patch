+configured_scale = float(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2] else None
 if (
     len(data) < 128
     or data[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00"
@@ -73,25 +88,29 @@ def scale_for_mode(
     physical_width_mm: int,
     physical_height_mm: int,
