From 9fc9254aadbdec970ff655e6beb76df060f1e6f3 Mon Sep 17 00:00:00 2001
From: itsmunzir <itsmunzir@users.noreply.github.com>
Date: Mon, 28 Sep 2026 09:50:52 +0300
Subject: [PATCH] Keep the user's monitor scale across Hyprland config reloads

Display sync replaced the scale from monitors.lua with the scale it guessed from the EDID. A user set omarchy_monitor_scale to 3. After each config reload the scale returned to 1.

The script now reads that variable. A number wins over the EDID scale and is rounded to the closest clean value for the synced mode, since the mode follows the window size and Hyprland warns about a scale that does not divide it. auto keeps the old behavior. The QEMU profile fragment applies the same rule to the recorded mode. Compatibility revision 40 delivers the script and the fragment to existing guests.
---
 .../hypr-monitors-qemu.append.lua             | 38 +++++++++++
 guest/fragments/hypr-monitors-qemu.append.lua | 38 +++++++++++
 .../usr/local/bin/omarchy-native-display-sync | 55 ++++++++++-----
 guest/scripts/finalize-rootfs.sh              |  4 +-
 guest/tests/verify.py                         | 67 ++++++++++++++++++-
 5 files changed, 183 insertions(+), 19 deletions(-)

diff --git a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
index e388dce..0727813 100644
--- a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
+++ b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
@@ -57,10 +57,48 @@ local function omarchy_synced_display_mode()
   return mode, scale
 end
 
+-- Hyprland needs the scaled size to land on whole pixels, and the synced mode
+-- follows the window size. Pick the closest clean scale the way display sync
+-- does, so a scale set here does not raise Hyprland's invalid scale warning.
+local function omarchy_clean_scale(mode, requested)
+  if type(math) ~= "table" or type(math.floor) ~= "function" then
+    return nil
+  end
+  local numbers = {}
+  for number in mode:gmatch("%d+") do
+    numbers[#numbers + 1] = tonumber(number)
+  end
+  local width, height = numbers[2], numbers[6]
+  if not width or not height then
+    return nil
+  end
+  local target = math.floor(requested * 120 + 0.5)
+  local best
+  for candidate = 30, 960 do
+    if (width * 120) % candidate == 0 and (height * 120) % candidate == 0 then
+      local distance = math.abs(candidate - target)
+      if not best or distance < math.abs(best - target) or (distance == math.abs(best - target) and candidate > best) then
+        best = candidate
+      end
+    end
+  end
+  if not best then
+    return nil
+  end
+  local scale = string.format("%.6f", best / 120):gsub("0+$", ""):gsub("%.$", "")
+  return scale
+end
+
 if omarchy_kernel_option_enabled("omarchy.qemu=1") then
   hl.config({ cursor = { invisible = false } })
   local synced_mode, synced_scale = omarchy_synced_display_mode()
   if synced_mode then
+    -- A number the user set in this file is explicit intent and outranks
+    -- the scale guessed from the EDID; "auto" keeps the guessed scale.
+    local user_scale = tonumber(omarchy_monitor_scale)
+    if user_scale and user_scale > 0 then
+      synced_scale = omarchy_clean_scale(synced_mode, user_scale) or synced_scale
+    end
     hl.monitor({ output = "", mode = synced_mode, scale = synced_scale })
   end
   o.exec_on_start("/usr/local/bin/omarchy-native-display-sync")
