+  # Several displays share the single catch-all rule, so read the file once.
+  user_scale=$(configured_scale)
   shopt -s nullglob
   for connector in "$drm_root"/card*-Virtual-*; do
     [[ -d $connector && -r $connector/status && -r $connector/edid ]] || continue
@@ -257,7 +279,7 @@ apply_preferred_modes() {
 
