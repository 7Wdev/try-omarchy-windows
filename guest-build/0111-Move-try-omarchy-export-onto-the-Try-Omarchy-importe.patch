 #!/bin/bash
-# Export the parts of this trial worth carrying to a real Omarchy install:
-# configuration under the home directory, the current theme, and the packages
-# added on top of the factory image. Writes one archive with a restore script
-# inside it, to the shared Windows folder when one is mounted, otherwise to
-# the home directory. Only an explicit allowlist of desktop configuration is
-# copied so credentials hidden in unrelated application config stay behind.
+# Pack this trial into one archive for another computer or a clean Omarchy
+# install: settings, themes, the apps you added, and the folders, app data,
+# browser profiles and keys you pick. The Try Omarchy importer does the work
+# and travels inside the archive, so the new install runs the same code with
+# import.sh. Installing Omarchy next to Windows needs no export at all: the
+# importer reads the trial straight off the Windows drive.
 #
-# Usage: try-omarchy-export [DESTINATION-DIRECTORY]
+# Usage: try-omarchy-export [DESTINATION-DIRECTORY] [--select LIST] [--yes]
+# Default destination: /mnt/host when the Windows share is mounted, else $HOME.
 set -euo pipefail
 
-usage() {
-  echo "Usage: try-omarchy-export [DESTINATION-DIRECTORY]"
-  echo "Default destination: /mnt/host when the Windows share is mounted, else \$HOME."
-}
-
-fail() {
-  echo "try-omarchy-export: $*" >&2
-  exit 1
-}
-
-case ${1:-} in
-  -h | --help)
-    usage
-    exit 0
-    ;;
-esac
-
-destination=${1:-}
-if [[ -z $destination ]]; then
-  if mountpoint -q /mnt/host && [[ -w /mnt/host ]]; then
-    destination=/mnt/host
-  else
-    destination=$HOME
-  fi
-fi
-[[ -d $destination && -w $destination ]] || fail "destination is not a writable directory: $destination"
-
-factory_lock=${TRY_OMARCHY_FACTORY_LOCK:-/usr/share/try-omarchy/packages.lock.txt}
-[[ -f $factory_lock ]] || fail "factory package list not found: $factory_lock"
-
-stamp=$(date +%Y%m%d-%H%M%S)
-name="omarchy-export-$stamp"
-work=$(mktemp -d)
-trap 'rm -rf "$work"' EXIT
-stage="$work/$name"
-mkdir -p "$stage/home" "$stage/packages"
