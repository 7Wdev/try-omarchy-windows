-  theme=$(omarchy-theme-current 2>/dev/null || true)
-  theme=${theme//$'\n'/}
-fi
-printf '%s\n' "$theme" >"$stage/theme"
-
-# Packages the user added beyond the factory image, split into the ones the
-# repositories provide and the ones that came from the AUR.
-pacman -Qqe 2>/dev/null | LC_ALL=C sort >"$work/explicit"
-awk '{print $1}' "$factory_lock" | LC_ALL=C sort >"$work/factory"
-LC_ALL=C comm -23 "$work/explicit" "$work/factory" >"$work/added"
-# pacman exits nonzero when nothing is foreign; that is the common case here.
-{ pacman -Qqm 2>/dev/null || true; } | LC_ALL=C sort >"$work/foreign"
-LC_ALL=C comm -23 "$work/added" "$work/foreign" >"$stage/packages/repo.txt"
-LC_ALL=C comm -12 "$work/added" "$work/foreign" >"$stage/packages/aur.txt"
