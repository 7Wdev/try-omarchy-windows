-# Configuration. Do not copy ~/.config wholesale: GitHub clients, sync tools,
-# browsers, and other applications commonly store credentials there. Keep this
-# list limited to Omarchy and desktop configuration that is useful on the real
-# install. The archive is still user data and should be reviewed before it is
-# shared with anyone.
-copy_home() {
-  local relative=$1
-  [[ -e $HOME/$relative ]] || return 0
-  mkdir -p "$stage/home/$(dirname "$relative")"
-  cp -a "$HOME/$relative" "$stage/home/$relative"
-}
-for item in \
-  .config/alacritty .config/autostart .config/btop .config/fastfetch \
-  .config/fcitx5 .config/fontconfig .config/foot .config/ghostty \
-  .config/hypr .config/imv .config/kitty .config/mako .config/omarchy \
-  .config/starship.toml .config/tmux .config/uwsm .config/walker \
-  .config/waybar .config/wireplumber .config/xournalpp \
-  .local/bin \
-  .bashrc .bash_profile .zshrc .zprofile .profile .gitconfig \
-  .tmux.conf .vimrc .inputrc; do
-  copy_home "$item"
-done
