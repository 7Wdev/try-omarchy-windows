 guest/scripts/finalize-rootfs.sh              |   4 +-
 guest/tests/test_overlay_scripts.py           | 211 ++++--------------
 guest/tests/verify.py                         |  14 +-
 4 files changed, 66 insertions(+), 369 deletions(-)

