-#!/bin/bash
-# Restore a Try Omarchy export on a real Omarchy install. Run it as the user
-# who should receive the configuration, from the extracted export directory.
-# It backs up anything it replaces under ~/.omarchy-restore-backup/<time>.
-set -euo pipefail
-here=$(cd "$(dirname "$0")" && pwd)
-backup_root="$HOME/.omarchy-restore-backup"
-mkdir -p "$backup_root"
-backup=$(mktemp -d "$backup_root/$(date +%Y%m%d-%H%M%S).XXXXXX")
-
-# Dotfiles are replaced as units. ~/.config and ~/.local/share are merged one
-# application directory at a time, so the real install keeps configuration
-# for apps the trial never touched.
-entries() {
-  find "$here/home" -mindepth 1 -maxdepth 1 ! -name .config ! -name .local -print0
-  [[ -d $here/home/.config ]] && find "$here/home/.config" -mindepth 1 -maxdepth 1 -print0
-  [[ -d $here/home/.local/share ]] && find "$here/home/.local/share" -mindepth 1 -maxdepth 1 -print0
-  [[ -e $here/home/.local/bin ]] && printf '%s\0' "$here/home/.local/bin"
-  return 0
-}
-
-incomplete=0
-echo "Restoring configuration into $HOME (backups in $backup)"
-while IFS= read -r -d '' path; do
-  relative=${path#"$here/home/"}
-  target="$HOME/$relative"
-  # The destination owns its Omarchy installation and display configuration.
-  [[ $relative == .local/share/omarchy ]] && continue
-  if [[ $relative == .config/hypr && ( -L $path || -L $target ) ]]; then
-    echo "Skipped linked Hyprland configuration; review it manually: $path" >&2
-    incomplete=1
-    continue
-  fi
-  if [[ -e $target || -L $target ]]; then
-    mkdir -p "$backup/$(dirname "$relative")"
-    mv "$target" "$backup/$relative"
-  fi
-  mkdir -p "$(dirname "$target")"
-  cp -a "$path" "$target"
-  if [[ $relative == .config/hypr ]]; then
-    for monitor in monitors.lua monitors.conf; do
-      saved="$backup/$relative/$monitor"
-      if [[ -e $saved || -L $saved ]]; then
-        cp -a --remove-destination "$saved" "$target/$monitor"
-      fi
-    done
-  fi
-  echo "  restored $relative"
-done < <(entries)
-
-if [[ -s $here/packages/repo.txt ]]; then
-  echo "Installing repository packages"
-  if ! sudo pacman -S --needed --noconfirm - <"$here/packages/repo.txt"; then
-    echo "Repository packages remain incomplete; review packages/repo.txt" >&2
-    incomplete=1
-  fi
-fi
-if [[ -s $here/packages/aur.txt ]]; then
-  if ! command -v yay >/dev/null; then
-    echo "AUR packages remain incomplete: yay is unavailable; review packages/aur.txt" >&2
-    incomplete=1
-  elif ! yay -S --needed --noconfirm - <"$here/packages/aur.txt"; then
-    echo "AUR packages remain incomplete; review packages/aur.txt" >&2
-    incomplete=1
-  fi
-fi
-
-theme=$(<"$here/theme")
-if [[ -n $theme ]]; then
-  if ! command -v omarchy-theme-set >/dev/null; then
-    echo "Theme restore remains incomplete: omarchy-theme-set is unavailable" >&2
-    incomplete=1
-  elif ! omarchy-theme-set "$theme"; then
-    echo "Theme $theme could not be selected; pick it from the Omarchy menu" >&2
-    incomplete=1
-  fi
-fi
-if ((incomplete)); then
-  echo "Restore incomplete. Configuration backups are in $backup; review the errors above." >&2
+importer=${TRY_OMARCHY_IMPORTER:-/usr/local/lib/try-omarchy/try-omarchy-import.pyz}
+if [[ ! -f $importer ]]; then
+  echo "try-omarchy-export: the importer is missing ($importer). Update Omarchy from the Try Omarchy launcher." >&2
   exit 1
 fi
-echo "Done. Log out and back in to load the restored configuration."
-RESTORE
