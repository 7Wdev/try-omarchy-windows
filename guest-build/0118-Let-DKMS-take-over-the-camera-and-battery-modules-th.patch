From 19339a23ffba26c6f204c5e24bac2c1dc88d973d Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Thu, 1 Oct 2026 23:40:22 -0400
Subject: [PATCH 118/119] Let DKMS take over the camera and battery modules the
 launcher delivers

---
 .../share/dkms/modules_to_force_install/try-omarchy   |  1 +
 guest/scripts/finalize-rootfs.sh                      |  5 ++++-
 guest/tests/verify.py                                 | 11 ++++++++++-
 3 files changed, 15 insertions(+), 2 deletions(-)
 create mode 100644 guest/factory-overlay/usr/share/dkms/modules_to_force_install/try-omarchy

diff --git a/guest/factory-overlay/usr/share/dkms/modules_to_force_install/try-omarchy b/guest/factory-overlay/usr/share/dkms/modules_to_force_install/try-omarchy
new file mode 100644
index 0000000..bd01eea
--- /dev/null
+++ b/guest/factory-overlay/usr/share/dkms/modules_to_force_install/try-omarchy
@@ -0,0 +1 @@
+v4l2loopback_version-override try-omarchy-battery_version-override
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 48da38d..3da1033 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -143,6 +143,7 @@ compat_paths=(
   etc/UPower/UPower.conf.d/90-try-omarchy.conf
   etc/systemd/system/service.d/10-try-omarchy-watchdog.conf
   usr/src/try-omarchy-battery-1.0.0
+  usr/share/dkms/modules_to_force_install/try-omarchy
   etc/systemd/system/try-omarchy-catch-up.service
   etc/systemd/system/multi-user.target.wants/try-omarchy-catch-up.service
   usr/local/bin/omarchy-native-display-sync
@@ -212,7 +213,9 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 42 makes SSH accept only keys for the quick-start account.
 # Revision 43 follows Windows time-zone changes while preserving guest choices.
 # Revision 44 moves try-omarchy-export onto the Try Omarchy importer.
-compat_revision=44
+# Revision 45 lets DKMS take over the camera and battery modules the launcher
+# delivered, so installing matching headers no longer prints install errors.
+compat_revision=45
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
diff --git a/guest/tests/verify.py b/guest/tests/verify.py
index 3b16d5a..7bcd2bd 100755
--- a/guest/tests/verify.py
+++ b/guest/tests/verify.py
@@ -291,13 +291,22 @@ def main() -> None:
 
     finalize_rootfs = read(GUEST / "scripts/finalize-rootfs.sh")
     compat_paths = finalize_rootfs.split("compat_paths=(", 1)[1].split(")", 1)[0]
+    # The launcher delivers its kernel's camera and battery modules. When matching
+    # headers arrive, DKMS must replace them (keeping the delivered copy to put
+    # back on removal) instead of refusing an identical module as an error.
+    check(
+        read(GUEST / "factory-overlay/usr/share/dkms/modules_to_force_install/try-omarchy").split()
+        == ["v4l2loopback_version-override", "try-omarchy-battery_version-override"],
+        "DKMS takes over the delivered camera and battery modules",
+    )
     watchdog_dropin = read(GUEST / "factory-overlay/etc/systemd/system/service.d/10-try-omarchy-watchdog.conf")
     check(
         "[Service]\nWatchdogSec=0\n" in watchdog_dropin,
         "system services run without watchdogs, which fire after Windows sleeps",
     )
     check(
-        "compat_revision=44" in finalize_rootfs
+        "compat_revision=45" in finalize_rootfs
+        and "usr/share/dkms/modules_to_force_install/try-omarchy" in compat_paths
         and "usr/local/lib/try-omarchy/try-omarchy-import.pyz" in compat_paths
         and "usr/local/bin/try-omarchy-timezone" in compat_paths
         and "etc/systemd/system/multi-user.target.wants/try-omarchy-timezone.service" in compat_paths
-- 
