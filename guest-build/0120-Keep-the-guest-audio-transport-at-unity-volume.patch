 guest/scripts/finalize-rootfs.sh              |   2 +-
 guest/tests/test_windows_audio_bridge.py      | 147 ++++++++++++++++++
 guest/tests/verify.py                         |   2 +-
 4 files changed, 264 insertions(+), 13 deletions(-)

diff --git a/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge b/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
index 55e9833..bc636d9 100755
--- a/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
+++ b/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
@@ -8,6 +8,7 @@ import json
 import os
 from pathlib import Path
 import select
+import signal
 import subprocess
 import sys
 import time
@@ -23,15 +24,20 @@ def log(message: str) -> None:
 
 
 def run_pactl(*arguments: str, check: bool = True) -> str:
-    result = subprocess.run(
-        ["pactl", *arguments],
-        stdin=subprocess.DEVNULL,
-        stdout=subprocess.PIPE,
-        stderr=subprocess.PIPE,
-        text=True,
-        timeout=10,
-        check=False,
-    )
+    try:
+        result = subprocess.run(
+            ["pactl", *arguments],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            timeout=10,
+            check=False,
+        )
+    except (OSError, subprocess.TimeoutExpired) as error:
+        if check:
+            raise RuntimeError(f"pactl {' '.join(arguments[:2])}: {error}") from error
+        return ""
     if check and result.returncode != 0:
         detail = result.stderr.strip() or f"status {result.returncode}"
         raise RuntimeError(f"pactl {' '.join(arguments[:2])}: {detail}")
@@ -94,12 +100,98 @@ class PipeWireMirror:
         }
         self.last_health_check = 0.0
         self.pending: dict[str, tuple[str | None, float]] = {}
+        self.transport_volume: tuple[str, list[int]] | None = None
+        self.transport_name: str | None = None
+        self.transport_owned = False
+        self.transport_pending = False
+        self.rebuild_volume: list[int] | None = None
 
-    def close(self) -> None:
+    def _unload_modules(self) -> None:
         for module_id in reversed(self.module_ids):
             run_pactl("unload-module", module_id, check=False)
         self.module_ids.clear()
 
+    def close(self) -> None:
+        self._observe_transport_volume()
+        restore = self.transport_volume if self.transport_owned else None
+        self._unload_modules()
+        self.transport_volume = None
+        self.transport_name = None
+        self.transport_owned = False
+        self.transport_pending = False
+        self.rebuild_volume = None
+        if restore is not None:
+            name, volumes = restore
+            try:
+                run_pactl("set-sink-volume", name, *map(str, volumes))
+            except RuntimeError:
+                pass
+
+    def _observe_transport_volume(self) -> None:
+        if self.transport_volume is None or self.transport_pending:
+            return
+        try:
+            name, original = self.transport_volume
+            sink = next((sink for sink in self._sink_details() if sink.get("name") == name), None)
+            if sink is not None:
+                current = self._channel_volumes(sink)
+                if current != [65536] * len(original):
+                    self.transport_owned = False
+                self.rebuild_volume = current
+        except (RuntimeError, ValueError, TypeError, KeyError):
+            # An unreadable current gain cannot authorize replacing it.
+            self.transport_owned = False
+            self.rebuild_volume = None
+
+    @staticmethod
+    def _sink_details() -> list[dict[str, Any]]:
+        sinks = json.loads(run_pactl("--format=json", "list", "sinks"))
+        if not isinstance(sinks, list) or any(not isinstance(sink, dict) for sink in sinks):
+            raise ValueError("invalid sink details")
+        return sinks
+
+    @staticmethod
+    def _channel_volumes(sink: dict[str, Any]) -> list[int]:
+        channels = sink.get("volume")
+        if not isinstance(channels, dict) or any(not isinstance(channel, dict) for channel in channels.values()):
+            raise ValueError("invalid sink volume")
+        volumes = [channel["value"] for channel in channels.values()]
+        if not volumes or any(type(value) is not int or not 0 <= value <= 0xffffffff for value in volumes):
+            raise ValueError("invalid sink channel volumes")
+        return volumes
+
+    def _prepare_transport_volume(self, name: str) -> None:
+        self.transport_name = name
+        self.transport_pending = True
+        try:
+            sink = next((sink for sink in self._sink_details() if sink.get("name") == name), None)
+            properties = sink.get("properties") if sink is not None else None
+            if not isinstance(properties, dict) or properties.get("alsa.card_name") != "VirtIO SoundCard":
+                self.transport_pending = False
+                return
+            if self.transport_volume is None:
+                self.transport_volume = (name, self._channel_volumes(sink))
+                self.transport_owned = True
+        except (RuntimeError, ValueError, TypeError, KeyError):
+            log("Could not capture QEMU audio transport volume; will retry")
+
+    def _finish_transport_volume(self) -> None:
+        if not self.transport_pending or self.transport_name is None:
+            return
+        if self.transport_volume is None:
+            self._prepare_transport_volume(self.transport_name)
+            if self.transport_volume is None:
+                return
+        name, _ = self.transport_volume
+        try:
+            if self.transport_owned:
+                run_pactl("set-sink-volume", name, "100%")
+            elif self.rebuild_volume is not None:
+                run_pactl("set-sink-volume", name, *map(str, self.rebuild_volume))
+            self.transport_pending = False
+        except RuntimeError:
+            log("Could not set QEMU audio transport volume; will retry")
+
     def apply(self, message: dict[str, Any]) -> None:
         # A catalog echo can arrive between two quick picker changes. Capture
         # the second local change before applying the echo to either direction.
@@ -131,11 +223,13 @@ class PipeWireMirror:
                     selected = requested
             self._set_selected(direction, selected)
             self.last_sent[direction] = selected
+        self._finish_transport_volume()
 
     def poll_selection(self) -> None:
         now = time.monotonic()
         if now - self.last_health_check >= 2:
             self.last_health_check = now
+            self._finish_transport_volume()
             loaded = loaded_module_ids()
             if self.module_ids and not set(self.module_ids).issubset(loaded):
                 self.inventory = None
@@ -197,7 +291,8 @@ class PipeWireMirror:
         outputs: list[dict[str, str]],
         inputs: list[dict[str, str]],
     ) -> None:
-        self.close()
+        self._observe_transport_volume()
+        self._unload_modules()
         sinks = [name for name in short_names("sinks") if not name.startswith(PREFIX)]
         sources = [
             name
@@ -209,6 +304,14 @@ class PipeWireMirror:
         transport_sink = next((name for name in sinks if name.startswith("alsa_output.")), sinks[0])
         transport_source = next((name for name in sources if name.startswith("alsa_input.")), sources[0]) if sources else None
 
+        if self.transport_name is not None and self.transport_name != transport_sink:
+            self.close()
+
+        # Capture before graph changes; set gain after remaps and selections.
+        # The visible remap owns guest volume. WirePlumber's transport default
+        # otherwise adds a second, hidden gain (normally 40%). Keep mute intact.
+        self._prepare_transport_volume(transport_sink)
+
         output_records = [{"deviceUID": None, "name": "Windows System Default"}, *outputs]
         input_records = [{"deviceUID": None, "name": "Windows System Default"}, *inputs] if inputs else []
         self.output_uids = {}
@@ -266,6 +369,7 @@ def open_port() -> int:
 
 
 def main() -> int:
+    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
     descriptor = open_port()
 
     def send(message: dict[str, Any]) -> None:
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 3da1033..18179df 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -215,7 +215,7 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
