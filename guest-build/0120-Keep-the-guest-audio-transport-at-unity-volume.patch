diff --git a/guest/tests/test_windows_audio_bridge.py b/guest/tests/test_windows_audio_bridge.py
index 99c8faf..363b738 100644
--- a/guest/tests/test_windows_audio_bridge.py
+++ b/guest/tests/test_windows_audio_bridge.py
@@ -4,6 +4,8 @@
 from __future__ import annotations
 
 import importlib.util
+import json
+import subprocess
 from importlib.machinery import SourceFileLoader
 from pathlib import Path
 import unittest
@@ -22,6 +24,31 @@ bridge = importlib.util.module_from_spec(SPEC)
 SPEC.loader.exec_module(bridge)
 
 
+class PactlFailureTests(unittest.TestCase):
+    def test_timeout_and_missing_program_are_reported_as_command_errors(self) -> None:
+        for error in (subprocess.TimeoutExpired("pactl", 10), FileNotFoundError("pactl")):
+            with self.subTest(error=type(error).__name__), mock.patch.object(bridge.subprocess, "run", side_effect=error):
+                with self.assertRaises(RuntimeError):
+                    bridge.run_pactl("--format=json", "list", "sinks")
+                self.assertEqual(bridge.run_pactl("unload-module", "100", check=False), "")
+
+    def test_unload_timeout_does_not_skip_transport_restoration(self) -> None:
+        mirror = bridge.PipeWireMirror(lambda _: None)
+        mirror.module_ids = ["100"]
+        mirror.transport_volume = ("virtio", [26214, 32768])
+        mirror.transport_owned = True
+        sink = {"name": "virtio", "volume": {"left": {"value": 65536}, "right": {"value": 65536}}}
+        def command(arguments, **kwargs):
+            if arguments[1] == "unload-module":
+                raise subprocess.TimeoutExpired(arguments, 10)
+            output = json.dumps([sink]) if arguments[1] == "--format=json" else ""
+            return subprocess.CompletedProcess(arguments, 0, output, "")
+        with mock.patch.object(bridge.subprocess, "run", side_effect=command) as run:
+            mirror.close()
+        self.assertEqual(run.call_args_list[-1].args[0], ["pactl", "set-sink-volume", "virtio", "26214", "32768"])
+        self.assertIsNone(mirror.transport_volume)
+
+
 class PactlStub:
     """Small pactl model that records the graph built by PipeWireMirror."""
 
@@ -32,11 +59,31 @@ class PactlStub:
         self.calls: list[tuple[tuple[str, ...], bool]] = []
         self.next_module_id = 100
         self.loaded_modules: set[str] = set()
+        self.volumes = [26214, 26214]
+        self.card_name = "VirtIO SoundCard"
+        self.details_error = False
+        self.reset_on_load = False
+        self.fail_volume_once = False
+        self.fail_load_once = False
         self.default_sink = self.transport_sink
         self.default_source = self.transport_source
 
     def __call__(self, *arguments: str, check: bool = True) -> str:
         self.calls.append((arguments, check))
+        if arguments == ("--format=json", "list", "sinks"):
+            if self.details_error:
+                raise RuntimeError("PipeWire unavailable")
+            return json.dumps([{
+                "name": self.transport_sink,
+                "properties": {"alsa.card_name": self.card_name},
+                "volume": {str(index): {"value": value} for index, value in enumerate(self.volumes)},
+            }])
+        if arguments[:2] == ("set-sink-volume", self.transport_sink):
+            if self.fail_volume_once:
+                self.fail_volume_once = False
+                raise RuntimeError("volume unavailable")
+            self.volumes = [65536] * len(self.volumes) if arguments[2] == "100%" else list(map(int, arguments[2:]))
+            return ""
         if arguments == ("list", "short", "sinks"):
             return f"10\t{self.transport_sink}\tmodule-alsa-card.c\ts16le 2ch 48000Hz\tRUNNING\n"
         if arguments == ("list", "short", "sources"):
@@ -44,6 +91,11 @@ class PactlStub:
         if arguments == ("list", "short", "modules"):
             return "\n".join(f"{module_id}\tmodule" for module_id in self.loaded_modules)
         if arguments and arguments[0] == "load-module":
+            if self.fail_load_once:
+                self.fail_load_once = False
+                raise RuntimeError("module unavailable")
+            if self.reset_on_load:
+                self.volumes = [26214, 26214]
             module_id = str(self.next_module_id)
             self.next_module_id += 1
             self.loaded_modules.add(module_id)
@@ -158,6 +210,101 @@ class PipeWireMirrorTests(unittest.TestCase):
         self.addCleanup(mirror.close)
         return mirror, pactl, sent
 
+    def test_transport_gain_is_unity_and_restored_on_close(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        pactl.volumes = [26214, 32768]
+        mirror.apply(catalog_message())
+        self.assertEqual(pactl.volumes, [65536, 65536])
+        self.assertEqual(pactl.matching_calls("set-sink-volume"), [("set-sink-volume", pactl.transport_sink, "100%")])
+        # An echo must not rewrite the visible route volume or either input.
+        mirror.apply(catalog_message())
+        self.assertEqual(len(pactl.matching_calls("set-sink-volume")), 1)
+        mirror.close()
+        self.assertEqual(pactl.volumes, [26214, 32768])
+
+    def test_transport_gain_keeps_manual_changes(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        mirror.apply(catalog_message())
+        pactl.volumes = [12345, 23456]
+        mirror.close()
+        self.assertEqual(pactl.volumes, [12345, 23456])
+
+    def test_other_audio_devices_are_not_amplified(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        pactl.card_name = "USB Audio"
+        mirror.apply(catalog_message())
+        self.assertEqual(pactl.volumes, [26214, 26214])
+        self.assertEqual(pactl.matching_calls("set-sink-volume"), [])
+
+    def test_transport_volume_failure_keeps_routes_working(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        pactl.details_error = True
+        mirror.apply(catalog_message())
+        self.assertEqual(pactl.default_sink, bridge.endpoint_name("output", "studio-output"))
+        self.assertEqual(len(pactl.matching_calls("load-module")), 6)
+        mirror.close()
+
+    def test_graph_reset_is_normalized_after_default_selection(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        pactl.volumes = [22222, 33333]
+        pactl.reset_on_load = True
+        mirror.apply(catalog_message())
+        self.assertEqual(pactl.volumes, [65536, 65536])
+        calls = [arguments for arguments, _ in pactl.calls]
+        self.assertGreater(calls.index(("set-sink-volume", pactl.transport_sink, "100%")),
+                           calls.index(("set-default-source", bridge.endpoint_name("input", "laptop-input"))))
+        mirror.close()
+        self.assertEqual(pactl.volumes, [22222, 33333])
+
+    def test_failed_normalization_retries_without_catalog_change(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        pactl.fail_volume_once = True
+        mirror.apply(catalog_message())
+        self.assertEqual(pactl.volumes, [26214, 26214])
+        mirror.poll_selection()
+        self.assertEqual(pactl.volumes, [65536, 65536])
+        self.assertEqual(len(pactl.loaded_modules), 6)
+        mirror.close()
+        self.assertEqual(pactl.volumes, [26214, 26214])
+
+    def test_failed_capture_retries_without_catalog_change(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        pactl.details_error = True
+        mirror.apply(catalog_message())
+        pactl.details_error = False
+        mirror.poll_selection()
+        self.assertEqual(pactl.volumes, [65536, 65536])
+
+    def test_manual_gain_survives_catalog_and_health_rebuild(self) -> None:
+        mirror, pactl, sent = self.make_mirror()
+        mirror.apply(catalog_message())
+        pactl.volumes = [12345, 23456]
+        pactl.reset_on_load = True
+        changed = catalog_message()
+        changed["outputs"][0]["name"] = "Renamed speakers"
+        mirror.apply(changed)
+        self.assertEqual(pactl.volumes, [12345, 23456])
+        pactl.loaded_modules.pop()
+        mirror.last_health_check = 0
+        mirror.poll_selection()
+        self.assertIn({"type": "get-catalog"}, sent)
+        mirror.apply(changed)
+        self.assertEqual(pactl.volumes, [12345, 23456])
+        mirror.close()
+        self.assertEqual(pactl.volumes, [12345, 23456])
+
+    def test_partial_graph_failure_retains_original_gain(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        pactl.volumes = [22222, 33333]
+        pactl.fail_load_once = True
+        with self.assertRaises(RuntimeError):
+            mirror.apply(catalog_message())
+        pactl.reset_on_load = True
+        mirror.apply(catalog_message())
+        self.assertEqual(pactl.volumes, [65536, 65536])
+        mirror.close()
+        self.assertEqual(pactl.volumes, [22222, 33333])
+
     def test_outputs_are_playable_remaps_of_the_qemu_transport(self) -> None:
         """A chooser sink must carry audio, not merely update the host route."""
         mirror, pactl, _ = self.make_mirror()
