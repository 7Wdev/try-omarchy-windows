+++ b/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-powerprofiles-list
@@ -0,0 +1,16 @@
+#!/bin/bash
+
+# omarchy:summary=Returns a list of all the available power profiles on the system.
+# omarchy:args=[--active-state]
+
+if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
+  echo "Usage: omarchy-powerprofiles-list [--active-state]" >&2
+  exit 1
+fi
+
+# The VM uses Windows power management; there is no Linux profile driver.
+if [[ ${1:-} == "--active-state" ]]; then
+  printf 'default\t1\n'
+else
+  printf 'default\n'
+fi
diff --git a/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-powerprofiles-set b/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-powerprofiles-set
new file mode 100644
index 0000000..39f8eb6
--- /dev/null
+++ b/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-powerprofiles-set
@@ -0,0 +1,27 @@
+#!/bin/bash
+
+# omarchy:summary=Report the VM power profile managed by Windows
+# omarchy:args=[autodetect|ac|battery] [default]
+
+action="${1:-autodetect}"
+requested_profile="${2:-}"
+
+usage() {
+  echo "Usage: omarchy-powerprofiles-set [autodetect|ac|battery] [default]" >&2
+  exit 1
+}
+
+(( $# <= 2 )) || usage
+case "$action" in
+  autodetect | ac | battery) ;;
+  *) usage ;;
+esac
+
+# Startup and AC transitions are no-ops. The guest cannot select a Windows mode.
+if [[ -n $requested_profile ]]; then
+  if [[ $requested_profile != default ]]; then
+    echo "Power profiles are managed by Windows; only default is available." >&2
+    exit 1
+  fi
+  echo "Managed by Windows"
+fi
diff --git a/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-screensaver b/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-screensaver
new file mode 100644
index 0000000..12db452
--- /dev/null
+++ b/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-screensaver
@@ -0,0 +1,49 @@
+#!/bin/bash
+
+# omarchy:summary=Run the Omarchy screensaver using random effects from TTE.
+
+screensaver_in_focus() {
+  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
+}
+
+exit_screensaver() {
+  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
+  [[ -z ${effect_pid:-} ]] || kill "$effect_pid" 2>/dev/null || true
+  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
+  exit 0
+}
+
+# Exit the screensaver on signals and input from keyboard and mouse
+trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT
+
+printf '\033]11;rgb:00/00/00\007'  # Set background color to black
+
+hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null
+
+# Terminals allocate the pty at the default 80x24 and only resize it once the
+# compositor has told the window how big it is. ttfx measures the terminal once,
+# at startup, so starting it before the resize lands sizes an 80x24 canvas and
+# paints it into the corner of a fullscreen window.
+wait_for_terminal_resize() {
+  local deadline=$((SECONDS + 2))
+  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
+    sleep 0.02
+  done
+}
+
+wait_for_terminal_resize
+
+while true; do
+  ttfx <<< "$(/usr/local/bin/omarchy-native-screensaver-text ~/.config/omarchy/branding/screensaver.txt)" \
+    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
+    --random-effect --no-eol --no-restore-cursor &
+
+  # Track this launch, including text preparation, instead of probing process names.
+  effect_pid=$!
+  while kill -0 "$effect_pid" 2>/dev/null; do
+    if read -n1 -t 1 || ! screensaver_in_focus; then
+      exit_screensaver
+    fi
+  done
+  wait "$effect_pid" || sleep 1
+done
diff --git a/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-update-requires-free-space b/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-update-requires-free-space
