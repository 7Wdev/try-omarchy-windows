diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/install-guest-qol b/guest/factory-overlay/usr/local/lib/try-omarchy/install-guest-qol
new file mode 100755
index 0000000..4820f40
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/install-guest-qol
@@ -0,0 +1,98 @@
+#!/usr/bin/python3 -I
+"""Install reviewed guest defaults once, keeping customized and linked files."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import tempfile
+
+TARGETS = {
+    "usr/bin/omarchy-screensaver", "usr/bin/omarchy-update-requires-free-space",
+    "usr/bin/omarchy-powerprofiles-list", "usr/bin/omarchy-powerprofiles-set",
+    "usr/share/omarchy/install/user/first-run/wifi.sh",
+    "usr/share/omarchy/shell/plugins/panels/power/Panel.qml",
+    "usr/share/omarchy/shell/plugins/menu/Menu.qml",
+    "etc/fonts/conf.d/30-try-omarchy.conf",
+    ".config/fcitx5/profile", ".config/chromium-flags.conf",
+}
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def install_file(base, hook, data):
+    target = base / hook["path"]
+    # Dotfiles checkouts and redirected system directories are user choices.
+    if base.is_symlink() or any(p.is_symlink() for p in [target, *target.parents]):
+        return
+    exists = target.exists()
+    if exists:
+        if not target.is_file():
+            return
+        old = digest(target.read_bytes())
+        if old == hook["afterSha256"]:
+            return
+        if old not in hook["beforeSha256"]:
+            print(f"Keeping customized {target}", flush=True)
+            return
+    elif not hook.get("create", False):
+        return
+    owner = target.stat() if exists else base.stat()
+    missing = []
+    parent = target.parent
+    while not parent.exists():
+        missing.append(parent)
+        parent = parent.parent
+    for parent in reversed(missing):
+        parent.mkdir(mode=0o755)
+        os.chown(parent, owner.st_uid, owner.st_gid)
+    descriptor, temporary = tempfile.mkstemp(prefix=".guest-qol-", dir=target.parent)
+    try:
+        with os.fdopen(descriptor, "wb") as output:
+            output.write(data)
+            os.fchmod(output.fileno(), owner.st_mode & 0o777 if exists else hook["mode"])
+            os.fchown(output.fileno(), owner.st_uid, owner.st_gid)
+            output.flush()
+            os.fsync(output.fileno())
+        if exists:
+            os.replace(temporary, target)
+        else:
+            # Do not replace a file that appeared while preparing its default.
+            try:
+                os.link(temporary, target)
+            except FileExistsError:
+                pass
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def install(root, homes, payload):
+    hooks = json.loads((payload / "manifest.json").read_text())
+    prepared = []
+    for hook in hooks:
+        if hook["path"] not in TARGETS or Path(hook["asset"]).name != hook["asset"]:
+            raise ValueError("unexpected guest quality-of-life target")
+        data = (payload / hook["asset"]).read_bytes()
+        if digest(data) != hook["afterSha256"]:
+            raise ValueError("guest quality-of-life payload digest mismatch")
+        prepared.append((hook, data))
+    for hook, data in prepared:
+        if hook["path"].startswith(".config/"):
+            for home in homes.iterdir() if homes.is_dir() else []:
+                if home.is_dir() and not home.is_symlink():
+                    install_file(home, hook, data)
+        else:
+            install_file(root, hook, data)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path("/"))
+    parser.add_argument("--homes", type=Path, default=Path("/home"))
+    parser.add_argument("--payload", type=Path, default=Path("/usr/share/try-omarchy/guest-qol"))
+    args = parser.parse_args()
+    install(args.root, args.homes, args.payload)
diff --git a/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-powerprofiles-list b/guest/factory-overlay/usr/share/try-omarchy/guest-qol/bin_omarchy-powerprofiles-list
