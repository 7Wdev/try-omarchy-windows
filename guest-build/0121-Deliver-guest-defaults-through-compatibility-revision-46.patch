@@ -0,0 +1,248 @@
+"""Exercise factory backports and preservation on persistent guest disks."""
+import fcntl
+import hashlib
+import importlib.machinery
+import importlib.util
+import json
+import os
+from pathlib import Path
+import pty
+import shutil
+import struct
+import subprocess
+import tempfile
+import termios
+import unittest
+import xml.etree.ElementTree as ET
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / "factory-overlay"
+PAYLOAD = OVERLAY / "usr/share/try-omarchy/guest-qol"
+FIXTURES = GUEST / "tests/fixtures/guest-qol"
+INSTALLER = OVERLAY / "usr/local/lib/try-omarchy/install-guest-qol"
+loader = importlib.machinery.SourceFileLoader("guest_qol", str(INSTALLER))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+installer = importlib.util.module_from_spec(spec)
+loader.exec_module(installer)
+
+
+class GuestQolTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.homes = self.root / "home"
+        self.home = self.homes / "tester"
+        self.home.mkdir(parents=True)
+        self.hooks = json.loads((PAYLOAD / "manifest.json").read_text())
+        for hook in self.hooks:
+            if hook["path"].startswith("usr/"):
+                rel = hook["path"].removeprefix("usr/share/omarchy/").removeprefix("usr/")
+                target = self.root / hook["path"]
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_bytes((FIXTURES / rel).read_bytes())
+                target.chmod(hook["mode"])
+        flags = self.home / ".config/chromium-flags.conf"
+        flags.parent.mkdir(parents=True)
+        flags.write_bytes((FIXTURES / "chromium-flags.conf").read_bytes())
+        self.flags = flags
+        installer.install(self.root, self.homes, PAYLOAD)
+        self.bin = self.root / "usr/bin"
+        self.env = dict(os.environ, PATH=str(self.bin) + ":" + os.environ["PATH"])
+
+    def fake(self, name, body):
+        target = self.bin / name
+        target.write_text("#!/bin/bash\n" + body + "\n")
+        target.chmod(0o755)
+
+    def command(self, name, *args):
+        return subprocess.run(["bash", str(self.bin / name), *args], env=self.env,
+                              text=True, capture_output=True, timeout=5)
+
+    def test_factory_backports_match_persistent_disk_payload(self):
+        build_spec = json.loads((GUEST / "spec.json").read_text())
+        for backport in build_spec["authenticity"]["backports"][-4:]:
+            stage = self.root / backport["id"]
+            for target in backport["targets"]:
+                dest = stage / target["path"]
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                dest.write_bytes((FIXTURES / target["path"]).read_bytes())
+            subprocess.run(["git", "apply", "--no-index", str(GUEST / backport["patch"])],
+                           cwd=stage, check=True, capture_output=True)
+            for target in backport["targets"]:
+                path = target["path"]
+                installed = self.root / ("usr/" + path if path.startswith("bin/") else "usr/share/omarchy/" + path)
+                self.assertEqual(installed.read_bytes(), (stage / path).read_bytes())
+                self.assertEqual(hashlib.sha256(installed.read_bytes()).hexdigest(), target["afterSha256"])
+
+    def test_customized_deleted_and_linked_files_survive(self):
+        for hook in self.hooks:
+            base = self.home if hook["path"].startswith(".config/") else self.root
+            target = base / hook["path"]
+            original_mode = target.stat().st_mode
+            target.write_text("my custom config\n")
+            installer.install(self.root, self.homes, PAYLOAD)
+            self.assertEqual(target.read_text(), "my custom config\n", target)
+            self.assertEqual(target.stat().st_mode, original_mode)
+            target.unlink()
+            target.symlink_to(self.root / "outside")
+            installer.install(self.root, self.homes, PAYLOAD)
+            self.assertTrue(target.is_symlink())
+            self.assertFalse((self.root / "outside").exists())
+
+    def test_linked_parent_is_preserved_and_repeat_does_not_rewrite(self):
+        profile = self.home / ".config/fcitx5/profile"
+        inode = profile.stat().st_ino
+        installer.install(self.root, self.homes, PAYLOAD)
+        self.assertEqual(profile.stat().st_ino, inode)
+        profile.unlink()
+        profile.parent.rmdir()
+        redirected = self.root / "dotfiles"
+        redirected.mkdir()
+        profile.parent.symlink_to(redirected, target_is_directory=True)
+        installer.install(self.root, self.homes, PAYLOAD)
+        self.assertFalse((redirected / "profile").exists())
+
+    def test_manifest_error_does_not_partially_install(self):
+        payload = self.root / "payload"
+        shutil.copytree(PAYLOAD, payload)
+        hooks = json.loads((payload / "manifest.json").read_text())
+        hooks[-1]["afterSha256"] = "0" * 64
+        (payload / "manifest.json").write_text(json.dumps(hooks))
+        with self.assertRaises(ValueError):
+            installer.install(self.root, self.homes, payload)
+        hooks[0]["path"] = "etc/passwd"
+        (payload / "manifest.json").write_text(json.dumps(hooks))
+        with self.assertRaises(ValueError):
+            installer.install(self.root, self.homes, payload)
+
+    def test_disk_space_message_explains_growth_and_shows_root_usage(self):
+        self.fake("df", 'if [[ $1 == -h ]]; then echo "guest root usage"; else printf "Avail\\n1\\n"; fi')
+        result = self.command("omarchy-update-requires-free-space")
+        self.assertEqual(result.returncode, 1)
+        for text in ("10 GiB", "inside the Omarchy disk, not on your PC", "guest root usage",
+                     "sudo pacman -Scc", "Disk capacity (GiB)", "Settings > General > Storage"):
+            self.assertIn(text, result.stdout)
+        self.fake("df", 'printf "Avail\\n10737418240\\n"')
+        result = self.command("omarchy-update-requires-free-space")
+        self.assertEqual((result.returncode, result.stdout), (0, ""))
+
+    def test_first_run_update_is_normal_and_keeps_update_action(self):
+        script = (self.root / "usr/share/omarchy/install/user/first-run/wifi.sh").read_text()
+        self.fake("omarchy-notification-send", 'printf "%s\\n" "$@"')
+        result = subprocess.run(["bash", "-c", script.split("notify_wifi()", 1)[0] + "notify_update"],
+                                env=self.env, text=True, capture_output=True, check=True)
+        self.assertIn("normal\n", result.stdout)
+        self.assertNotIn("critical", result.stdout)
+        self.assertIn("Try Omarchy manages supported Linux packages", result.stdout)
+        self.assertIn("omarchy-update", result.stdout)
+
+    def test_power_profiles_are_informational_without_linux_daemon(self):
+        for name in ("powerprofilesctl", "busctl"):
+            self.fake(name, 'echo unexpected >&2; exit 99')
+        self.assertEqual(self.command("omarchy-powerprofiles-list").stdout, "default\n")
+        self.assertEqual(self.command("omarchy-powerprofiles-list", "--active-state").stdout, "default\t1\n")
+        for action in ("autodetect", "ac", "battery"):
+            result = self.command("omarchy-powerprofiles-set", action)
+            self.assertEqual((result.returncode, result.stdout, result.stderr), (0, "", ""))
+            self.assertEqual(self.command("omarchy-powerprofiles-set", action, "default").stdout, "Managed by Windows\n")
+            self.assertNotEqual(self.command("omarchy-powerprofiles-set", action, "performance").returncode, 0)
+        self.assertNotEqual(self.command("omarchy-powerprofiles-list", "--unknown").returncode, 0)
+        panel = (self.root / "usr/share/omarchy/shell/plugins/panels/power/Panel.qml").read_text()
+        self.assertIn('"Managed by Windows"', panel)
+        self.assertIn("enabled: !root.managedByWindows", panel)
+        self.assertIn("if (managedByWindows ||", panel)
+        menu = (self.root / "usr/share/omarchy/shell/plugins/menu/Menu.qml").read_text()
+        provider = menu.split('"power-profiles": {', 1)[1].split("\n    }", 1)[0]
+        script = json.loads(provider.split('script: ', 1)[1].split('\n', 1)[0].rstrip(','))
+        result = subprocess.run(["bash", "-c", script], env=self.env, text=True, capture_output=True)
+        self.assertEqual(result.stdout, "Managed by Windows\tdefault\tdefault\n")
+        self.assertIn('actionFor: function(value) { return "" }', provider)
+
+    def test_cjk_defaults_keep_chromium_flags_and_seed_chewing(self):
+        self.assertEqual(self.flags.read_bytes(), (FIXTURES / "chromium-flags.conf").read_bytes() + b"--enable-wayland-ime\n")
+        profile = (self.home / ".config/fcitx5/profile").read_text()
+        self.assertIn("[Groups/0/Items/0]\nName=keyboard-us", profile)
+        self.assertIn("[Groups/0/Items/1]\nName=chewing", profile)
+        config = ET.parse(self.root / "etc/fonts/conf.d/30-try-omarchy.conf")
+        matches = config.getroot().findall("match")
+        self.assertEqual(len(matches), 6)
+        for match in matches:
+            tests = match.findall("test")
+            self.assertIn(tests[1].findtext("string"), ("zh-tw", "zh-hant"))
+            self.assertTrue(match.find("edit").findtext("string").endswith("CJK TC"))
+        build_spec = json.loads((GUEST / "spec.json").read_text())
+        self.assertIn("fcitx5-chewing", build_spec["upstream"]["integrationDepends"])
+        self.assertIn("man-db", build_spec["upstream"]["integrationDepends"])
+
+    def test_screensaver_text_fits_live_terminal(self):
+        helper = OVERLAY / "usr/local/bin/omarchy-native-screensaver-text"
+        master, slave = pty.openpty()
+        self.addCleanup(os.close, master)
+        self.addCleanup(os.close, slave)
+        text = self.root / "branding.txt"
+        for rows, cols, content, expected in [(10, 20, "hello\n", "hello\n"),
+                (2, 20, "a\nb\nc\n", "Omarchy\n"), (10, 3, "wide\n", "Oma\n"),
+                (10, 7, "中文中文\n", "Omarchy\n"), (10, 20, " \n", "Omarchy\n"),
+                (10, 1, "wide\n", "O\n")]:
+            fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
+            text.write_text(content)
+            result = subprocess.run([str(helper), str(text)], stdin=slave, text=True, capture_output=True)
+            self.assertEqual(result.stdout, expected)
+        result = subprocess.run([str(helper), str(self.root / "absent")], stdin=slave, text=True, capture_output=True)
+        self.assertEqual(result.stdout, "O\n")
+
+    def test_screensaver_tracks_preparation_and_effect_pid(self):
+        script = (self.bin / "omarchy-screensaver").read_text()
+        helper = self.root / "text-helper"
+        helper.write_text('#!/bin/bash\nsleep .1\necho Omarchy\n')
+        helper.chmod(0o755)
+        completed = self.root / "completed"
+        calls = self.root / "calls"
+        self.fake("ttfx", f'echo effect >>"{calls}"; cat >/dev/null; sleep .2; touch "{completed}"')
+        loop = script.split("wait_for_terminal_resize\n\n", 1)[1]
+        loop = loop.replace("/usr/local/bin/omarchy-native-screensaver-text", str(helper))
+        harness = f'''read() {{ sleep .03; return 1; }}
+        screensaver_in_focus() {{ [[ ! -e {completed} ]]; }}
+        exit_screensaver() {{ kill "$effect_pid" 2>/dev/null || true; exit 0; }}
+        ''' + loop
+        result = subprocess.run(["bash", "-c", harness], env=self.env, text=True, capture_output=True, timeout=3)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(calls.read_text(), "effect\n")
+        self.assertNotIn("pgrep", script)
+        self.assertNotIn("pkill -x ttfx", script)
+
+    def test_compatibility_delivers_guarded_payload_once_per_revision(self):
+        finalize = (GUEST / "scripts/finalize-rootfs.sh").read_text()
+        paths = finalize.split("compat_paths=(", 1)[1].split(")", 1)[0]
+        self.assertIn("compat_revision=46", finalize)
+        for path in ("usr/local/bin/omarchy-native-screensaver-text", "usr/local/lib/try-omarchy/install-guest-qol", "usr/share/try-omarchy/guest-qol"):
+            self.assertIn(path, paths)
+        self.assertNotIn("etc/fonts/conf.d/30-try-omarchy.conf", paths)
+        self.assertNotIn("usr/bin/omarchy-screensaver", paths)
+        catchup = OVERLAY / "usr/local/lib/try-omarchy/catch-up"
+        fake = self.root / "qol-installer"
+        fake.write_text('#!/bin/bash\necho called >>"' + str(self.root / 'invocations') + '"\n')
+        fake.chmod(0o755)
+        version = self.root / "version"
+        version.write_text("46:kernel\n")
+        env = dict(self.env, TRY_OMARCHY_QOL_INSTALLER=str(fake), TRY_OMARCHY_COMPAT_VERSION=str(version),
+                   TRY_OMARCHY_STATE_DIR=str(self.root / "state"), TRY_OMARCHY_HOMES=str(self.homes))
+        for _ in range(2):
+            subprocess.run([str(catchup)], env=env, check=True, capture_output=True)
