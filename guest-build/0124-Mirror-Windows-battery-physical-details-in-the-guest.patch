index 0000000..e038194
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/update-battery-dkms
@@ -0,0 +1,32 @@
+#!/bin/bash
+# The initramfs already delivered the new module for the running kernel.
+# Retire the old DKMS registration without losing that delivered copy.
+set -euo pipefail
+
+root=${TRY_OMARCHY_BATTERY_ROOT:-}
+kernel=$(uname -r)
+module=$(modinfo -n try_omarchy_battery)
+backup=$(mktemp -d)
+trap 'rm -rf "$backup"' EXIT
+cp -a "$module" "$backup/module"
+restore_module() {
+  install -d "$(dirname "$module")"
+  cp -a "$backup/module" "$module"
+  depmod -a
+}
+trap 'restore_module; rm -rf "$backup"' EXIT
+if [[ -d "$root"/var/lib/dkms/try-omarchy-battery/1.0.0 ]]; then
+  dkms remove -m try-omarchy-battery -v 1.0.0 --all
+fi
+# Old source must not be picked up again by the DKMS package hook.
+rm -rf -- "$root/usr/src/try-omarchy-battery-1.0.0"
+restore_module
+trap 'rm -rf "$backup"' EXIT
+if [[ ! -e "$root"/var/lib/dkms/try-omarchy-battery/1.1.0/source ]]; then
+  dkms add -m try-omarchy-battery -v 1.1.0
+fi
+# Headers can arrive later through Update > Omarchy. 0118's force-install
+# entry lets DKMS replace the delivered module when they do.
+if [[ -d "$root"/usr/lib/modules/$kernel/build ]]; then
+  dkms install -m try-omarchy-battery -v 1.1.0 -k "$kernel"
+fi
