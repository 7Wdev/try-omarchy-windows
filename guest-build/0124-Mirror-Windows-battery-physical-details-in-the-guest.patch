new file mode 100644
index 0000000..891f845
--- /dev/null
+++ b/guest/tests/native-module/tob_parse_harness.c
@@ -0,0 +1,147 @@
+/*
+ * Userspace harness for the kernel module's tob_parse().
+ *
+ * The parser under test is NOT copied here. test_battery_details.py slices the
+ * struct, the status-token table and tob_parse() verbatim out of
+ * guest/factory-overlay/usr/src/try-omarchy-battery-1.1.0/try-omarchy-battery.c into
+ * tob_parse_extract.c, which this file compiles against the handful of kernel
+ * helpers the parser uses. A drift between the shipped module and the tested
+ * parser is therefore impossible.
+ *
+ * Reads one state line on stdin. Prints the parsed fields, or "ERR <errno>".
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+#define GFP_KERNEL 0
+
+/* power_supply.h status values; only their distinctness matters here. */
+enum {
+	POWER_SUPPLY_STATUS_UNKNOWN = 0,
+	POWER_SUPPLY_STATUS_CHARGING,
+	POWER_SUPPLY_STATUS_DISCHARGING,
+	POWER_SUPPLY_STATUS_NOT_CHARGING,
+	POWER_SUPPLY_STATUS_FULL,
+};
+
+static char *kstrndup(const char *source, size_t max, int flags)
+{
+	(void)flags;
+	return strndup(source, max);
+}
+
+static void kfree(void *pointer)
+{
+	free(pointer);
+}
+
+/* lib/kstrtox.c: accepts y/Y/1, n/N/0, on/off; one trailing newline is fine. */
+static int kstrtobool(const char *text, bool *result)
+{
+	if (!text)
+		return -EINVAL;
+	switch (text[0]) {
+	case 'y':
+	case 'Y':
+	case '1':
+		*result = true;
+		break;
+	case 'n':
+	case 'N':
+	case '0':
+		*result = false;
+		break;
+	case 'o':
+	case 'O':
+		switch (text[1]) {
+		case 'n':
+		case 'N':
+			*result = true;
+			return 0;
+		case 'f':
+		case 'F':
+			*result = false;
+			return 0;
+		default:
+			return -EINVAL;
+		}
+	default:
+		return -EINVAL;
+	}
+	if (text[1] == '\0' || text[1] == '\n')
+		return 0;
+	return -EINVAL;
+}
+
+/* lib/kstrtox.c: no leading space, digits only, one trailing newline. */
+static int kstrtoint(const char *text, unsigned int base, int *result)
+{
+	const char *cursor = text;
+	long long value = 0;
+	bool negative = false;
+	bool digits = false;
+
+	if (base != 10 || !text)
+		return -EINVAL;
+	if (*cursor == '-') {
+		negative = true;
+		cursor++;
+	} else if (*cursor == '+') {
+		cursor++;
+	}
+	for (; *cursor >= '0' && *cursor <= '9'; cursor++) {
+		digits = true;
+		value = value * 10 + (*cursor - '0');
+		if (value > 4294967296LL)
+			return -ERANGE;
+	}
+	if (!digits)
+		return -EINVAL;
+	if (*cursor == '\n')
+		cursor++;
+	if (*cursor != '\0')
+		return -EINVAL;
+	if (negative)
+		value = -value;
+	if (value < -2147483648LL || value > 2147483647LL)
+		return -ERANGE;
+	*result = (int)value;
+	return 0;
+}
+
+static int hex_to_bin(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+#include "tob_parse_extract.c"
+
+int main(void)
+{
+	static char buffer[8192];
+	struct tob_state parsed;
+	size_t count = fread(buffer, 1, sizeof(buffer) - 1, stdin);
+	int error;
+
+	buffer[count] = '\0';
+	error = tob_parse(buffer, count, &parsed);
+	if (error) {
+		printf("ERR %d\n", -error);
+		return 0;
+	}
+	printf("OK present=%d status=%d capacity=%d ac=%d time_to_empty=%d time_to_full=%d energy_full_design=%d energy_full=%d cycle_count=%d manufacturer=%s model_name=%s chemistry=%s\n",
+           parsed.present, parsed.status, parsed.capacity, parsed.ac_online,
+           parsed.time_to_empty, parsed.time_to_full, parsed.energy_full_design,
+           parsed.energy_full, parsed.cycle_count, parsed.manufacturer,
+           parsed.model_name, parsed.chemistry);
+	return 0;
+}
diff --git a/guest/tests/test_battery_details.py b/guest/tests/test_battery_details.py
new file mode 100644
index 0000000..ebad1b3
--- /dev/null
+++ b/guest/tests/test_battery_details.py
@@ -0,0 +1,253 @@
+#!/usr/bin/env python3
+"""Drive the kernel module's real tob_parse() from userspace.
+
+tob_parse() and the Python agent's render() are two independently
+written halves of one wire contract, and nothing else in the suite executes
+anything under guest/factory-overlay/usr/src/. This test slices the parser verbatim out
+of the shipped module source, compiles it against small shims for the kernel
+helpers it uses, and feeds it the exact lines the agent emits.
+
+Nothing here is a copy of the parser: if the extraction markers stop matching,
+the test fails rather than silently testing stale code.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from importlib.machinery import SourceFileLoader
+import shutil
+import json
+import os
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+GUEST = Path(__file__).resolve().parents[1]
+MODULE_SOURCE = GUEST / "factory-overlay/usr/src/try-omarchy-battery-1.1.0/try-omarchy-battery.c"
+HARNESS = GUEST / "tests/native-module/tob_parse_harness.c"
+BRIDGE_PATH = GUEST / "factory-overlay/usr/local/lib/try-omarchy/battery-apply"
+
+LOADER = SourceFileLoader("omarchy_native_battery_bridge", str(BRIDGE_PATH))
+SPEC = importlib.util.spec_from_loader(LOADER.name, LOADER)
+if SPEC is None or SPEC.loader is None:
+    raise RuntimeError(f"cannot import {BRIDGE_PATH}")
+bridge = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(bridge)
+
+
+def _slice(source: str, start_marker: str, end_marker: str, *, search_back: str = "") -> str:
+    """Return the verbatim source block containing start_marker."""
+    anchor = source.index(start_marker)
+    start = source.rindex(search_back, 0, anchor) if search_back else anchor
+    end = source.index(end_marker, anchor) + len(end_marker)
+    return source[start:end]
+
+
+def extract_parser() -> str:
+    """Slice struct tob_state, the status table and tob_parse() verbatim."""
+    source = MODULE_SOURCE.read_text()
+    blocks = [
+        _slice(source, "struct tob_state {", "};"),
+        _slice(source, "} tob_status_tokens[] = {", "};", search_back="static const struct {"),
+        _slice(source, "static int tob_parse_text(", "\n}\n"),
+        _slice(source, "static int tob_parse(", "\n}\n"),
+    ]
+    for block in blocks:
+        if not block.strip():
+            raise RuntimeError("tob_parse extraction produced an empty block")
+    if "next->time_to_full" not in blocks[3]:
+        raise RuntimeError("tob_parse extraction did not capture the whole parser")
+    return "\n\n".join(blocks) + "\n"
+
+
+def module_status_tokens() -> list[str]:
+    """The status tokens the shipped module accepts, read from its table."""
+    table = _slice(
+        MODULE_SOURCE.read_text(),
+        "} tob_status_tokens[] = {",
+        "};",
+        search_back="static const struct {",
+    )
+    return [
+        line.split('"')[1]
+        for line in table.splitlines()
+        if line.lstrip().startswith("{ \"")
+    ]
+
+
+COMPILER = shutil.which("cc") or shutil.which("gcc") or shutil.which("clang")
+
+
+@unittest.skipIf(COMPILER is None, "no C compiler available to build the tob_parse harness")
+class TobParseTests(unittest.TestCase):
+    binary: Path
+    _directory: tempfile.TemporaryDirectory
+
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls._directory = tempfile.TemporaryDirectory()
+        workspace = Path(cls._directory.name)
+        (workspace / "tob_parse_extract.c").write_text(extract_parser())
+        cls.binary = workspace / "tob_parse_harness"
+        subprocess.run(
+            [
+                COMPILER, "-std=gnu11", "-Wall", "-Wextra", "-Werror",
+                "-D_GNU_SOURCE", "-I", str(workspace),
+                str(HARNESS), "-o", str(cls.binary),
+            ],
+            check=True,
+        )
+
+    @classmethod
+    def tearDownClass(cls) -> None:
+        cls._directory.cleanup()
+
+    def parse(self, line: bytes) -> str:
+        completed = subprocess.run(
+            [str(self.binary)], input=line, stdout=subprocess.PIPE, check=True
+        )
+        return completed.stdout.decode().strip()
+
+    def assertRejected(self, line: bytes) -> None:
+        self.assertEqual(self.parse(line), "ERR 22", f"expected -EINVAL for {line!r}")
+
+
+    def test_bridge_to_module_and_legacy_reset(self):
+        state = bridge.decode(b'{"type":"state","present":true,"percentage":57,"state":"discharging","acConnected":false,"timeToEmptySeconds":8100,"timeToFullSeconds":null}')
+        details = bridge.decode_details(b'{"energyFullDesignMicroWh":60000000,"energyFullMicroWh":50000000,"cycleCount":213,"manufacturer":"ACME Corp","modelName":"Battery A","chemistry":"LION"}')
+        parsed = self.parse(bridge.render(state, details).encode())
+        for field in ("energy_full_design=60000000", "energy_full=50000000", "cycle_count=213", "manufacturer=ACME Corp", "model_name=Battery A", "chemistry=LION"):
+            self.assertIn(field, parsed)
+        legacy = self.parse(bridge.render(state).encode())
+        self.assertIn("energy_full=-1", legacy)
+        self.assertIn("cycle_count=-1", legacy)
+        self.assertIn("manufacturer= model_name= chemistry=", legacy)
+        self.assertIn("present=0", self.parse(b"present=0 ac=1\n"))
+
+    def test_invalid_module_details(self):
+        prefix = "present=1 status=full capacity=100 ac=1 "
+        for field in ("energy_full", "energy_full_design", "cycle_count"):
+            for value in ("0", "-2", "2147483648", "bad"):
+                self.assertRejected(f"{prefix}{field}={value}\n".encode())
+        for value in ("0", "zz", "00", "0a", "7f", "41" * 128):
+            self.assertRejected(f"{prefix}manufacturer={value}\n".encode())
+        self.assertRejected(f"{prefix}unrecognized=1\n".encode())
+
+    def test_bridge_validation(self):
+        for key in bridge.NUMBERS:
+            for value in (0, -1, True, "213", 1.5, 2147483648):
+                with self.subTest(key=key, value=value), self.assertRaises(ValueError):
+                    bridge.decode_details(json.dumps({key: value}).encode())
+        for value in ("", "a" * 128, "bad\nname", 1):
+            with self.assertRaises(ValueError):
+                bridge.decode_details(json.dumps({"manufacturer": value}).encode())
+
+class BatteryDetailsFlowTests(unittest.TestCase):
+    def test_details_survive_ticks_and_clear_on_absence_and_disconnect(self):
+        with tempfile.TemporaryDirectory() as directory:
+            base = Path(directory)
+            env = dict(os.environ, TRY_OMARCHY_BATTERY_STATE_FILE=str(base / "state"),
+                       TRY_OMARCHY_BATTERY_CACHE_FILE=str(base / "state.json"),
+                       TRY_OMARCHY_BATTERY_DETAILS_FILE=str(base / "details.json"))
+            state = {"type": "state", "present": True, "percentage": 57,
+                     "state": "discharging", "acConnected": False,
+                     "timeToEmptySeconds": 8100, "timeToFullSeconds": None}
+            def apply(value=None, *args):
+                result = subprocess.run([str(BRIDGE_PATH), *args], env=env,
+                                        input=json.dumps(value) if value is not None else "",
+                                        text=True, capture_output=True, timeout=5)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                return (base / "state").read_text()
+            self.assertNotIn("energy_full", apply(state))
+            line = apply({"energyFullMicroWh": 50000000, "manufacturer": "ACME Corp"}, "--details")
+            self.assertIn("energy_full=50000000", line)
+            self.assertIn("manufacturer=41434d4520436f7270", line)
+            self.assertIn("energy_full=50000000", apply(dict(state, percentage=58)))
+            self.assertNotIn("energy_full", apply(None, "--offline"))
+            self.assertNotIn("energy_full", apply(state))
+            apply({"cycleCount": 213}, "--details")
+            absent = dict(state, present=False, percentage=None)
+            self.assertEqual(apply(absent), "present=0 ac=0\n")
+            self.assertNotIn("cycle_count", apply(state))
+            self.assertNotIn("energy_full", apply({}, "--details"))
+
+    def test_compatibility_delivery_and_dkms_version(self):
+        overlay = GUEST / "factory-overlay"
+        finalize = (GUEST / "scripts/finalize-rootfs.sh").read_text()
+        self.assertIn("compat_revision=48", finalize)
+        self.assertIn("usr/src/try-omarchy-battery-1.1.0", finalize)
+        self.assertIn("usr/local/lib/try-omarchy/update-battery-dkms", finalize)
+        self.assertIn('PACKAGE_VERSION="1.1.0"', (MODULE_SOURCE.parent / "dkms.conf").read_text())
+        self.assertIn("try-omarchy-battery_version-override", (overlay / "usr/share/dkms/modules_to_force_install/try-omarchy").read_text())
+        catch_up = (overlay / "usr/local/lib/try-omarchy/catch-up").read_text()
+        self.assertIn("previous_revision < 48", catch_up)
+
+
+class BatteryDKMSUpgradeTests(unittest.TestCase):
+    def test_retires_old_source_and_preserves_delivered_module(self):
+        helper = GUEST / "factory-overlay/usr/local/lib/try-omarchy/update-battery-dkms"
+        for headers, fail_remove in ((False, False), (True, False), (True, True)):
+            with self.subTest(headers=headers, fail_remove=fail_remove), tempfile.TemporaryDirectory() as directory:
+                root = Path(directory)
+                tools = root / "bin"
+                tools.mkdir()
+                module = root / "usr/lib/modules/test/updates/dkms/try_omarchy_battery.ko"
+                module.parent.mkdir(parents=True)
+                module.write_text("launcher module")
+                old = root / "usr/src/try-omarchy-battery-1.0.0"
+                old.mkdir(parents=True)
+                (old / "dkms.conf").write_text("old source")
+                (root / "var/lib/dkms/try-omarchy-battery/1.0.0").mkdir(parents=True)
+                if headers:
+                    (root / "usr/lib/modules/test/build").mkdir()
+                calls = root / "calls"
+                def fake(name, body):
+                    file = tools / name
+                    file.write_text("#!/bin/bash\nset -e\n" + body + "\n")
+                    file.chmod(0o755)
+                fake("uname", "echo test")
+                fake("modinfo", f"echo '{module}'")
+                fake("depmod", f"echo depmod >>'{calls}'")
+                fake("dkms", f'echo "$*" >>"{calls}"\n'
+                     + f'if [[ $1 == remove ]]; then rm -f "{module}"; '
+                     + ("exit 1; " if fail_remove else "") + "fi")
+                result = subprocess.run([str(helper)], env=dict(os.environ, PATH=f"{tools}:" + os.environ["PATH"],
+                                        TRY_OMARCHY_BATTERY_ROOT=str(root)), capture_output=True, text=True)
+                self.assertEqual(result.returncode, int(fail_remove), result.stderr)
+                self.assertEqual(module.read_text(), "launcher module")
+                log = calls.read_text()
+                self.assertIn("remove -m try-omarchy-battery -v 1.0.0 --all", log)
+                self.assertEqual(old.exists(), fail_remove)
+                self.assertEqual("add -m try-omarchy-battery -v 1.1.0" in log, not fail_remove)
+                self.assertEqual("install -m try-omarchy-battery -v 1.1.0 -k test" in log, headers and not fail_remove)
+
+    def test_catchup_retries_failure_and_runs_once(self):
+        helper = GUEST / "factory-overlay/usr/local/lib/try-omarchy/catch-up"
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            state = root / "state"
+            state.mkdir()
+            marker = state / "catch-up-revision"
+            marker.write_text("47\n")
+            version = root / "version"
+            version.write_text("48:test\n")
+            installer = root / "installer"
+            installer.write_text("#!/bin/bash\nexit 1\n")
+            installer.chmod(0o755)
+            env = dict(os.environ, TRY_OMARCHY_STATE_DIR=str(state), TRY_OMARCHY_COMPAT_VERSION=str(version),
+                       TRY_OMARCHY_BATTERY_INSTALLER=str(installer), TRY_OMARCHY_HOMES=str(root / "homes"),
+                       TRY_OMARCHY_QOL_INSTALLER=str(root / "absent"))
+            result = subprocess.run([str(helper)], env=env, capture_output=True)
+            self.assertEqual(result.returncode, 1)
+            self.assertEqual(marker.read_text(), "47\n")
+            calls = root / "calls"
+            installer.write_text(f"#!/bin/bash\necho called >>'{calls}'\n")
+            for _ in range(2):
+                subprocess.run([str(helper)], env=env, check=True, capture_output=True)
+            self.assertEqual(calls.read_text(), "called\n")
+            self.assertEqual(marker.read_text(), "48\n")
+
+if __name__ == "__main__":
+    unittest.main()
