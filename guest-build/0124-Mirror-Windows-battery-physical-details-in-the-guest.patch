+/* Text travels as UTF-8 hex so spaces cannot split a snapshot token. */
+static int tob_parse_text(const char *value, char *target, size_t size)
+{
+	size_t length = strlen(value), i;
+
+	if (!length || length % 2 || length / 2 >= size)
+		return -EINVAL;
+	for (i = 0; i < length / 2; i++) {
+		int high = hex_to_bin(value[i * 2]);
+		int low = hex_to_bin(value[i * 2 + 1]);
+		int byte;
+
+		if (high < 0 || low < 0)
+			return -EINVAL;
+		byte = high * 16 + low;
+		if (byte < 32 || byte == 127)
+			return -EINVAL;
+		target[i] = byte;
+	}
+	target[length / 2] = '\0';
+	return 0;
+}
