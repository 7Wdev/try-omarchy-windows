@@ -7,10 +7,43 @@ from pathlib import Path
 import sys
 
 STATE = Path(os.environ.get("TRY_OMARCHY_BATTERY_STATE_FILE", "/sys/devices/platform/try-omarchy-battery/state"))
+DETAILS = Path(os.environ.get("TRY_OMARCHY_BATTERY_DETAILS_FILE", "/run/try-omarchy/battery-details.json"))
 CACHE = Path(os.environ.get("TRY_OMARCHY_BATTERY_CACHE_FILE", "/run/try-omarchy/battery.json"))
 STATES = {"charging", "discharging", "full", "not-charging", "unknown"}
 KEYS = {"type", "present", "percentage", "state", "acConnected", "timeToEmptySeconds", "timeToFullSeconds"}
 
+NUMBERS = {"energyFullDesignMicroWh": "energy_full_design", "energyFullMicroWh": "energy_full", "cycleCount": "cycle_count"}
+TEXT = {"manufacturer": "manufacturer", "modelName": "model_name", "chemistry": "chemistry"}
+
+
+def decode_details(raw: bytes) -> dict:
+    if len(raw) > 4096:
+        raise ValueError("battery details are too large")
+    value = json.loads(raw)
+    if not isinstance(value, dict) or not set(value) <= NUMBERS.keys() | TEXT.keys():
+        raise ValueError("invalid battery details")
+    for key, number in value.items():
+        if key in NUMBERS:
+            if type(number) is not int or not 1 <= number <= 2147483647:
+                raise ValueError("invalid physical reading")
+        elif not isinstance(number, str) or not number or len(number.encode()) > 127 or any(ord(c) < 32 or ord(c) == 127 for c in number):
+            raise ValueError("invalid battery text")
+    return value
+
+
+def load_details() -> dict:
+    try:
+        return decode_details(DETAILS.read_bytes())
+    except (OSError, ValueError):
+        return {}
+
+
+def save(path: Path, value: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(".part")
+    temporary.write_text(json.dumps(value, separators=(",", ":")))
+    temporary.replace(path)
+
 
 def decode(raw: bytes) -> dict:
     if len(raw) > 4096:
@@ -35,20 +68,36 @@ def decode(raw: bytes) -> dict:
     return value
 
 
-def render(value: dict) -> str:
+def render(value: dict, details: dict | None = None) -> str:
     ac = int(value["acConnected"])
     if not value["present"]:
         return f"present=0 ac={ac}\n"
+    fields = ""
+    for key, field in NUMBERS.items():
+        if key in (details or {}):
+            fields += f" {field}={details[key]}"
+    for key, field in TEXT.items():
+        if key in (details or {}):
+            fields += f" {field}={details[key].encode().hex()}"
     empty = value["timeToEmptySeconds"]
     full = value["timeToFullSeconds"]
     return (f"present=1 status={value['state']} capacity={value['percentage']} ac={ac} "
             f"time_to_empty={-1 if empty is None else empty} "
-            f"time_to_full={-1 if full is None else full}\n")
+            f"time_to_full={-1 if full is None else full}{fields}\n")
 
 
 def main() -> int:
     try:
+        if sys.argv[1:] == ["--details"]:
+            details = decode_details(sys.stdin.buffer.read(4097))
+            previous = decode(CACHE.read_bytes())
+            if not previous["present"]:
+                details = {}
+            save(DETAILS, details)
+            STATE.write_text(render(previous, details))
+            return 0
         if sys.argv[1:] == ["--offline"]:
+            save(DETAILS, {})
             try:
                 previous = decode(CACHE.read_bytes())
             except (OSError, ValueError):
@@ -61,11 +110,11 @@ def main() -> int:
         if sys.argv[1:]:
             return 2
         value = decode(sys.stdin.buffer.read(4097))
-        STATE.write_text(render(value))
-        CACHE.parent.mkdir(parents=True, exist_ok=True)
-        temporary = CACHE.with_suffix(".part")
-        temporary.write_text(json.dumps(value, separators=(",", ":")))
-        temporary.replace(CACHE)
+        details = load_details() if value["present"] else {}
+        if not value["present"]:
+            save(DETAILS, {})
+        STATE.write_text(render(value, details))
+        save(CACHE, value)
         return 0
     except (OSError, ValueError, json.JSONDecodeError) as error:
         print(f"battery snapshot rejected: {error}", file=sys.stderr)
