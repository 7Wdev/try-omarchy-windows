+class VolumeMirror:
+    """The visible Pulse controls are Windows controls while sync is enabled."""
+
+    def __init__(self, mirror: PipeWireMirror, send: Any) -> None:
+        self.mirror, self.send = mirror, send
+        mirror.volume_sync = self
+        self.endpoint = ""
+        self.sequence = 0
+        self.value: tuple[float, bool] | None = None
+        self.last: dict[str, tuple[float, bool]] = {}
+        self.pending: tuple[float, bool] | None = None
+        self.changed_at = 0.0
+        self.inflight = False
+        self.transport_mute: tuple[str, bool] | None = None
+
+    @staticmethod
+    def equal(a: tuple[float, bool] | None, b: tuple[float, bool] | None) -> bool:
+        return a is not None and b is not None and a[1] == b[1] and abs(a[0] - b[0]) <= 0.001
+
+    def local(self) -> tuple[float, bool] | None:
+        current = run_pactl("get-default-sink", check=False)
+        if current not in self.mirror.output_uids:
+            return None
+        sink = next((s for s in self.mirror._sink_details() if s.get("name") == current), None)
+        if sink is None or type(sink.get("mute")) is not bool:
+            return None
+        raw_volume = max(self.mirror._channel_volumes(sink))
+        value = (min(1.0, raw_volume / 65536), sink["mute"])
+        if raw_volume > 65536:
+            run_pactl("set-sink-volume", current, "65536")
+        if not self.equal(value, self.last.get(current)):
+            self.last[current] = value
+            self.pending = value
+            self.changed_at = time.monotonic()
+        return value
+
+    def poll(self) -> None:
+        if not self.mirror.sync_enabled:
+            return
+        self.local()
+        if self.pending is not None and not self.inflight and time.monotonic() - self.changed_at >= 0.04:
+            volume, muted = self.pending
+            self.send({"type": "set-volume", "endpointID": self.endpoint,
+                       "volume": volume, "muted": muted, "origin": "guest", "sequence": self.sequence})
+            self.inflight = True
+
+    def apply(self, message: dict[str, Any]) -> None:
+        enabled, volume, muted = message.get("enabled"), message.get("volume"), message.get("muted")
+        sequence, endpoint, origin = message.get("sequence"), message.get("endpointID"), message.get("origin")
+        if (type(enabled) is not bool or type(muted) is not bool or type(volume) not in (int, float)
+                or not math.isfinite(volume) or not 0 <= volume <= 1 or type(sequence) is not int
+                or sequence <= 0 or not isinstance(endpoint, str) or len(endpoint) > 4096
+                or (enabled and not endpoint) or origin not in ("guest", "windows")):
+            raise ValueError("invalid Windows volume state")
+        if sequence < self.sequence:
+            return
+        was_enabled = self.mirror.sync_enabled
+        if was_enabled:
+            self.local()  # Keep a second guest gesture that arrived before the acknowledgement.
+        value = (float(volume), muted)
+        if origin == "windows" or endpoint != self.endpoint or not enabled or self.equal(self.pending, value):
+            self.pending = None
+        self.endpoint, self.sequence, self.value = endpoint, sequence, value
+        self.inflight = False
+        if enabled != was_enabled:
+            if not enabled:
+                self.restore_transport_mute()
+            self.mirror.sync_enabled = enabled
+            self.last.clear()
+            if self.mirror.catalog is not None:
+                self.mirror.apply(self.mirror.catalog)
+            if not enabled and was_enabled:
+                # Independent mode starts at the last visible level, with the
+                # original remap gain/mute semantics. Windows is left alone.
+                self.write_controls(value)
+        if enabled:
+            self.refresh_graph()
+            if was_enabled and origin == "windows":
+                self.show_osd(value)
+
+    def write_controls(self, value: tuple[float, bool]) -> None:
+        for name in self.mirror.output_uids:
+            if not self.equal(self.last.get(name), value):
+                run_pactl("set-sink-volume", name, str(round(value[0] * 65536)))
+                run_pactl("set-sink-mute", name, "1" if value[1] else "0")
+                self.last[name] = value
+
+    def refresh_graph(self) -> None:
+        if not self.mirror.sync_enabled or self.value is None:
+            return
+        transport = self.mirror.transport_name
+        if transport is not None and self.transport_mute is None:
+            sink = next((s for s in self.mirror._sink_details() if s.get("name") == transport), None)
+            if sink is not None and type(sink.get("mute")) is bool:
+                self.transport_mute = (transport, sink["mute"])
+                run_pactl("set-sink-mute", transport, "0")
+        self.write_controls(self.pending if self.pending is not None else self.value)
+
+    def restore_transport_mute(self) -> None:
+        if self.transport_mute is not None:
+            name, muted = self.transport_mute
+            try:
+                sink = next((s for s in self.mirror._sink_details() if s.get("name") == name), None)
+                if sink is not None and sink.get("mute") is False:
+                    run_pactl("set-sink-mute", name, "1" if muted else "0")
+            except (RuntimeError, ValueError, TypeError, KeyError):
+                log("Could not restore QEMU audio transport mute")
+            finally:
+                self.transport_mute = None
+
+    @staticmethod
+    def show_osd(value: tuple[float, bool]) -> None:
+        # Show the existing OSD without invoking another volume adjustment.
+        try:
+            subprocess.run(["omarchy-osd", "-i", "volume-muted" if value[1] or value[0] == 0 else "volume-high",
+                            "-p", str(round(value[0] * 100))], stdin=subprocess.DEVNULL,
+                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1, check=False)
+        except (OSError, subprocess.TimeoutExpired):
+            pass
+
+
 def open_port() -> int:
     while True:
         try:
@@ -398,7 +548,9 @@ def main() -> int:
             offset += os.write(descriptor, payload[offset:])
 
     mirror = PipeWireMirror(send)
+    volume = VolumeMirror(mirror, send)
     buffer = bytearray()
