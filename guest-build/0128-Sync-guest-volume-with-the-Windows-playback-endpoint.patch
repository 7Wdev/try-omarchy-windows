+            offset += written
 
     mirror = PipeWireMirror(send)
-    buffer = bytearray()
-    send({"type": "get-catalog"})
+    volume = VolumeMirror(mirror, send)
     try:
         while True:
-            ready, _, _ = select.select([descriptor], [], [], 0.25)
-            if ready:
-                chunk = os.read(descriptor, 65536)
-                if not chunk:
-                    return 0
-                buffer.extend(chunk)
-                if len(buffer) > 1_048_576:
-                    raise RuntimeError("host audio catalog exceeds one MiB")
-                while b"\n" in buffer:
-                    line, _, remainder = buffer.partition(b"\n")
-                    buffer = bytearray(remainder)
-                    message = json.loads(line)
-                    if not isinstance(message, dict) or message.get("type") != "catalog":
-                        raise ValueError("host sent an invalid audio message")
-                    applied = False
-                    while not applied:
-                        try:
-                            mirror.apply(message)
-                            applied = True
-                        except RuntimeError as error:
-                            log(str(error))
-                            time.sleep(1)
+            descriptor = open_port()
+            buffer = bytearray()
+            volume_requested = False
             try:
-                mirror.poll_selection()
-            except RuntimeError as error:
+                send({"type": "get-catalog"})
+                while True:
+                    if not volume.check_host():
+                        volume_requested = False
+                        send({"type": "get-catalog"})
+                    ready, _, _ = select.select([descriptor], [], [], 0.25)
+                    if ready:
+                        chunk = os.read(descriptor, 65536)
+                        if not chunk:
+                            break
+                        buffer.extend(chunk)
+                        if len(buffer) > 1_048_576:
+                            raise ValueError("host audio catalog exceeds one MiB")
+                        while b"\n" in buffer:
+                            line, _, remainder = buffer.partition(b"\n")
+                            buffer = bytearray(remainder)
+                            message = json.loads(line)
+                            if not isinstance(message, dict) or message.get("type") not in ("catalog", "volume"):
+                                raise ValueError("host sent an invalid audio message")
+                            try:
+                                if message["type"] == "volume":
+                                    volume.apply(message)
+                                else:
+                                    mirror.apply(message)
+                                    volume.capable = message.get("volumeSync") is True
+                                    if not volume.capable:
+                                        volume.disconnect()
+                                    elif not volume_requested:
+                                        send({"type": "get-volume"})
+                                        volume_requested = True
+                            except RuntimeError as error:
+                                log(str(error))
+                    try:
+                        mirror.poll_selection()
+                    except RuntimeError as error:
