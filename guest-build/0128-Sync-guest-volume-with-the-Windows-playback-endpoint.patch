+++ b/guest/tests/test_windows_volume_sync.py
@@ -0,0 +1,175 @@
+"""Volume control, echo and compatibility contracts without an audio device."""
+
+import json
+from pathlib import Path
+import unittest
+from unittest import mock
+
+from test_windows_audio_bridge import bridge, PactlStub, catalog_message
+
+
+class VolumePactl(PactlStub):
+    def __init__(self):
+        super().__init__()
+        self.routes = {}
+        self.transport_muted = True
+
+    def __call__(self, *args, **kwargs):
+        if args == ("--format=json", "list", "sinks"):
+            records = json.loads(super().__call__(*args, **kwargs))
+            records[0]["mute"] = self.transport_muted
+            records += [{"name": name, "mute": value[1], "volume": {"left": {"value": value[0]}, "right": {"value": value[0]}}}
+                        for name, value in self.routes.items()]
+            return json.dumps(records)
+        if args[0] == "load-module":
+            for arg in args[2:]:
+                if arg.startswith("sink_name="):
+                    self.routes[arg.partition("=")[2]] = (65536, False)
+        if args[0] == "set-sink-volume" and args[1] in self.routes:
+            self.calls.append((args, True))
+            self.routes[args[1]] = (int(args[2]), self.routes[args[1]][1])
+            return ""
+        if args[0] == "set-sink-mute":
+            self.calls.append((args, True))
+            if args[1] == self.transport_sink:
+                self.transport_muted = args[2] == "1"
+            else:
+                self.routes[args[1]] = (self.routes[args[1]][0], args[2] == "1")
+            return ""
+        return super().__call__(*args, **kwargs)
+
+
+def state(sequence=1, volume=0.5, muted=False, endpoint="speakers", enabled=True, origin="windows"):
+    return {"type": "volume", "enabled": enabled, "volume": volume, "muted": muted,
+            "sequence": sequence, "endpointID": endpoint, "origin": origin}
+
+
+class VolumeSyncTests(unittest.TestCase):
+    def setUp(self):
+        self.pactl = VolumePactl()
+        self.patch = mock.patch.object(bridge, "run_pactl", self.pactl)
+        self.patch.start()
+        self.addCleanup(self.patch.stop)
+        self.sent = []
+        self.mirror = bridge.PipeWireMirror(self.sent.append)
+        self.volume = bridge.VolumeMirror(self.mirror, self.sent.append)
+        self.addCleanup(self.mirror.close)
+        osd_patch = mock.patch.object(self.volume, "show_osd")
+        self.osd = osd_patch.start()
+        self.addCleanup(osd_patch.stop)
+        self.mirror.apply(catalog_message())
+        self.volume.apply(state())
+        self.default = self.pactl.default_sink
+
+    def poll(self):
+        self.volume.poll()
+        self.volume.changed_at = 0
+        self.volume.poll()
+
+    def test_sync_graph_bypasses_volume_and_mute_without_double_gain(self):
+        nulls = [c for c in self.pactl.matching_calls("load-module") if c[1] == "module-null-sink"]
+        feeds = [c for c in self.pactl.matching_calls("load-module") if c[1] == "module-loopback"]
+        self.assertEqual(len(nulls), 3)
+        self.assertEqual(len(feeds), 3)
+        for call in nulls:
+            self.assertIn("monitor.channel-volumes=false", " ".join(call))
+            self.assertIn("monitor.passthrough=true", " ".join(call))
+        for call in feeds:
+            self.assertIn(f"sink={self.pactl.transport_sink}", call)
+            # Omarchy's DSP resolver follows a stream whose node.name starts
+            # with the sink name. Feeds must NOT make it bypass our controls.
+            self.assertIn("node.name=try_omarchy_volume_feed_", " ".join(call))
+        self.assertEqual(self.pactl.volumes, [65536, 65536])
+        self.assertFalse(self.pactl.transport_muted)
+        self.assertEqual(self.pactl.routes[self.default], (32768, False))
+
+    def test_host_mute_osd_and_echo(self):
+        self.volume.apply(state(2, 0.7, True))
+        self.assertEqual(self.pactl.routes[self.default], (45875, True))
+        self.osd.assert_called_once_with((0.7, True))
+        self.poll()
+        self.assertEqual(self.sent, [])
+        self.assertFalse(self.pactl.transport_muted)
+
+    def test_guest_mute_and_second_gesture_survive_ack(self):
+        self.pactl.routes[self.default] = (39322, True)
+        self.poll()
+        self.assertEqual(len(self.sent), 1)
+        self.assertEqual(self.sent[-1]["sequence"], 1)
+        self.assertTrue(self.sent[-1]["muted"])
+        self.pactl.routes[self.default] = (52429, False)
+        self.volume.apply(state(2, 39322 / 65536, True, origin="guest"))
+        self.assertEqual(self.pactl.routes[self.default], (52429, False))
+        self.poll()
+        self.assertEqual(self.sent[-1]["sequence"], 2)
+        self.assertAlmostEqual(self.sent[-1]["volume"], 0.8, places=4)
+
+    def test_device_switch_discards_old_write_and_initializes_new_device(self):
+        self.pactl.routes[self.default] = (60000, True)
+        self.poll()
+        self.volume.apply(state(2, 0.2, False, endpoint="headphones"))
+        self.assertIsNone(self.volume.pending)
+        self.assertEqual(self.pactl.routes[self.default], (13107, False))
+        self.poll()
+        self.assertEqual(len(self.sent), 1)
+
+    def test_guest_boost_is_clamped_to_windows_master_range(self):
+        self.pactl.routes[self.default] = (98304, False)
+        self.poll()
+        self.assertEqual(self.pactl.routes[self.default], (65536, False))
+        self.assertEqual(self.sent[-1]["volume"], 1.0)
+
+    def test_toggle_off_restores_independent_remaps_and_transport_mute(self):
+        self.volume.apply(state(2, enabled=False))
+        self.assertFalse(self.mirror.sync_enabled)
+        self.assertTrue(self.pactl.transport_muted)
+        self.assertEqual(len(self.mirror.module_ids), 6)
+        self.pactl.routes[self.default] = (20000, True)
+        self.poll()
+        self.assertEqual(self.sent, [])
+        self.volume.apply(state(3, 0.9, True, enabled=False))
+        self.assertEqual(self.pactl.routes[self.default], (20000, True))
+        self.volume.apply(state(4, 0.3, False))
+        self.assertEqual(self.pactl.routes[self.default], (19661, False))
+        self.assertFalse(self.pactl.transport_muted)
+
+    def test_graph_rebuild_keeps_host_control_state(self):
+        changed = catalog_message()
+        changed["outputs"][0]["name"] = "Renamed speakers"
+        self.mirror.apply(changed)
+        self.assertEqual(self.pactl.routes[self.default], (32768, False))
+        self.poll()
+        self.assertEqual(self.sent, [])
+
+    def test_old_launcher_catalog_alone_keeps_independent_behavior(self):
+        mirror = bridge.PipeWireMirror(self.sent.append)
+        bridge.VolumeMirror(mirror, self.sent.append)
+        mirror.apply(catalog_message())
+        self.assertFalse(mirror.sync_enabled)
+        self.assertEqual(len(mirror.module_ids), 6)
+        mirror.close()
+
+    def test_main_requests_volume_only_from_a_capable_host(self):
+        for capable in (False, True):
+            with self.subTest(capable=capable):
+                message = catalog_message()
+                if capable:
+                    message["volumeSync"] = True
+                writes = []
+                with mock.patch.object(bridge, "open_port", return_value=17), \
+                        mock.patch.object(bridge.os, "read", side_effect=[json.dumps(message).encode() + b"\n", b""]), \
+                        mock.patch.object(bridge.os, "write", side_effect=lambda fd, data: writes.append(json.loads(data)) or len(data)), \
+                        mock.patch.object(bridge.os, "close"), \
+                        mock.patch.object(bridge.select, "select", return_value=([17], [], [])), \
+                        mock.patch.object(bridge.signal, "signal"):
+                    self.assertEqual(bridge.main(), 0)
+                self.assertEqual(writes, [{"type": "get-catalog"}] + ([{"type": "get-volume"}] if capable else []))
+
+    def test_revision_delivers_bridge_to_existing_disks(self):
+        finalize = (Path(__file__).resolve().parents[1] / "scripts/finalize-rootfs.sh").read_text()
+        self.assertIn("compat_revision=50", finalize)
+        self.assertIn("usr/local/bin/omarchy-windows-audio-bridge", finalize)
+
+
