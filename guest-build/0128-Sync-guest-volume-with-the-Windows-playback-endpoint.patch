+    def test_main_reconnect_negotiates_capability_and_new_sequence(self):
+        capable = catalog_message()
+        capable["volumeSync"] = True
+        old = catalog_message()
+        chunks = iter([
+            json.dumps(capable).encode() + b"\n" + json.dumps(state(10)).encode() + b"\n", b"",
+            json.dumps(old).encode() + b"\n" + json.dumps(state(1)).encode() + b"\n", b"",
+            json.dumps(capable).encode() + b"\n" + json.dumps(state(1, 0.3)).encode() + b"\n", b"",
+        ])
+        sessions = []
+        def read(_fd, _size):
+            chunk = next(chunks)
+            if not chunk:
+                sessions.append(self.mirror.sync_enabled)
+            return chunk
+        with mock.patch.object(bridge, "PipeWireMirror", return_value=self.mirror), \
+                mock.patch.object(bridge, "VolumeMirror", return_value=self.volume), \
+                mock.patch.object(bridge, "open_port", side_effect=[17, 18, 19, SystemExit(0)]), \
+                mock.patch.object(bridge.os, "read", side_effect=read), \
+                mock.patch.object(bridge.os, "write", side_effect=lambda fd, data: len(data)), \
+                mock.patch.object(bridge.os, "close"), \
+                mock.patch.object(bridge.select, "select", side_effect=lambda *args: ([args[0][0]], [], [])), \
