@@ -414,12 +566,20 @@ def main() -> int:
                     line, _, remainder = buffer.partition(b"\n")
                     buffer = bytearray(remainder)
                     message = json.loads(line)
-                    if not isinstance(message, dict) or message.get("type") != "catalog":
+                    if not isinstance(message, dict) or message.get("type") not in ("catalog", "volume"):
                         raise ValueError("host sent an invalid audio message")
                     applied = False
                     while not applied:
                         try:
-                            mirror.apply(message)
+                            if message["type"] == "volume":
+                                volume.apply(message)
+                            else:
+                                mirror.apply(message)
+                                # Older hosts reject unknown requests. Opt in
+                                # only when their catalog advertises support.
+                                if message.get("volumeSync") is True and not volume_requested:
+                                    send({"type": "get-volume"})
+                                    volume_requested = True
                             applied = True
                         except RuntimeError as error:
                             log(str(error))
