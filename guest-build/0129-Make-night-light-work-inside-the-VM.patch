+class PersistentNightlightTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.overlay = GUEST / 'factory-overlay'
+        self.payload = self.overlay / 'usr/share/try-omarchy/nightlight'
+        self.hooks = json.loads((self.payload / 'manifest.json').read_text())
+        for hook in self.hooks:
+            relative = hook['path'].removeprefix('usr/share/omarchy/').removeprefix('usr/')
+            target = self.root / hook['path']
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(GUEST / 'tests/fixtures/nightlight' / relative, target)
+            target.chmod(hook['mode'])
+
+    def install(self):
+        subprocess.run([str(self.overlay / 'usr/local/lib/try-omarchy/install-nightlight'),
+                        '--root', str(self.root), '--homes', str(self.root / 'home'),
+                        '--payload', str(self.payload)], check=True, capture_output=True)
+
+    def test_reviewed_defaults_and_repeat_install(self):
+        self.install()
+        for hook in self.hooks:
+            target = self.root / hook['path']
+            self.assertEqual(target.read_bytes(), (self.payload / hook['asset']).read_bytes())
+            modified = target.stat().st_mtime_ns
+            self.install()
+            self.assertEqual(target.stat().st_mtime_ns, modified)
+
+    def test_custom_missing_and_symlinked_files_are_preserved(self):
+        for hook in self.hooks:
+            target = self.root / hook['path']
+            target.write_text('custom content')
+            self.install()
+            self.assertEqual(target.read_text(), 'custom content')
+            target.unlink()
+            self.install()
+            self.assertFalse(target.exists())
+            saved = self.root / hook['asset']
+            saved.write_text('linked content')
+            target.symlink_to(saved)
+            self.install()
+            self.assertTrue(target.is_symlink())
+            self.assertEqual(saved.read_text(), 'linked content')
+
+    def test_factory_patch_matches_delivered_payload_and_queue(self):
+        stage = self.root / 'patched'
+        shutil.copytree(GUEST / 'tests/fixtures/nightlight', stage)
+        subprocess.run(['git', 'apply', '--no-index', str(GUEST / 'patches/omarchy/virtio-nightlight.patch')], cwd=stage, check=True)
+        for hook in self.hooks:
+            relative = hook['path'].removeprefix('usr/share/omarchy/').removeprefix('usr/')
+            self.assertEqual((stage / relative).read_bytes(), (self.payload / hook['asset']).read_bytes())
+        subprocess.run(['node', str(GUEST / 'tests/nightlight-queue.test.js'), str(stage)], check=True)
+
+    def test_only_exact_windows_guest_token_selects_backend(self):
+        self.install()
+        commands = self.root / 'bin'
+        commands.mkdir()
+        log = self.root / 'calls'
+        for name, body in {
+            'cat': 'printf "%s\\n" "$TEST_CMDLINE"',
+            'omarchy-native-nightlight': 'echo native >> "$TEST_LOG"',
+            'pgrep': 'exit 0', 'sleep': 'exit 0', 'omarchy-shell': 'exit 0',
+            'hyprctl': 'echo hardware >> "$TEST_LOG"; echo 4000',
+        }.items():
+            command = commands / name
+            command.write_text('#!/bin/sh\n' + body + '\n')
+            command.chmod(0o755)
+        for token, native in [('omarchy.qemu=1', True), ('omarchy.qemu=10', False), ('xomarchy.qemu=1', False), ('quiet', False)]:
+            log.unlink(missing_ok=True)
+            subprocess.run(['bash', str(self.root / 'usr/bin/omarchy-toggle-nightlight'), '--temperature', '4000'],
+                           env=dict(os.environ, PATH=f'{commands}:{os.environ["PATH"]}', TEST_CMDLINE=f'root=/dev/vda {token} quiet', TEST_LOG=str(log)), check=True, capture_output=True)
+            self.assertEqual('native' in log.read_text(), native)
+
+    def test_delivery_revision_and_runtime_ownership(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        catch_up = (self.overlay / 'usr/local/lib/try-omarchy/catch-up').read_text()
+        for path in ['usr/local/bin/omarchy-native-nightlight', 'usr/local/share/try-omarchy/nightlight.frag', 'usr/local/lib/try-omarchy/install-nightlight', 'usr/share/try-omarchy/nightlight']:
+            self.assertIn(path, finalizer)
+        self.assertIn('compat_revision=51', finalizer)
+        self.assertIn('previous_revision < 51', catch_up)
