diff --git a/guest/factory-overlay/usr/share/try-omarchy/nightlight/shell_plugins_services_nightlight_Service.qml b/guest/factory-overlay/usr/share/try-omarchy/nightlight/shell_plugins_services_nightlight_Service.qml
new file mode 100644
index 0000000..5be626a
--- /dev/null
+++ b/guest/factory-overlay/usr/share/try-omarchy/nightlight/shell_plugins_services_nightlight_Service.qml
@@ -0,0 +1,139 @@
+import QtQuick
+import Quickshell.Io
+import Quickshell.Hyprland
+import "NightlightModel.js" as NightlightModel
+
+Item {
+  id: root
+
+  // Injected by omarchy-shell (the first-party service loader).
+  property var shell: null
+
+  // Keep in sync with bin/omarchy-toggle-nightlight, which sets the same
+  // temperatures for callers outside the shell (keybindings, menu, ssh).
+  readonly property int nightTemperature: 4000
+  readonly property int dayTemperature: 6500
+
+  property bool stateLoaded: false
+  property var temperature: null
+  readonly property bool enabled: stateLoaded && NightlightModel.isNightlight(temperature)
+
+  // Requested intent is separate from the last confirmed compositor state.
+  property var requestedTemperature: null
+  property bool refreshPending: false
+  property bool hasPendingTemperature: false
+  property int pendingTemperature: 0
+
+  function refresh() {
+    if (applyProcess.running) return
+    if (statusProbe.running) {
+      root.refreshPending = true
+      return
+    }
+    root.refreshPending = false
+    statusProbe.running = true
+  }
+
+  function setNightlight(value) {
+    applyTemperature(value ? nightTemperature : dayTemperature)
+  }
+
+  function toggle() {
+    var enabling = !(requestedTemperature !== null
+      ? NightlightModel.isNightlight(requestedTemperature) : enabled)
+    setNightlight(enabling)
+    return enabling
+  }
+
+  function applyTemperature(temp) {
+    root.requestedTemperature = temp
+    if (applyProcess.running) {
+      root.pendingTemperature = temp
+      root.hasPendingTemperature = true
+      return
+    }
+
+    runApply(temp)
+  }
+
+  function runApply(temp) {
+    applyProcess.command = ["omarchy-toggle-nightlight", "--temperature", String(temp)]
+    applyProcess.running = true
+  }
+
+  Process {
+    id: statusProbe
+    command: ["omarchy-toggle-nightlight", "--status"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: {
+        try {
+          var state = JSON.parse(text)
+          root.temperature = typeof state.temperature === "number" ? state.temperature : null
+        } catch (error) {
+          root.temperature = null
+        }
+        root.stateLoaded = true
+      }
+    }
+    onExited: function(exitCode) {
+      if (exitCode !== 0) {
+        root.temperature = null
+        root.stateLoaded = true
+      }
+      if (applyProcess.running) return
+      // A probe already in flight when an apply finished may be stale.
+      if (root.refreshPending) root.refresh()
+      else root.requestedTemperature = null
+    }
+  }
+
+  Process {
+    id: applyProcess
+    onExited: function() {
+      if (root.hasPendingTemperature) {
+        root.hasPendingTemperature = false
+        root.runApply(root.pendingTemperature)
+        return
+      }
+
+      root.refresh()
+    }
+  }
+
+  Connections {
+    target: Hyprland
+    function onRawEvent(event) {
+      if (event.name === "configreloaded") root.refresh()
+    }
+  }
+
+  Component.onCompleted: refresh()
+
+  IpcHandler {
+    target: "nightlight"
+
+    function status(): string {
+      return JSON.stringify({ enabled: root.enabled, temperature: root.temperature })
+    }
+
+    function refresh(): void {
+      root.refresh()
+    }
+
+    function enable(): string {
+      root.setNightlight(true)
+      return "enabled"
+    }
+
+    function disable(): string {
+      root.setNightlight(false)
+      return "disabled"
+    }
+
+    function toggle(): string {
+      var enabling = root.toggle()
+      return enabling ? "enabled" : "disabled"
+    }
+  }
+}
diff --git a/guest/native-overlay/usr/local/bin/omarchy-native-nightlight b/guest/native-overlay/usr/local/bin/omarchy-native-nightlight
new file mode 100755
index 0000000..1293974
--- /dev/null
+++ b/guest/native-overlay/usr/local/bin/omarchy-native-nightlight
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Apply Omarchy's manual night-light toggle on the Virtio/VirGL display."""
+
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+
+SHADER = Path(__file__).resolve().parents[1] / "share/try-omarchy/nightlight.frag"
+
+
+def hyprctl(*args):
+    result = subprocess.run(
+        ["hyprctl", *args], capture_output=True, text=True, timeout=3, check=True
+    )
+    return result.stdout
+
+
+def current_shader():
+    value = json.loads(hyprctl("getoption", "decoration:screen_shader", "-j"))["str"]
+    if not isinstance(value, str):
+        raise ValueError("invalid screen shader response")
+    return "" if value == "[[EMPTY]]" else value
+
+
+def status():
+    enabled = current_shader() == str(SHADER)
+    return {"enabled": enabled, "temperature": 4000 if enabled else 6500}
+
+
+def apply(temperature):
+    previous = current_shader()
+    enabling = temperature == 4000 if temperature is not None else previous != str(SHADER)
+    if enabling:
+        if previous and previous != str(SHADER):
+            raise ValueError("A custom screen shader is active. Disable it before enabling night light.")
+        if not SHADER.is_file():
+            raise ValueError("The night-light shader is missing. Reinstall the night-light integration.")
+        target = str(SHADER)
+    else:
+        # Never clear a shader selected by the user after night light was enabled.
+        if previous != str(SHADER):
+            return
+        target = ""
+
+    hyprctl("eval", "hl.config({ decoration = { screen_shader = " + json.dumps(target) + " } })")
+    if current_shader() != target:
+        raise ValueError("Hyprland did not apply the night-light screen shader.")
+
+
+def main():
+    args = sys.argv[1:]
+    if args == ["--status"]:
+        try:
+            print(json.dumps(status()))
+            return 0
+        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
+            print(json.dumps({"enabled": False, "temperature": None}))
+            return 1
+
+    temperature = None
+    if args:
+        if len(args) != 2 or args[0] != "--temperature" or args[1] not in ("4000", "6500"):
+            print("Usage: omarchy-native-nightlight [--status | --temperature 4000|6500]", file=sys.stderr)
+            return 2
+        temperature = int(args[1])
+
+    try:
+        # Serialize the keybinding and bar button without storing a second copy
+        # of the enabled state. A config reload or user override stays truthful.
+        runtime = Path(os.environ["XDG_RUNTIME_DIR"])
+        instance = hashlib.sha256(os.environ["HYPRLAND_INSTANCE_SIGNATURE"].encode()).hexdigest()[:16]
+        with (runtime / f"try-omarchy-nightlight-{instance}.lock").open("a") as lock:
+            deadline = time.monotonic() + 3
+            while True:
+                try:
+                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                    break
+                except BlockingIOError:
+                    if time.monotonic() >= deadline:
+                        raise ValueError("Another night-light change is still running.")
+                    time.sleep(0.05)
+            apply(temperature)
+    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
+        message = str(error)
+        print(f"Night light: {message}", file=sys.stderr)
+        try:
+            subprocess.run(["notify-send", "Night light unavailable", message], timeout=3, check=False)
+        except (OSError, subprocess.SubprocessError):
+            pass
+        return 1
+
+    try:
+        subprocess.run(["omarchy-shell", "-q", "nightlight", "refresh"], timeout=5, check=False)
+    except (OSError, subprocess.SubprocessError):
+        pass  # The renderer setting remains valid while the shell is restarting.
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/guest/native-overlay/usr/local/share/try-omarchy/nightlight.frag b/guest/native-overlay/usr/local/share/try-omarchy/nightlight.frag
new file mode 100644
index 0000000..fe3287b
--- /dev/null
+++ b/guest/native-overlay/usr/local/share/try-omarchy/nightlight.frag
@@ -0,0 +1,12 @@
+#version 300 es
+// Omarchy's 4000 K manual night light, applied after scene composition.
+// Virtio GPU has no DRM CTM property, so hyprsunset's hardware path is a no-op.
+precision highp float;
+in vec2 v_texcoord;
+uniform sampler2D tex;
+out vec4 fragColor;
+
+void main() {
+    vec4 color = texture(tex, v_texcoord);
+    fragColor = vec4(color.rgb * vec3(1.0, 0.807, 0.651), color.a);
+}
