diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/install-nightlight b/guest/factory-overlay/usr/local/lib/try-omarchy/install-nightlight
new file mode 100755
index 0000000..1518ffc
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/install-nightlight
@@ -0,0 +1,99 @@
+#!/usr/bin/python3 -I
+"""Install reviewed guest defaults once, keeping customized and linked files."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import tempfile
+
+TARGETS = {'usr/bin/omarchy-toggle-nightlight', 'usr/share/omarchy/shell/plugins/services/nightlight/Service.qml'}
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def install_file(base, hook, data, previous=()):
+    target = base / hook["path"]
+    # Dotfiles checkouts and redirected system directories are user choices.
+    if base.is_symlink() or any(p.is_symlink() for p in [target, *target.parents]):
+        return
+    exists = target.exists()
+    if exists:
+        if not target.is_file():
+            return
+        old = digest(target.read_bytes())
+        versions = [(hook, data), *previous]
+        if any(old == version["afterSha256"] for version, _ in versions):
+            return
+        matching = next((contents for version, contents in versions
+                         if old in version["beforeSha256"]), None)
+        if matching is None:
+            print(f"Keeping customized {target}", flush=True)
+            return
+        data = matching
+    elif not hook.get("create", False):
+        return
+    owner = target.stat() if exists else base.stat()
+    missing = []
+    parent = target.parent
+    while not parent.exists():
+        missing.append(parent)
+        parent = parent.parent
+    for parent in reversed(missing):
+        parent.mkdir(mode=0o755)
+        os.chown(parent, owner.st_uid, owner.st_gid)
+    descriptor, temporary = tempfile.mkstemp(prefix=".nightlight-", dir=target.parent)
+    try:
+        with os.fdopen(descriptor, "wb") as output:
+            output.write(data)
+            os.fchmod(output.fileno(), owner.st_mode & 0o777 if exists else hook["mode"])
+            os.fchown(output.fileno(), owner.st_uid, owner.st_gid)
+            output.flush()
+            os.fsync(output.fileno())
+        if exists:
+            os.replace(temporary, target)
+        else:
+            # Do not replace a file that appeared while preparing its default.
+            try:
+                os.link(temporary, target)
+            except FileExistsError:
+                pass
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def install(root, homes, payload):
+    hooks = json.loads((payload / "manifest.json").read_text())
+    prepared = []
+    for hook in hooks:
+        if hook["path"] not in TARGETS or Path(hook["asset"]).name != hook["asset"]:
+            raise ValueError("unexpected night-light target")
+        versions = []
+        for version in [hook, *hook.get("previousVersions", [])]:
+            if Path(version["asset"]).name != version["asset"]:
+                raise ValueError("unexpected night-light asset")
+            data = (payload / version["asset"]).read_bytes()
+            if digest(data) != version["afterSha256"]:
+                raise ValueError("night-light payload digest mismatch")
+            versions.append((version, data))
+        prepared.append((hook, versions[0][1], versions[1:]))
+    for hook, data, previous in prepared:
+        if hook["path"].startswith(".config/"):
+            for home in homes.iterdir() if homes.is_dir() else []:
+                if home.is_dir() and not home.is_symlink():
+                    install_file(home, hook, data, previous)
+        else:
+            install_file(root, hook, data, previous)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path("/"))
+    parser.add_argument("--homes", type=Path, default=Path("/home"))
+    parser.add_argument("--payload", type=Path, default=Path("/usr/share/try-omarchy/nightlight"))
+    args = parser.parse_args()
+    install(args.root, args.homes, args.payload)
diff --git a/guest/factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-toggle-nightlight b/guest/factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-toggle-nightlight
new file mode 100644
index 0000000..8e0b6f8
--- /dev/null
+++ b/guest/factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-toggle-nightlight
@@ -0,0 +1,73 @@
+#!/bin/bash
+
+# omarchy:summary=Toggle nightlight screen temperature
+# omarchy:args=[--status | --temperature 4000|6500]
+# omarchy:examples=omarchy toggle nightlight
+
+# The Windows guest has no DRM CTM. Keep the command and shell on one backend.
+case " $(cat /proc/cmdline) " in
+  *" omarchy.qemu=1 "*) exec omarchy-native-nightlight "$@" ;;
+esac
+
+if (( $# > 0 )) && [[ ${1:-} != --status ]]; then
+  if (( $# != 2 )) || [[ $1 != --temperature || ! $2 =~ ^(4000|6500)$ ]]; then
+    echo "Usage: omarchy-toggle-nightlight [--status | --temperature 4000|6500]" >&2
+    exit 2
+  fi
+fi
+
+ON_TEMP=4000
+OFF_TEMP=6500
+IDENTITY_TEMP=6000
+
+current_temp() {
+  local output
+
+  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
+  grep -oE '[0-9]+' <<<"$output" | head -n1
+}
+
+status_json() {
+  local temp enabled
+
+  temp=$(current_temp)
+  if [[ -n $temp ]] && (( temp < IDENTITY_TEMP )); then
+    enabled=true
+  else
+    enabled=false
+  fi
+
+  jq -cn --argjson enabled "$enabled" --arg temp "$temp" \
+    '{enabled:$enabled, temperature:(($temp | tonumber?) // null)}'
+}
+
+if [[ ${1:-} == "--status" ]]; then
+  status_json
+  exit 0
+fi
+
+# Ensure hyprsunset is running
+if ! pgrep -x hyprsunset >/dev/null; then
+  setsid uwsm-app -- hyprsunset &
+fi
+
+# Query the current temperature
+CURRENT_TEMP=$(current_temp)
+
+if [[ ${1:-} == --temperature ]]; then
+  TARGET_TEMP=$2
+elif [[ -z $CURRENT_TEMP || $CURRENT_TEMP == $OFF_TEMP ]]; then
+  TARGET_TEMP=$ON_TEMP
+else
+  TARGET_TEMP=$OFF_TEMP
+fi
+
+# A freshly-started hyprsunset applies its default temperature at the end of
+# its boot, overriding anything set before then — so resend until it sticks
+for _ in {1..10}; do
+  hyprctl hyprsunset temperature $TARGET_TEMP >/dev/null 2>&1
+  sleep 0.2
+  [[ $(current_temp) == "$TARGET_TEMP" ]] && break
+done
+
+omarchy-shell -q nightlight refresh
