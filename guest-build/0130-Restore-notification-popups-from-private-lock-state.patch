+      "shellDir=" + Quickshell.shellDir,
+      "firstPartyPluginsDir=" + shell.firstPartyPluginsDir,
+      "defaultsPath=" + shell.defaultsPath,
+      "userConfigPath=" + shell.userConfigPath)
