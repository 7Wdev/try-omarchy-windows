+        originalId: -1,
+        app: "omarchy-action",
+        appIcon: "",
+        summary: "No recent notifications",
+        body: "",
+        image: "",
+        glyph: "󰂚",
+        execArgv: "",
+        urgency: NotificationUrgency.Low,
+        expireTimeout: 0,
