 strip_profile_block() {
   # Drop our appended block so the remainder can be compared with Omarchy's own file.
   sed '/^-- BEGIN OMARCHY QEMU PROFILE$/,/^-- END OMARCHY QEMU PROFILE$/d' "$1" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/install-notifications b/guest/factory-overlay/usr/local/lib/try-omarchy/install-notifications
new file mode 100755
index 0000000..bafc519
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/install-notifications
@@ -0,0 +1,99 @@
+#!/usr/bin/python3 -I
+"""Install reviewed guest defaults once, keeping customized and linked files."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import tempfile
+
+TARGETS = {'usr/share/omarchy/shell/shell.qml', 'usr/share/omarchy/shell/plugins/notifications/Service.qml', 'usr/share/omarchy/shell/services/AuthServiceStore.js'}
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def install_file(base, hook, data, previous=()):
+    target = base / hook["path"]
+    # Dotfiles checkouts and redirected system directories are user choices.
+    if base.is_symlink() or any(p.is_symlink() for p in [target, *target.parents]):
+        return
+    exists = target.exists()
+    if exists:
+        if not target.is_file():
+            return
+        old = digest(target.read_bytes())
+        versions = [(hook, data), *previous]
+        if any(old == version["afterSha256"] for version, _ in versions):
+            return
+        matching = next((contents for version, contents in versions
+                         if old in version["beforeSha256"]), None)
+        if matching is None:
+            print(f"Keeping customized {target}", flush=True)
+            return
+        data = matching
+    elif not hook.get("create", False):
+        return
+    owner = target.stat() if exists else base.stat()
+    missing = []
+    parent = target.parent
+    while not parent.exists():
+        missing.append(parent)
+        parent = parent.parent
+    for parent in reversed(missing):
+        parent.mkdir(mode=0o755)
+        os.chown(parent, owner.st_uid, owner.st_gid)
+    descriptor, temporary = tempfile.mkstemp(prefix=".notifications-", dir=target.parent)
+    try:
+        with os.fdopen(descriptor, "wb") as output:
+            output.write(data)
+            os.fchmod(output.fileno(), owner.st_mode & 0o777 if exists else hook["mode"])
+            os.fchown(output.fileno(), owner.st_uid, owner.st_gid)
+            output.flush()
+            os.fsync(output.fileno())
+        if exists:
+            os.replace(temporary, target)
+        else:
+            # Do not replace a file that appeared while preparing its default.
+            try:
+                os.link(temporary, target)
+            except FileExistsError:
+                pass
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def install(root, homes, payload):
+    hooks = json.loads((payload / "manifest.json").read_text())
+    prepared = []
+    for hook in hooks:
+        if hook["path"] not in TARGETS or Path(hook["asset"]).name != hook["asset"]:
+            raise ValueError("unexpected notification privacy target")
+        versions = []
+        for version in [hook, *hook.get("previousVersions", [])]:
+            if Path(version["asset"]).name != version["asset"]:
+                raise ValueError("unexpected notification privacy asset")
+            data = (payload / version["asset"]).read_bytes()
+            if digest(data) != version["afterSha256"]:
+                raise ValueError("notification privacy payload digest mismatch")
+            versions.append((version, data))
+        prepared.append((hook, versions[0][1], versions[1:]))
+    for hook, data, previous in prepared:
+        if hook["path"].startswith(".config/"):
+            for home in homes.iterdir() if homes.is_dir() else []:
+                if home.is_dir() and not home.is_symlink():
+                    install_file(home, hook, data, previous)
+        else:
+            install_file(root, hook, data, previous)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path("/"))
+    parser.add_argument("--homes", type=Path, default=Path("/home"))
+    parser.add_argument("--payload", type=Path, default=Path("/usr/share/try-omarchy/notifications"))
+    args = parser.parse_args()
+    install(args.root, args.homes, args.payload)
