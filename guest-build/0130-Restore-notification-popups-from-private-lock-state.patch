diff --git a/guest/tests/test_notification_privacy.py b/guest/tests/test_notification_privacy.py
new file mode 100644
index 0000000..8722dc9
--- /dev/null
+++ b/guest/tests/test_notification_privacy.py
@@ -0,0 +1,123 @@
+"""Check private lock-state decisions and persistent-disk default preservation."""
+import hashlib
+import importlib.machinery
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+PAYLOAD = GUEST / 'factory-overlay/usr/share/try-omarchy/notifications'
+FIXTURES = GUEST / 'tests/fixtures/notifications'
+INSTALLER = GUEST / 'factory-overlay/usr/local/lib/try-omarchy/install-notifications'
+loader = importlib.machinery.SourceFileLoader('notification_installer', str(INSTALLER))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+installer = importlib.util.module_from_spec(spec)
+loader.exec_module(installer)
+
+
+class NotificationPrivacyTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.hooks = json.loads((PAYLOAD / 'manifest.json').read_text())
+        for hook in self.hooks:
+            target = self.root / hook['path']
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes((FIXTURES / hook['path'].removeprefix('usr/share/omarchy/')).read_bytes())
+            target.chmod(0o640)
+
+    def install(self, payload=PAYLOAD):
+        installer.install(self.root, self.root / 'home', payload)
+
+    def test_reviewed_defaults_update_once_and_keep_metadata(self):
+        metadata = {}
+        for hook in self.hooks:
+            target = self.root / hook['path']
+            self.assertIn(hashlib.sha256(target.read_bytes()).hexdigest(), hook['beforeSha256'])
+            metadata[hook['path']] = target.stat()
+        self.install()
+        for hook in self.hooks:
+            target = self.root / hook['path']
+            self.assertEqual(target.read_bytes(), (PAYLOAD / hook['asset']).read_bytes())
+            self.assertEqual(target.stat().st_mode, metadata[hook['path']].st_mode)
+            self.assertEqual(target.stat().st_uid, metadata[hook['path']].st_uid)
+        times = [(self.root / h['path']).stat().st_mtime_ns for h in self.hooks]
+        self.install()
+        self.assertEqual(times, [(self.root / h['path']).stat().st_mtime_ns for h in self.hooks])
+
+    def test_custom_missing_and_linked_files_are_preserved(self):
+        custom, missing, linked = [self.root / h['path'] for h in self.hooks]
+        custom.write_text('custom shell')
+        missing.unlink()
+        outside = self.root / 'outside'; outside.write_bytes(linked.read_bytes())
+        linked.unlink(); linked.symlink_to(outside)
+        previous = outside.read_bytes()
+        self.install()
+        self.assertEqual(custom.read_text(), 'custom shell')
+        self.assertFalse(missing.exists())
+        self.assertTrue(linked.is_symlink())
+        self.assertEqual(outside.read_bytes(), previous)
+
+    def test_linked_parent_is_preserved(self):
+        shell = self.root / 'usr/share/omarchy/shell'
+        before = {p.relative_to(shell): p.read_bytes() for p in shell.rglob('*') if p.is_file()}
+        shell.rename(self.root / 'redirected'); shell.symlink_to(self.root / 'redirected')
+        self.install()
+        self.assertEqual(before, {p.relative_to(shell): p.read_bytes() for p in shell.rglob('*') if p.is_file()})
+
+    def test_corrupt_payload_fails_before_any_default_changes(self):
+        payload = self.root / 'payload'; shutil.copytree(PAYLOAD, payload)
+        (payload / self.hooks[-1]['asset']).write_text('corrupt')
+        before = [(self.root / h['path']).read_bytes() for h in self.hooks]
+        with self.assertRaises(ValueError): self.install(payload)
+        self.assertEqual(before, [(self.root / h['path']).read_bytes() for h in self.hooks])
+
+    def test_private_store_and_popup_gate_truth_table(self):
+        store = (PAYLOAD / 'shell_services_AuthServiceStore.js').read_text()
+        service = (PAYLOAD / 'shell_plugins_notifications_Service.qml').read_text()
+        gate = service.split('readonly property bool screenObscured:', 1)[1].split('\n\n', 1)[0].strip()
+        code = store + '\n' + '''
+const assert = require('node:assert/strict');
+assert.equal(lockScreenObscured(), true);
+put('omarchy.lock', { enteredPassword: 'private' });
+assert.equal(lockScreenObscured(), true);
+const lock = { locked: false, enteredPassword: 'private', destroy() {} };
+put('omarchy.lock', lock);
+assert.equal(lockScreenObscured(), false);
+lock.locked = true; assert.equal(lockScreenObscured(), true);
+lock.locked = false; lock.previewVisible = true; assert.equal(lockScreenObscured(), true);
+lock.previewVisible = false; assert.equal(lockScreenObscured(), false);
+destroy('omarchy.lock'); assert.equal(lockScreenObscured(), true);
+const obscured = (shell, idleService) => (GATE);
+const idle = { screensaverStateKnown: true, screensaverWindowCount: 0 };
+assert.equal(obscured({lockScreenObscured:false}, idle), false);
+for (const shell of [null, {}, {lockScreenObscured:true}, {lockScreenObscured:'false'}])
+  assert.equal(obscured(shell, idle), true);
+for (const state of [null, {screensaverStateKnown:false}, {screensaverStateKnown:true,screensaverWindowCount:1}])
+  assert.equal(obscured({lockScreenObscured:false}, state), true);
+'''.replace('GATE', gate)
+        result = subprocess.run(['node', '-e', code], capture_output=True, text=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        shell = (PAYLOAD / 'shell_shell.qml').read_text()
+        self.assertIn('readonly property bool lockScreenObscured:', shell)
+        self.assertNotIn('property var lockService', service)
+        self.assertNotIn('firstPartyServiceFor("omarchy.lock")', service)
+        # The public map still receives only non-authentication services.
+        self.assertIn('AuthServiceStore.put(key, inst)\n        shell._authenticationServiceRevision += 1\n      } else {', shell)
+        self.assertIn('return authenticationService ? null : (_services[key] || null)', shell)
+        self.assertFalse(any(line.strip() == '.pragma library' for line in store.splitlines()))
+
+    def test_compatibility_overlay_and_catch_up_revision(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        catch_up = (GUEST / 'factory-overlay/usr/local/lib/try-omarchy/catch-up').read_text()
+        self.assertIn('compat_revision=52', finalizer)
+        self.assertIn('usr/share/try-omarchy/notifications', finalizer)
+        self.assertIn('usr/local/lib/try-omarchy/install-notifications', finalizer)
+        self.assertIn('previous_revision < 52', catch_up)
+        self.assertEqual(json.loads((GUEST / 'spec.json').read_text())['upstream']['packageRelease'], 5)
