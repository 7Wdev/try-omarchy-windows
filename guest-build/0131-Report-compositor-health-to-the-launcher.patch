   usr/local/bin/try-omarchy-export
   usr/local/lib/try-omarchy/try-omarchy-import.pyz
   usr/local/lib/try-omarchy/agent
+  usr/local/lib/try-omarchy/compositor-health
   usr/local/lib/try-omarchy/update-battery-dkms
   usr/local/lib/try-omarchy/battery-apply
   usr/local/lib/try-omarchy/apply-host-locale
@@ -233,7 +234,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 50 synchronizes guest volume/mute with the Windows default endpoint.
 # Revision 51 delivers the VM night-light shader and guarded defaults.
 # Revision 52 repairs popup privacy using the private authentication state.
-compat_revision=52
+# Revision 53 delivers bounded compositor health probes through the agent.
+compat_revision=53
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
