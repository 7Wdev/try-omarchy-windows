diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/agent b/guest/factory-overlay/usr/local/lib/try-omarchy/agent
index 3d897fa..127e893 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/agent
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/agent
@@ -11,7 +11,8 @@ host=${TRY_OMARCHY_AGENT_HOST:-10.0.2.2}
 port=${TRY_OMARCHY_AGENT_PORT:-4451}
 set_time=${TRY_OMARCHY_SET_TIME:-date -s}
 fill_dir=${TRY_OMARCHY_FILL_DIR:-/var/tmp}
-version=4
+version=5
+health_probe=${TRY_OMARCHY_HEALTH_PROBE:-/usr/local/lib/try-omarchy/compositor-health}
 app_sync=${TRY_OMARCHY_APP_SYNC:-/usr/local/lib/try-omarchy/approved-apps-sync}
 max_drift=2
 # Space left free while zero-filling, so running programs keep working.
@@ -105,9 +106,20 @@ fi
 while :; do
   exec 3<>"/dev/tcp/$host/$port" 2>/dev/null || { sleep 10; continue; }
   printf 'hello %s\n' "$version" >&3
+  # Probe separately so clock/app handling and disk reclaim cannot hold up
+  # health reports. The helper bounds Hyprland IPC to two seconds.
+  (
+    while :; do
+      "$health_probe" >&3
+      sleep 5
+    done
+  ) &
+  health_pid=$!
   while IFS= read -r line <&3; do
     handle "${line%$'\r'}"
   done
+  kill "$health_pid" 2>/dev/null || true
+  wait "$health_pid" 2>/dev/null || true
   /usr/local/lib/try-omarchy/battery-apply --offline || true
   exec 3>&-
   sleep 5
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/compositor-health b/guest/factory-overlay/usr/local/lib/try-omarchy/compositor-health
new file mode 100755
index 0000000..e38adfc
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/compositor-health
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Report compositor IPC health, never claiming that pixels were presented."""
+import glob
+import json
+import os
+import pathlib
+import pwd
+import subprocess
+
+
+def probe(runtime_root="/run/user", run=subprocess.run):
+    for socket in sorted(glob.glob(f"{runtime_root}/*/hypr/*/.socket.sock")):
+        path = pathlib.Path(socket)
+        try:
+            uid = int(path.parents[2].name)
+            user = pwd.getpwuid(uid).pw_name
+            if path.stat().st_uid != uid:
+                continue
+            result = run(["runuser", "-u", user, "--", "env",
+                          f"XDG_RUNTIME_DIR={path.parents[2]}",
+                          f"HYPRLAND_INSTANCE_SIGNATURE={path.parent.name}",
+                          "hyprctl", "-j", "monitors"],
+                         capture_output=True, text=True, timeout=2, check=True)
+            monitors = json.loads(result.stdout)
+            if isinstance(monitors, list) and monitors:
+                return "ok"
+        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
+            pass
+        return "unresponsive"
+    # Login/logout is not a freeze. The next compositor heartbeat arms again.
+    return "inactive"
+
+
+if __name__ == "__main__":
+    print("compositor " + probe())
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/reboot-notify b/guest/factory-overlay/usr/local/lib/try-omarchy/reboot-notify
index 3a206e9..9f0962f 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/reboot-notify
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/reboot-notify
@@ -3,6 +3,7 @@
 # guest is REBOOTING (not powering off), tell the host shell on the lifecycle
 # port so it relaunches QEMU - a QEMU wedged during guest reset under stock
 # WHPX delivers no SHUTDOWN event, so QMP alone cannot tell the two apart.
-systemctl list-jobs 2>/dev/null | grep -q 'reboot.target.*start' || exit 0
-printf 'reboot\n' | socat -u - TCP:10.0.2.2:4450,connect-timeout=2 2>/dev/null || true
+intent=shutdown
+systemctl list-jobs 2>/dev/null | grep -q 'reboot.target.*start' && intent=reboot
+printf '%s\n' "$intent" | socat -u - TCP:10.0.2.2:4450,connect-timeout=2 2>/dev/null || true
 exit 0
