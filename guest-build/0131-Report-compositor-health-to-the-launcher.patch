diff --git a/guest/tests/test_compositor_health.py b/guest/tests/test_compositor_health.py
new file mode 100644
index 0000000..3c1411a
--- /dev/null
+++ b/guest/tests/test_compositor_health.py
@@ -0,0 +1,43 @@
+import importlib.machinery
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+GUEST = Path(__file__).resolve().parents[1]
+HELPER = GUEST / 'factory-overlay/usr/local/lib/try-omarchy/compositor-health'
+health = importlib.machinery.SourceFileLoader('compositor_health', str(HELPER)).load_module()
+
+class CompositorHealthTests(unittest.TestCase):
+    def test_no_session_is_inactive(self):
+        with tempfile.TemporaryDirectory() as root:
+            self.assertEqual(health.probe(root), 'inactive')
+
+    def test_ipc_success_timeout_and_invalid_reply(self):
+        with tempfile.TemporaryDirectory() as root:
+            socket = Path(root) / str(os.getuid()) / 'hypr' / 'test' / '.socket.sock'
+            socket.parent.mkdir(parents=True)
+            socket.touch()
+            def run(args, **kw):
+                self.assertEqual(kw['timeout'], 2)
+                self.assertIn('HYPRLAND_INSTANCE_SIGNATURE=test', args)
+                self.assertEqual(args[-3:], ['hyprctl', '-j', 'monitors'])
+                return subprocess.CompletedProcess(args, 0, '[{"name":"Virtual-1"}]')
+            self.assertEqual(health.probe(root, run), 'ok')
+            for output in ['[]', 'null', 'error', '{}']:
+                self.assertEqual(health.probe(root, lambda *a, **kw: subprocess.CompletedProcess(a,0,output)), 'unresponsive')
+            def timeout(*a, **kw): raise subprocess.TimeoutExpired(a, 2)
+            self.assertEqual(health.probe(root, timeout), 'unresponsive')
+
+    def test_existing_disks_receive_health_files(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        self.assertIn('compat_revision=53', finalizer)
+        for name in ['agent', 'compositor-health']:
+            self.assertIn('  usr/local/lib/try-omarchy/' + name, finalizer)
+        self.assertTrue(HELPER.stat().st_mode & 0o111)
+        agent = (HELPER.parent / 'agent').read_text()
+        self.assertIn('health_pid=$!', agent)
+        self.assertIn('kill "$health_pid"', agent)
