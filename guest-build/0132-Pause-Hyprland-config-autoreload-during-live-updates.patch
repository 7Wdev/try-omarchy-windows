diff --git a/guest/tests/test_live_update.py b/guest/tests/test_live_update.py
new file mode 100644
index 0000000..c8bb26b
--- /dev/null
+++ b/guest/tests/test_live_update.py
@@ -0,0 +1,188 @@
+import importlib.machinery
+import importlib.util
+import contextlib
+import io
+import subprocess
+import sys
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+GUEST = Path(__file__).resolve().parents[1]
+HELPER = GUEST / 'factory-overlay/usr/local/lib/try-omarchy/live-update'
+loader = importlib.machinery.SourceFileLoader('live_update', str(HELPER))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+live = importlib.util.module_from_spec(spec)
+loader.exec_module(live)
+
+
+class LiveUpdateTests(unittest.TestCase):
+    def test_restores_each_instances_previous_value_after_reload(self):
+        saved = [['alice', '/run/user/1000', 'one', 0],
+                 ['alice', '/run/user/1000', 'two', 1],
+                 ['bob', '/run/user/1001', 'three', 0]]
+        with patch.object(Path, 'exists', return_value=True), patch.object(live, 'set_option') as setting, patch.object(live, 'ipc') as ipc:
+            live.restore(saved)
+        self.assertEqual(ipc.call_args_list, [unittest.mock.call(session, 'reload') for session in saved])
+        self.assertEqual(setting.call_args_list, [unittest.mock.call(session, session[3]) for session in saved])
+
+    def test_reload_failure_still_restores_and_continues_other_sessions(self):
+        saved = [['alice', '/run/user/1000', 'one', 0], ['bob', '/run/user/1001', 'two', 1]]
+        with patch.object(Path, 'exists', return_value=True), patch.object(live, 'set_option') as setting, patch.object(live, 'ipc', side_effect=[RuntimeError('failed'), None]) as ipc:
+            with self.assertRaisesRegex(RuntimeError, 'failed'):
+                live.restore(saved)
+        self.assertEqual(ipc.call_count, 2)
+        self.assertEqual(setting.call_args_list, [unittest.mock.call(session, session[3]) for session in saved])
+
+    def test_partial_setup_failure_restores(self):
+        saved = [['alice', '/run/user/1000', 'one', 0], ['alice', '/run/user/1000', 'two', 1]]
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            with patch.object(live, 'sessions', return_value=saved), patch.object(live, 'set_option', side_effect=[None, RuntimeError('IPC failed')]), patch.object(live, 'restore') as restore:
+                live.watch(1, 'start', state)
+            restore.assert_called_once_with(saved)
+            self.assertFalse((state / 'ready').exists())
+            self.assertTrue((state / 'done').exists())
+            self.assertIn('IPC failed', (state / 'error').read_text())
+
+    def test_transaction_death_restores_without_post_hook(self):
+        saved = [['alice', '/run/user/1000', 'one', 0]]
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            with patch.object(live, 'sessions', return_value=saved), patch.object(live, 'set_option'), patch.object(live, 'alive', return_value=False), patch.object(live, 'restore') as restore:
+                live.watch(999, 'start', state)
+            restore.assert_called_once_with(saved)
+            self.assertTrue((state / 'ready').exists())
+            self.assertTrue((state / 'done').exists())
+
+    def test_pid_reuse_and_zombie_do_not_hold_autoreload(self):
+        with patch.object(live, 'process', return_value=(1, 'new', 'S')):
+            self.assertFalse(live.alive(99, 'old'))
+        with patch.object(live, 'process', return_value=(1, 'old', 'Z')):
+            self.assertFalse(live.alive(99, 'old'))
+
+    def test_apply_is_verified_before_extraction(self):
+        with patch.object(live, 'ipc', side_effect=['ok', '{"bool":false}']):
+            with self.assertRaisesRegex(RuntimeError, 'did not apply'):
+                live.set_option(['alice', '/run/user/1000', 'one'], True)
+
+    def test_headless_transaction_needs_no_guardian(self):
+        with patch.object(live, 'transaction', return_value=(99, 'start')), patch.object(live, 'sessions', return_value=[]), patch.object(live, 'run') as run, patch.object(live.sys, 'argv', ['helper', 'pre']):
+            live.main()
+        run.assert_not_called()
+
+    def test_pre_discovery_and_service_failures_succeed_without_changing_options(self):
+        saved = [['alice', '/run/user/1000', 'one', False]]
+        for failure in ['hyprctl unavailable', 'unexpected Hyprland autoreload value', 'systemd-run failed']:
+            with self.subTest(failure=failure), tempfile.TemporaryDirectory() as directory:
+                discovery = patch.object(live, 'sessions', return_value=saved) if failure == 'systemd-run failed' else patch.object(live, 'sessions', side_effect=RuntimeError(failure))
+                output = io.StringIO()
+                with patch.object(live, 'STATE', Path(directory)), patch.object(live, 'transaction', return_value=(99, 'start')), discovery, patch.object(live, 'run', side_effect=RuntimeError(failure)), patch.object(live, 'set_option') as setting, patch.object(live.sys, 'argv', ['helper', 'pre']), contextlib.redirect_stderr(output):
+                    self.assertEqual(live.cli(), 0)
+                setting.assert_not_called()
+                self.assertIn(failure, output.getvalue())
+                self.assertIn('package update will continue', output.getvalue())
+
+    def test_pre_setup_mismatch_succeeds_after_restoring_all_previous_values(self):
+        for previous in [False, True]:
+            with self.subTest(previous=previous), tempfile.TemporaryDirectory() as directory:
+                saved = [['alice', directory, 'one', previous], ['alice', directory, 'two', not previous]]
+                values = dict(one=previous, two=not previous)
+                for session in saved:
+                    socket = Path(directory) / 'hypr' / session[2] / '.socket.sock'
+                    socket.parent.mkdir(parents=True)
+                    socket.touch()
+
+                def ipc(session, *args):
+                    name = session[2]
+                    if args[0] == 'reload':
+                        values[name] = False
+                        return 'ok'
+                    if args[0] == 'eval':
+                        values[name] = 'true' in args[1]
+                        return 'ok'
+                    if name == 'two' and not (state / 'error').exists():
+                        return '{"bool": false}'  # Verification fails after pausing.
+                    return '{"bool": ' + str(values[name]).lower() + '}'
+
+                state = Path(directory) / '99-start'
+                output = io.StringIO()
+                with patch.object(live, 'STATE', Path(directory)), patch.object(live, 'transaction', return_value=(99, 'start')), patch.object(live, 'sessions', return_value=saved), patch.object(live, 'ipc', side_effect=ipc), patch.object(live, 'run', side_effect=lambda *_: live.watch(99, 'start', state)), patch.object(live.sys, 'argv', ['helper', 'pre']), contextlib.redirect_stderr(output):
+                    self.assertEqual(live.cli(), 0)
+                self.assertEqual(values, dict(one=previous, two=not previous))
+                self.assertTrue((state / 'finish').exists())
+                self.assertTrue((state / 'done').exists())
+                self.assertIn('did not apply', output.getvalue())
+
+    def test_pre_timeout_finishes_guardian_and_restores_before_succeeding(self):
+        for previous in [False, True]:
+            with self.subTest(previous=previous), tempfile.TemporaryDirectory() as directory:
+                state = Path(directory) / '99-start'
+                values = [previous]
+                calls = []
+
+                def launch(*_):
+                    values[0] = True
+
+                def wait(state, marker, seconds=5):
+                    calls.append((marker, seconds))
+                    if marker == 'ready':
+                        raise RuntimeError('timed out waiting for autoreload guardian ready')
+                    self.assertTrue((state / 'finish').exists())
+                    values[0] = previous
+                    (state / 'done').touch()
+
+                output = io.StringIO()
+                with patch.object(live, 'STATE', Path(directory)), patch.object(live, 'transaction', return_value=(99, 'start')), patch.object(live, 'sessions', return_value=[['alice', directory, 'one', previous]]), patch.object(live, 'run', side_effect=launch), patch.object(live, 'wait', side_effect=wait), patch.object(live.sys, 'argv', ['helper', 'pre']), contextlib.redirect_stderr(output):
+                    self.assertEqual(live.cli(), 0)
+                self.assertEqual(values, [previous])
+                self.assertEqual(calls, [('ready', 5), ('done', 30)])
+                self.assertIn('timed out', output.getvalue())
+
+    def test_finished_setup_does_not_pause_another_session(self):
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            (state / 'finish').touch()
+            with patch.object(live, 'sessions', return_value=[['alice', directory, 'one', False]]), patch.object(live, 'set_option') as setting:
+                live.watch(99, 'start', state)
+            setting.assert_not_called()
+            self.assertTrue((state / 'done').exists())
+
+    def test_cleanup_waits_for_done_even_when_setup_error_is_already_recorded(self):
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            (state / 'error').write_text('setup failed')
+            with patch.object(live.time, 'sleep', side_effect=lambda _: (state / 'done').touch()):
+                live.wait(state, 'done')
+
+    def test_post_failure_succeeds_and_reports_restore_error(self):
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory) / '99-start'
+            state.mkdir()
+            (state / 'done').touch()
+            (state / 'error').write_text('restore IPC failed')
+            output = io.StringIO()
+            with patch.object(live, 'STATE', Path(directory)), patch.object(live, 'transaction', return_value=(99, 'start')), patch.object(live.sys, 'argv', ['helper', 'post']), contextlib.redirect_stderr(output):
+                self.assertEqual(live.cli(), 0)
+            self.assertTrue((state / 'finish').exists())
+            self.assertIn('restore IPC failed', output.getvalue())
+
+    def test_hook_process_failures_exit_zero(self):
+        for action in ['pre', 'post']:
+            result = subprocess.run([sys.executable, '-I', str(HELPER), action], capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertIn('not running from a pacman transaction', result.stderr)
+
+    def test_delivery_and_best_effort_hook(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        self.assertIn('compat_revision=54', finalizer)
