diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/live-update b/guest/factory-overlay/usr/local/lib/try-omarchy/live-update
new file mode 100755
index 0000000..539d7e5
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/live-update
@@ -0,0 +1,173 @@
+#!/usr/bin/python3 -I
+"""Keep every running Hyprland config intact across pacman extraction."""
+
+import json
+import os
+from pathlib import Path
+import pwd
+import signal
+import subprocess
+import sys
+import time
+
+STATE = Path('/run/try-omarchy/live-update')
+OPTION = 'misc:disable_autoreload'
+
+
+def process(pid):
+    # Start time prevents a reused PID from extending the transaction's lifetime.
+    fields = Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()
+    return int(fields[1]), fields[19], fields[0]
+
+
+def transaction():
+    pid = os.getppid()
+    while pid > 1:
+        parent, started, _ = process(pid)
+        if Path(f'/proc/{pid}/comm').read_text().strip() == 'pacman':
+            return pid, started
+        pid = parent
+    raise RuntimeError('not running from a pacman transaction')
+
+
+def alive(pid, started):
+    try:
+        _, current, status = process(pid)
+        return current == started and status != 'Z'
+    except FileNotFoundError:
+        return False
+
+
+def run(*args):
+    return subprocess.run(args, check=True, capture_output=True, text=True,
+                          timeout=10).stdout.strip()
+
+
+def ipc(session, *args):
+    user, runtime, instance = session[:3]
+    return run('/usr/bin/runuser', '-u', user, '--', '/usr/bin/env',
+               f'XDG_RUNTIME_DIR={runtime}', '/usr/bin/hyprctl',
+               '--instance', instance, *args)
+
+
+def set_option(session, value):
+    literal = str(bool(value)).lower()
+    ipc(session, 'eval', 'hl.config({ misc = { disable_autoreload = ' + literal + ' } })')
+    if json.loads(ipc(session, '-j', 'getoption', OPTION))['bool'] != bool(value):
+        raise RuntimeError('Hyprland did not apply the autoreload setting')
+
+
+def sessions():
+    result = []
+    for runtime in sorted(Path('/run/user').glob('[0-9]*')):
+        if not (runtime / 'hypr').is_dir():
+            continue
+        user = pwd.getpwuid(int(runtime.name)).pw_name
+        instances = json.loads(run('/usr/bin/runuser', '-u', user, '--',
+                                   '/usr/bin/env', f'XDG_RUNTIME_DIR={runtime}',
+                                   '/usr/bin/hyprctl', '-j', 'instances'))
+        for instance in instances:
+            session = [user, str(runtime), instance['instance']]
+            value = json.loads(ipc(session, '-j', 'getoption', OPTION))['bool']
+            if not isinstance(value, bool):
+                raise RuntimeError('unexpected Hyprland autoreload value')
+            result.append([*session, value])
+    return result
+
+
+def restore(saved):
+    errors = []
+    for session in saved:
+        # A session closed during the update has no runtime value to restore.
+        if not (Path(session[1]) / 'hypr' / session[2] / '.socket.sock').exists():
+            continue
+        try:
+            # Reload resets dynamic options to config defaults. Restore the
+            # captured value afterwards, including a user's deliberate true.
+            try:
+                ipc(session, 'reload')
+            finally:
+                set_option(session, session[3])
+        except Exception as error:
+            errors.append(str(error))
+    if errors:
+        raise RuntimeError('; '.join(errors))
+
+
+def watch(pid, started, state):
+    saved = []
+    stopped = False
+
+    def stop(*_):
+        nonlocal stopped
+        stopped = True
+
+    signal.signal(signal.SIGTERM, stop)
+    signal.signal(signal.SIGINT, stop)
+    try:
+        for session in sessions():
+            # Save before changing it, so partial setup failures also restore.
+            saved.append(session)
+            set_option(session, True)
+        (state / 'ready').touch()
+        while not stopped and alive(pid, started) and not (state / 'finish').exists():
+            time.sleep(.1)
+    except Exception as error:
+        (state / 'error').write_text(str(error))
+    finally:
+        try:
+            restore(saved)
+        except Exception as error:
+            (state / 'error').write_text(str(error))
+        (state / 'done').touch()
+
+
+def wait(state, marker):
+    deadline = time.monotonic() + 30
+    while time.monotonic() < deadline:
+        if (state / 'error').exists():
+            raise RuntimeError((state / 'error').read_text())
+        if (state / marker).exists():
+            return
+        if (state / 'done').exists():
+            raise RuntimeError('autoreload guardian exited before setup')
+        time.sleep(.05)
+    raise RuntimeError(f'timed out waiting for autoreload guardian {marker}')
+
+
+def main():
+    if sys.argv[1] == 'watch':
+        watch(int(sys.argv[2]), sys.argv[3], Path(sys.argv[4]))
+        return
+    pid, started = transaction()
+    state = STATE / f'{pid}-{started}'
+    if sys.argv[1] == 'pre':
+        # Headless installation/build transactions need no compositor or systemd.
+        if not sessions():
+            return
+        state.mkdir(parents=True, mode=0o700)
+        try:
+            # Outside pacman's process group: killing the updater or pacman
+            # cannot kill the cleanup worker along with the transaction.
+            run('/usr/bin/systemd-run', '--quiet', '--collect',
+                '--service-type=exec', f'--unit=try-omarchy-live-update-{pid}-{started}',
+                '/usr/bin/python3', '-I', str(Path(__file__).resolve()),
+                'watch', str(pid), started, str(state))
+            wait(state, 'ready')
+        except Exception:
+            (state / 'finish').touch()
+            raise
+    elif sys.argv[1] == 'post':
+        if state.is_dir():
+            (state / 'finish').touch()
+            wait(state, 'done')
+    else:
+        raise RuntimeError('expected pre, post or watch')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception as error:
+        print(f'Try Omarchy live update: {error}', file=sys.stderr)
+        sys.exit(1)
