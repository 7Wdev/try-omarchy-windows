diff --git a/guest/tests/test_live_update.py b/guest/tests/test_live_update.py
new file mode 100644
index 0000000..24a5e6b
--- /dev/null
+++ b/guest/tests/test_live_update.py
@@ -0,0 +1,82 @@
+import importlib.machinery
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+GUEST = Path(__file__).resolve().parents[1]
+HELPER = GUEST / 'factory-overlay/usr/local/lib/try-omarchy/live-update'
+loader = importlib.machinery.SourceFileLoader('live_update', str(HELPER))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+live = importlib.util.module_from_spec(spec)
+loader.exec_module(live)
+
+
+class LiveUpdateTests(unittest.TestCase):
+    def test_restores_each_instances_previous_value_after_reload(self):
+        saved = [['alice', '/run/user/1000', 'one', 0],
+                 ['alice', '/run/user/1000', 'two', 1],
+                 ['bob', '/run/user/1001', 'three', 0]]
+        with patch.object(Path, 'exists', return_value=True), patch.object(live, 'set_option') as setting, patch.object(live, 'ipc') as ipc:
+            live.restore(saved)
+        self.assertEqual(ipc.call_args_list, [unittest.mock.call(session, 'reload') for session in saved])
+        self.assertEqual(setting.call_args_list, [unittest.mock.call(session, session[3]) for session in saved])
+
+    def test_reload_failure_still_restores_and_continues_other_sessions(self):
+        saved = [['alice', '/run/user/1000', 'one', 0], ['bob', '/run/user/1001', 'two', 1]]
+        with patch.object(Path, 'exists', return_value=True), patch.object(live, 'set_option') as setting, patch.object(live, 'ipc', side_effect=[RuntimeError('failed'), None]) as ipc:
+            with self.assertRaisesRegex(RuntimeError, 'failed'):
+                live.restore(saved)
+        self.assertEqual(ipc.call_count, 2)
+        self.assertEqual(setting.call_args_list, [unittest.mock.call(session, session[3]) for session in saved])
+
+    def test_partial_setup_failure_restores_before_aborting(self):
+        saved = [['alice', '/run/user/1000', 'one', 0], ['alice', '/run/user/1000', 'two', 1]]
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            with patch.object(live, 'sessions', return_value=saved), patch.object(live, 'set_option', side_effect=[None, RuntimeError('IPC failed')]), patch.object(live, 'restore') as restore:
+                live.watch(1, 'start', state)
+            restore.assert_called_once_with(saved)
+            self.assertFalse((state / 'ready').exists())
+            self.assertTrue((state / 'done').exists())
+            self.assertIn('IPC failed', (state / 'error').read_text())
+
+    def test_transaction_death_restores_without_post_hook(self):
+        saved = [['alice', '/run/user/1000', 'one', 0]]
+        with tempfile.TemporaryDirectory() as directory:
+            state = Path(directory)
+            with patch.object(live, 'sessions', return_value=saved), patch.object(live, 'set_option'), patch.object(live, 'alive', return_value=False), patch.object(live, 'restore') as restore:
+                live.watch(999, 'start', state)
+            restore.assert_called_once_with(saved)
+            self.assertTrue((state / 'ready').exists())
+            self.assertTrue((state / 'done').exists())
+
+    def test_pid_reuse_and_zombie_do_not_hold_autoreload(self):
+        with patch.object(live, 'process', return_value=(1, 'new', 'S')):
+            self.assertFalse(live.alive(99, 'old'))
+        with patch.object(live, 'process', return_value=(1, 'old', 'Z')):
+            self.assertFalse(live.alive(99, 'old'))
+
+    def test_apply_is_verified_before_extraction(self):
+        with patch.object(live, 'ipc', side_effect=['ok', '{"bool":false}']):
+            with self.assertRaisesRegex(RuntimeError, 'did not apply'):
+                live.set_option(['alice', '/run/user/1000', 'one'], True)
+
+    def test_headless_transaction_needs_no_guardian(self):
+        with patch.object(live, 'transaction', return_value=(99, 'start')), patch.object(live, 'sessions', return_value=[]), patch.object(live, 'run') as run, patch.object(live.sys, 'argv', ['helper', 'pre']):
+            live.main()
+        run.assert_not_called()
+
+    def test_delivery_and_fail_closed_hook(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        self.assertIn('compat_revision=54', finalizer)
+        for path in ['usr/local/lib/try-omarchy/live-update', 'etc/pacman.d/hooks/00-try-omarchy-live-update.hook', 'etc/pacman.d/hooks/zz-try-omarchy-live-update.hook']:
+            self.assertIn(path, finalizer)
+        pre = (GUEST / 'factory-overlay/etc/pacman.d/hooks/00-try-omarchy-live-update.hook').read_text()
+        self.assertIn('AbortOnFail', pre)
+        self.assertIn('Target = usr/share/omarchy/*', pre)
+
+
+if __name__ == '__main__':
+    unittest.main()
