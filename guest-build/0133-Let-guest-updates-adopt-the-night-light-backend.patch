diff --git a/guest/tests/test_nightlight_upgrade.py b/guest/tests/test_nightlight_upgrade.py
new file mode 100644
index 0000000..fe53a75
--- /dev/null
+++ b/guest/tests/test_nightlight_upgrade.py
@@ -0,0 +1,82 @@
+"""Exercise bounded adoption and failed-transaction recovery without host writes."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+HANDLER = GUEST / 'factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-update-system-pkgs-when-conflicted'
+
+
+class NightlightUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.bin = self.root / 'bin'
+        self.bin.mkdir()
+        # Relocate the two absolute guest paths in a disposable copy of the
+        # actual handler. Its parser, ownership check, move/retry and EXIT trap
+        # still run; no guest or host system files are touched by this test.
+        self.handler = self.root / 'handler'
+        self.handler.write_text(HANDLER.read_text().replace('/usr/local/', f'{self.root}/usr/local/'))
+        self.paths = [self.root / 'usr/local/bin/omarchy-native-nightlight',
+                      self.root / 'usr/local/share/try-omarchy/nightlight.frag']
+        for path in self.paths:
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text('catch-up bytes\n')
+        self.fake('sudo', 'exec "$@"')
+        self.fake('pacman', '[[ $2 == "${OWNED_PATH:-}" ]]')
+        self.fake('omarchy-update-system-pkgs', '''touch "$RETRY_MARKER"
+[[ ${FAIL_RETRY:-0} == 0 ]] || exit 1
+printf 'packaged bytes\\n' > "$HELPER"
+printf 'packaged bytes\\n' > "$SHADER"''')
+        self.report = self.root / 'errors'
+        self.replaced = self.root / 'replaced'
+        self.marker = self.root / 'retried'
+        self.env = dict(os.environ, PATH=f'{self.bin}:{os.environ["PATH"]}',
+                        OMARCHY_UPDATE_CONFLICT='1', OMARCHY_REPLACED_DIR=str(self.replaced),
+                        RETRY_MARKER=str(self.marker), HELPER=str(self.paths[0]), SHADER=str(self.paths[1]))
+
+    def fake(self, name, body):
+        command = self.bin / name
+        command.write_text('#!/bin/bash\nset -e\n' + body + '\n')
+        command.chmod(0o755)
+
+    def run_handler(self, rows=None, **env):
+        self.report.write_text('\n'.join(rows or [f'try-omarchy-runtime: {p} exists in filesystem' for p in self.paths]) + '\n')
+        return subprocess.run(['bash', str(self.handler), str(self.report)],
+                              env=dict(self.env, **env), capture_output=True, text=True, timeout=5)
+
+    def test_adopts_both_paths_and_retains_previous_bytes(self):
+        result = self.run_handler()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertTrue(self.marker.exists())
+        for path in self.paths:
+            self.assertEqual(path.read_text(), 'packaged bytes\n')
+            self.assertEqual((self.replaced / str(path).lstrip('/')).read_text(), 'catch-up bytes\n')
+
+    def test_failed_retry_restores_both_paths(self):
+        result = self.run_handler(FAIL_RETRY='1')
+        self.assertNotEqual(result.returncode, 0)
+        self.assertTrue(self.marker.exists())
+        for path in self.paths:
+            self.assertEqual(path.read_text(), 'catch-up bytes\n')
+
+    def test_unrelated_conflict_blocks_all_moves(self):
+        rows = [f'try-omarchy-runtime: {p} exists in filesystem' for p in self.paths]
+        for extra in [f'try-omarchy-runtime: {self.paths[0]}.custom exists in filesystem',
+                      f'other-package: {self.paths[0]} exists in filesystem',
+                      f'try-omarchy-runtime: {str(self.paths[1]).replace(".frag", "Xfrag")} exists in filesystem',
+                      f'try-omarchy-runtime: {self.paths[0]} exists in filesystem (owned by other-package)']:
+            result = self.run_handler(rows + [extra])
+            self.assertNotEqual(result.returncode, 0)
+            self.assertFalse(self.marker.exists())
+            self.assertFalse(self.replaced.exists())
+
+    def test_live_owner_blocks_adoption(self):
+        result = self.run_handler(OWNED_PATH=str(self.paths[0]))
+        self.assertNotEqual(result.returncode, 0)
+        self.assertFalse(self.marker.exists())
+        self.assertFalse(self.replaced.exists())
