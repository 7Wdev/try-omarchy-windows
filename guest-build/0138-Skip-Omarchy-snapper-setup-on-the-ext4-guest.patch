diff --git a/guest/tests/test_snapper_guest.py b/guest/tests/test_snapper_guest.py
new file mode 100644
index 0000000..8956301
--- /dev/null
+++ b/guest/tests/test_snapper_guest.py
@@ -0,0 +1,48 @@
+"""Snapper setup must be inert on the launcher's ext4 guest disk."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+SETUP = GUEST / 'fragments/snapper-guest.sh'
+TARGET = 'usr/share/omarchy/install/config/snapper.sh'
+
+
+class GuestSnapperTests(unittest.TestCase):
+    def test_setup_and_repeated_setup_leave_snapshot_tools_untouched(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            calls = root / 'calls'
+            for name in ('snapper', 'systemctl', 'mkdir', 'install'):
+                tool = root / name
+                tool.write_text('#!/bin/bash\necho "$0 $*" >> "$CALLS"\nexit 99\n')
+                tool.chmod(0o755)
+            env = dict(os.environ, PATH=f'{root}:' + os.environ['PATH'], CALLS=str(calls), BASH_ENV='/dev/null')
+            for _ in range(2):
+                result = subprocess.run(['bash', '-euo', 'pipefail', str(SETUP)],
+                                        env=env, text=True, capture_output=True)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertIn('ext4', result.stdout)
+            self.assertFalse(calls.exists())
+
+    def test_sourcing_setup_continues_and_does_not_mask_later_failure(self):
+        for suffix, expected in (('echo continued', 0), ('false', 1)):
+            result = subprocess.run(['bash', '-euo', 'pipefail', '-c',
+                                     'source "$1"; ' + suffix, 'test', str(SETUP)],
+                                    env=dict(os.environ, BASH_ENV='/dev/null'), text=True, capture_output=True)
+            self.assertEqual(result.returncode, expected, result.stderr)
+            if expected == 0:
+                self.assertIn('continued', result.stdout)
+
+    def test_factory_runtime_and_compatibility_delivery_use_same_setup(self):
+        materialize = (GUEST / 'scripts/materialize-omarchy.sh').read_text()
+        self.assertIn('install_file 0644 "$guest_dir/fragments/snapper-guest.sh" "$snapper_config"', materialize)
+        self.assertIn('[[ -f $snapper_config ]] || fail', materialize)
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        paths = finalizer.split('compat_paths=(', 1)[1].split(')', 1)[0]
+        self.assertIn(TARGET, paths)
+        self.assertIn('compat_revision=57', finalizer)
+        self.assertEqual(json.loads((GUEST / 'spec.json').read_text())['upstream']['packageRelease'], 8)
