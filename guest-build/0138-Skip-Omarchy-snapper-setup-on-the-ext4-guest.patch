diff --git a/guest/fragments/snapper-guest.sh b/guest/fragments/snapper-guest.sh
new file mode 100644
index 0000000..08ffed7
--- /dev/null
+++ b/guest/fragments/snapper-guest.sh
@@ -0,0 +1,4 @@
+# Try Omarchy boots an ext4 disk with the launcher-supplied kernel. It has no
+# Snapper snapshots or Limine bootloader. This file is also sourced by setup
+# commands, so finish normally instead of exiting their shell.
+echo "Skip Snapper setup on the Try Omarchy ext4 guest"
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 103f989..d3c5580 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -73,6 +73,7 @@ version = subprocess.check_output(["pacman", "-Q", "try-omarchy-runtime"], text=
 UPDATE_MANIFEST
 
 compat_paths=(
+  usr/share/omarchy/install/config/snapper.sh
   usr/local/lib/try-omarchy/live-update
   etc/pacman.d/hooks/00-try-omarchy-live-update.hook
   etc/pacman.d/hooks/zz-try-omarchy-live-update.hook
@@ -241,7 +242,7 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 54 pauses config autoreload during live package updates.
 # Revision 55 lets pacman adopt the catch-up night-light backend on update.
 # Revision 56 retries the startup audio catalog until PipeWire is ready.
-compat_revision=56
+compat_revision=57
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
diff --git a/guest/scripts/materialize-omarchy.sh b/guest/scripts/materialize-omarchy.sh
index 4d2a2d8..66f1c82 100755
--- a/guest/scripts/materialize-omarchy.sh
+++ b/guest/scripts/materialize-omarchy.sh
@@ -122,7 +122,7 @@ rm -rf "$omarchy_root"
 mkdir -p "$omarchy_root/bin" "$omarchy_root/themes"
 
 # Match the upstream package's runtime layout. Every copied byte comes from the
-# pinned Basecamp repository, except the one migration replaced below; the
+# pinned Basecamp repository, except the guest system setup steps below; the
 # web-only profile is applied later in /etc/skel.
 for tree in config default install migrations shell applications; do
   copy_tree "$source_dir/$tree" "$omarchy_root/$tree"
@@ -139,6 +139,13 @@ cat >"$kernel_migration" <<'MIGRATION'
 echo "Keep the kernel the Try Omarchy launcher supplies; this guest has no bootloader"
 MIGRATION
 
+# The guest disk is ext4 and has neither Snapper nor a Limine bootloader.
+# Keep the upstream migration runner intact, but make this bare-metal setup
+# step inert, including when a future migration or setup command sources it.
+snapper_config="$omarchy_root/install/config/snapper.sh"
+[[ -f $snapper_config ]] || fail "Omarchy's Snapper setup moved; review it before skipping: $snapper_config"
+install_file 0644 "$guest_dir/fragments/snapper-guest.sh" "$snapper_config"
+
 while IFS= read -r theme; do
   [[ -n $theme ]] || continue
   copy_tree "$source_dir/themes/$theme" "$omarchy_root/themes/$theme"
