diff --git a/guest/tests/test_clipboard_pull.py b/guest/tests/test_clipboard_pull.py
new file mode 100644
index 0000000..277b2fa
--- /dev/null
+++ b/guest/tests/test_clipboard_pull.py
@@ -0,0 +1,74 @@
+"""Exercise host frames through the bridge's receive loop without a desktop."""
+import base64
+import os
+from pathlib import Path
+import subprocess
+import signal
+import tempfile
+import time
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+BRIDGE = GUEST / 'factory-overlay/usr/local/bin/clipboard-bridge'
+
+
+class ClipboardPullTests(unittest.TestCase):
+    def run_frame(self, payload, prefix=b'', ending=b'\n', deliver=None):
+        # Run the production loop, with a finite transport and clipboard stub.
+        source = BRIDGE.read_text()
+        start = source.index('      file-transfer clipboard-pull')
+        end = source.index('\n      sleep 2', start)
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            frame = root / 'frame'
+            frame.write_bytes(prefix + base64.b64encode(payload) + ending)
+            capture = root / 'copied'
+            for name, body in (
+                ('file-transfer', 'cat "$FRAME"'),
+                ('wl-copy', 'printf "%s\\n" "$*" > "$CAPTURE.args"; cat > "$CAPTURE"'),
+                ('deliver', 'printf "%s\\n" "$*" > "$CAPTURE.args"; cat > "$CAPTURE"'),
+            ):
+                tool = root / name
+                tool.write_text('#!/bin/sh\n' + body + '\n')
+                tool.chmod(0o755)
+            env = dict(os.environ, PATH=f'{root}:' + os.environ['PATH'],
+                       XDG_RUNTIME_DIR=str(root), STATE=str(root),
+                       FRAME=str(frame), CAPTURE=str(capture), BASH_ENV='/dev/null')
+            started = time.monotonic()
+            process = subprocess.Popen(['bash', '-c', source[start:end],
+                                        str(BRIDGE if deliver is None else root / 'deliver')],
+                                       env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                       start_new_session=True)
+            try:
+                stdout, stderr = process.communicate(timeout=5)
+            except subprocess.TimeoutExpired:
+                os.killpg(process.pid, signal.SIGKILL)
+                process.communicate()
+                self.fail('clipboard frame did not complete within 5 seconds')
+            elapsed = time.monotonic() - started
+            self.assertEqual(process.returncode, 0, stderr)
+            self.assertEqual(capture.read_bytes(), payload)
+            return Path(str(capture) + '.args').read_text().strip(), elapsed
+
+    def test_multi_megabyte_png_frame_decodes_exactly_with_lf_and_crlf(self):
+        png = b'\x89PNG\r\n\x1a\n' + bytes(range(256)) * 11836
+        for ending in (b'\n', b'\r\n'):
+            with self.subTest(ending=ending):
+                args, elapsed = self.run_frame(png, b'png:', ending)
+                self.assertEqual(args, '--type image/png')
+                self.assertLess(elapsed, 5)
+
+    def test_frame_prefixes_and_text_preserve_decoded_content(self):
+        for prefix, receive in ((b'', '--receive'), (b'png:', '--receive-image'),
+                                (b'files:', '--receive-files'),
+                                (b'transfer:', '--receive-transfer'), (b'drop:', '--receive-drop')):
+            for ending in (b'\n', b'\r\n'):
+                with self.subTest(prefix=prefix, ending=ending):
+                    args, _ = self.run_frame('こんにちは\n\n'.encode(), prefix, ending, deliver=True)
+                    self.assertEqual(args, receive)
+
+    def test_compatibility_overlay_delivers_the_bridge_to_existing_disks(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        paths = finalizer.split('compat_paths=(', 1)[1].split(')', 1)[0]
+        self.assertIn('usr/local/bin/clipboard-bridge', paths)
+        self.assertIn('compat_revision=58', finalizer)
