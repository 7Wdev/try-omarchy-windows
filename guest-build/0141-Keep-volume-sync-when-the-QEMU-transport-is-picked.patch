index 203104d..d2c48eb 100755
--- a/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
+++ b/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
@@ -103,6 +103,7 @@ class PipeWireMirror:
         self.pending: dict[str, tuple[str | None, float]] = {}
         self.transport_volume: tuple[str, list[int]] | None = None
         self.transport_name: str | None = None
+        self.transport_source_name: str | None = None
         self.transport_owned = False
         self.transport_pending = False
         self.rebuild_volume: list[int] | None = None
@@ -125,6 +126,7 @@ class PipeWireMirror:
         self._unload_modules()
         self.transport_volume = None
         self.transport_name = None
+        self.transport_source_name = None
         self.transport_owned = False
         self.transport_pending = False
         self.rebuild_volume = None
@@ -270,18 +272,28 @@ class PipeWireMirror:
             self.volume_sync.poll()
 
     def _capture_local_changes(self) -> None:
-        for direction, command, mapping in (
-            ("output", "get-default-sink", self.output_uids),
-            ("input", "get-default-source", self.input_uids),
+        for direction, command, mapping, transport in (
+            ("output", "get-default-sink", self.output_uids, self.transport_name),
+            ("input", "get-default-source", self.input_uids, self.transport_source_name),
         ):
             current = run_pactl(command, check=False).strip()
-            if current not in mapping:
+            if current in mapping:
+                uid = mapping[current]
+                if self.last_sent[direction] != uid:
+                    self.last_sent[direction] = uid
+                    self.pending[direction] = (uid, time.monotonic())
+                    self.send({"type": "select", "direction": direction, "deviceUID": uid})
                 continue
-            uid = mapping[current]
-            if self.last_sent[direction] != uid:
-                self.last_sent[direction] = uid
-                self.pending[direction] = (uid, time.monotonic())
-                self.send({"type": "select", "direction": direction, "deviceUID": uid})
+            # Omarchy's audio panel lists the raw QEMU transport alongside the
+            # Windows endpoints. Picking it stops volume sync, so while the
+            # mirror is active put the default back on the Windows device that
+            # is currently selected. Other devices (USB, Bluetooth) are left
+            # alone.
+            if (transport is None or current != transport or not mapping
+                    or self.catalog is None or self.last_sent[direction] not in mapping.values()):
+                continue
+            self._set_selected(direction, self.last_sent[direction])
+            log(f"the {direction} default returned to the Windows endpoint after the QEMU transport was selected")
 
     @staticmethod
     def _validated_devices(value: Any) -> list[dict[str, str]]:
@@ -346,6 +358,7 @@ class PipeWireMirror:
         # The visible remap owns guest volume. WirePlumber's transport default
         # otherwise adds a second, hidden gain (normally 40%). Keep mute intact.
         self._prepare_transport_volume(transport_sink)
+        self.transport_source_name = transport_source
 
         output_records = [{"deviceUID": None, "name": "Windows System Default"}, *outputs]
         input_records = [{"deviceUID": None, "name": "Windows System Default"}, *inputs] if inputs else []
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index acf0d4b..97760cb 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -244,7 +244,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 56 retries the startup audio catalog until PipeWire is ready.
 # Revision 57 skips Snapper setup on the ext4 guest.
 # Revision 58 receives large clipboard frames without suffix-pattern stalls.
-compat_revision=58
+# Revision 59 restores the Windows audio default when the QEMU transport is picked.
+compat_revision=59
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
