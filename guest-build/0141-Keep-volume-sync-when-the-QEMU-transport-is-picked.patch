+class TransportDefaultRedirectTests(unittest.TestCase):
+    """Omarchy's panel lists the raw QEMU transport beside the Windows devices."""
+
+    def make_mirror(self) -> tuple[object, PactlStub, list[dict[str, object]]]:
+        sent: list[dict[str, object]] = []
+        pactl = PactlStub()
+        mirror = bridge.PipeWireMirror(sent.append)
+        patcher = mock.patch.object(bridge, "run_pactl", side_effect=pactl)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+        self.addCleanup(mirror.close)
+        return mirror, pactl, sent
+
+    def test_transport_sink_default_returns_to_the_selected_windows_endpoint(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        mirror.apply(catalog_message())  # selected studio-output
+        mirror.last_health_check = float("inf")
+
+        pactl.default_sink = pactl.transport_sink
+        with mock.patch.object(bridge, "log") as log:
+            mirror.poll_selection()
+        self.assertEqual(pactl.default_sink, bridge.endpoint_name("output", "studio-output"))
+        log.assert_called_once()
+
+        # A default that already sits on the Windows endpoint stays put and
+        # does not log again.
+        with mock.patch.object(bridge, "log") as log:
+            mirror.poll_selection()
+        self.assertEqual(pactl.default_sink, bridge.endpoint_name("output", "studio-output"))
+        log.assert_not_called()
+
+    def test_transport_source_default_returns_to_the_selected_windows_endpoint(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        mirror.apply(catalog_message())  # selected laptop-input
+        mirror.last_health_check = float("inf")
+
+        pactl.default_source = pactl.transport_source
+        with mock.patch.object(bridge, "log") as log:
+            mirror.poll_selection()
+        self.assertEqual(pactl.default_source, bridge.endpoint_name("input", "laptop-input"))
+        log.assert_called_once()
+
+    def test_transport_default_returns_to_windows_system_default_when_none_selected(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        message = catalog_message()
+        message["selectedOutputUID"] = None
+        message["selectedInputUID"] = None
+        mirror.apply(message)
+        mirror.last_health_check = float("inf")
+
+        pactl.default_sink = pactl.transport_sink
+        pactl.default_source = pactl.transport_source
+        mirror.poll_selection()
+        self.assertEqual(pactl.default_sink, bridge.endpoint_name("output", None))
+        self.assertEqual(pactl.default_source, bridge.endpoint_name("input", None))
+
+    def test_other_guest_audio_devices_are_left_alone(self) -> None:
+        mirror, pactl, _ = self.make_mirror()
+        mirror.apply(catalog_message())
+        mirror.last_health_check = float("inf")
+
+        pactl.default_sink = "alsa_output.usb-headphones"
+        pactl.default_source = "alsa_input.bluetooth-headset"
+        with mock.patch.object(bridge, "log") as log:
+            mirror.poll_selection()
+        self.assertEqual(pactl.default_sink, "alsa_output.usb-headphones")
+        self.assertEqual(pactl.default_source, "alsa_input.bluetooth-headset")
+        log.assert_not_called()
+
+
