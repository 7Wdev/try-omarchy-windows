+  property string optionsError: ""
+
+  function normalizeOption(o) {
+    if (o && typeof o === "object") {
+      return {
+        value: String(o.value),
+        label: String(o.label !== undefined ? o.label : o.value),
+        description: o.description ? String(o.description) : ""
