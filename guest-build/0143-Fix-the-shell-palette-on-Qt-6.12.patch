+    for (var i = 0; i < src.length; i++) {
+      var n = normalizeOption(src[i])
+      if (!n.value) continue
+      if (seen[n.value]) continue
+      seen[n.value] = true
+      out.push(n)
+    }
+    return out
+  }
+
+  function valueSet() {
+    var set = ({})
+    var arr = arrayFrom(values)
+    for (var i = 0; i < arr.length; i++) set[String(arr[i])] = true
