diff --git a/guest/tests/test_qt612_palette.py b/guest/tests/test_qt612_palette.py
new file mode 100644
index 0000000..c9ddfa2
--- /dev/null
+++ b/guest/tests/test_qt612_palette.py
@@ -0,0 +1,196 @@
+"""Verify the factory palette backport and guarded repair before login."""
+import hashlib
+import importlib.machinery
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / 'factory-overlay'
+PAYLOAD = OVERLAY / 'usr/share/try-omarchy/qt612-palette'
+SCRIPT = OVERLAY / 'usr/local/lib/try-omarchy/install-qt612-palette'
+loader = importlib.machinery.SourceFileLoader('palette_installer', str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+installer = importlib.util.module_from_spec(spec)
+loader.exec_module(installer)
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+class Qt612PaletteTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.hooks = json.loads((PAYLOAD / 'manifest.json').read_text())
+        self.build_spec = json.loads((GUEST / 'spec.json').read_text())
+        self.backport = next(b for b in self.build_spec['authenticity']['backports'] if b['id'] == 'qt612-palette')
+        self.tree = self.root / 'usr/share/omarchy'
+        for hook in self.hooks:
+            target = self.root / hook['path']
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes((PAYLOAD / hook['asset']).read_bytes())
+            target.chmod(0o640)
+        # Recover the exact factory preimage from the shipped fixed bytes. Both
+        # sides must match the independent hashes recorded in the build registry.
+        self.apply_patch(reverse=True)
+
+    def apply_patch(self, reverse=False):
+        args = ['git', 'apply', '--no-index']
+        if reverse:
+            args.append('--reverse')
+        subprocess.run([*args, str(GUEST / self.backport['patch'])], cwd=self.tree,
+                       check=True, capture_output=True)
+
+    def test_factory_backport_qualifies_every_declared_shell_file(self):
+        self.assertEqual(len(self.hooks), 54)
+        targets = {t['path']: t for t in self.backport['targets']}
+        self.assertEqual(set(targets), {h['path'].removeprefix('usr/share/omarchy/') for h in self.hooks})
+        for path, target in targets.items():
+            self.assertEqual(digest((self.tree / path).read_bytes()), target['beforeSha256'], path)
+        self.apply_patch()
+        for path, target in targets.items():
+            data = (self.tree / path).read_bytes()
+            self.assertEqual(digest(data), target['afterSha256'], path)
+            self.assertIn(b'import qs.Commons as Commons\n', data, path)
+            self.assertIn(b'Commons.Color.', data, path)
+            self.assertIsNone(re.search(rb'(?<![\w.])Color\.', data), path)
+        self.assertIn(b'Commons.Color.bar.background', (self.tree / 'shell/plugins/bar/Bar.qml').read_bytes())
+        self.assertIn(b'Commons.Color.menu.background', (self.tree / 'shell/plugins/menu/Menu.qml').read_bytes())
+        self.assertIn(b'Commons.Color.loadShell', (self.tree / 'shell/shell.qml').read_bytes())
+
+    def test_repair_preimages_cover_the_existing_backport_chain(self):
+        accepted = {
+            h['path'].removeprefix('usr/share/omarchy/'): {
+                digest for v in [h, *h.get('previousVersions', [])] for digest in v['beforeSha256']
+            } for h in self.hooks
+        }
+        for backport in self.build_spec['authenticity']['backports']:
+            if backport['id'] == 'qt612-palette':
+                continue
+            for target in backport['targets']:
+                if target['path'] in accepted:
+                    for key in ['beforeSha256', 'afterSha256']:
+                        self.assertIn(target[key], accepted[target['path']], (backport['id'], key))
+
+    def test_known_old_disk_is_repaired_once_with_metadata_preserved(self):
+        before = {h['path']: (self.root / h['path']).stat() for h in self.hooks}
+        result = subprocess.run([str(SCRIPT), '--root', str(self.root), '--payload', str(PAYLOAD)],
+                                text=True, capture_output=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        for hook in self.hooks:
+            target = self.root / hook['path']
+            self.assertEqual(target.read_bytes(), (PAYLOAD / hook['asset']).read_bytes())
+            self.assertEqual(target.stat().st_mode, before[hook['path']].st_mode)
+            self.assertEqual(target.stat().st_uid, before[hook['path']].st_uid)
+            self.assertEqual(target.stat().st_gid, before[hook['path']].st_gid)
+        times = [(self.root / h['path']).stat().st_mtime_ns for h in self.hooks]
+        installer.install(self.root, PAYLOAD)
+        self.assertEqual(times, [(self.root / h['path']).stat().st_mtime_ns for h in self.hooks])
+
+    def test_each_reviewed_older_version_gets_only_namespace_changes(self):
+        for hook in self.hooks:
+            for version in hook.get('previousVersions', []):
+                fixed = (PAYLOAD / version['asset']).read_bytes()
+                # This is the inverse of the namespace-only upstream change,
+                # not a transplant of newer shell logic onto an older version.
+                old = fixed.replace(b'import qs.Commons as Commons\n', b'').replace(b'Commons.Color.', b'Color.')
+                self.assertIn(digest(old), version['beforeSha256'], version['asset'])
+                target = self.root / hook['path']
+                target.write_bytes(old)
+                installer.install(self.root, PAYLOAD)
+                self.assertEqual(target.read_bytes(), fixed, version['asset'])
+
+    def test_custom_already_fixed_missing_and_linked_files_are_preserved(self):
+        custom, fixed, missing, linked = [self.root / h['path'] for h in self.hooks[:4]]
+        custom.write_text('user edits\n')
+        fixed.write_bytes((PAYLOAD / self.hooks[1]['asset']).read_bytes())
+        fixed_time = fixed.stat().st_mtime_ns
+        missing.unlink()
+        outside = self.root / 'outside'; outside.write_bytes(linked.read_bytes())
+        old = outside.read_bytes()
+        linked.unlink(); linked.symlink_to(outside)
+        installer.install(self.root, PAYLOAD)
+        self.assertEqual(custom.read_text(), 'user edits\n')
+        self.assertEqual(fixed.stat().st_mtime_ns, fixed_time)
+        self.assertFalse(missing.exists())
+        self.assertTrue(linked.is_symlink())
+        self.assertEqual(outside.read_bytes(), old)
+        # An upstream fixed file with different logic is also kept byte for byte.
+        custom.write_text('import qs.Commons as Commons\n// newer upstream\nCommons.Color.background\n')
+        newer = custom.read_bytes()
+        installer.install(self.root, PAYLOAD)
+        self.assertEqual(custom.read_bytes(), newer)
+
+    def test_linked_shell_directory_is_preserved(self):
+        shell = self.tree / 'shell'
+        before = {p.relative_to(shell): p.read_bytes() for p in shell.rglob('*.qml')}
+        shell.rename(self.root / 'redirected'); shell.symlink_to(self.root / 'redirected')
+        installer.install(self.root, PAYLOAD)
+        self.assertEqual(before, {p.relative_to(shell): p.read_bytes() for p in shell.rglob('*.qml')})
+
+    def test_edit_during_repair_is_preserved(self):
+        hook = self.hooks[0]
+        target = self.root / hook['path']
+        with mock.patch.object(installer.os, 'fsync', side_effect=lambda fd: target.write_text('new edit\n')):
+            installer.install_file(self.root, hook, (PAYLOAD / hook['asset']).read_bytes())
+        self.assertEqual(target.read_text(), 'new edit\n')
+
+    def test_corrupt_payload_fails_before_any_file_changes(self):
+        payload = self.root / 'payload'; shutil.copytree(PAYLOAD, payload)
+        (payload / self.hooks[-1]['asset']).write_text('corrupt')
+        before = [(self.root / h['path']).read_bytes() for h in self.hooks]
+        with self.assertRaises(ValueError):
+            installer.install(self.root, payload)
+        self.assertEqual(before, [(self.root / h['path']).read_bytes() for h in self.hooks])
+
+    def test_legacy_qml_payloads_remain_qualified(self):
+        for family in ['guest-qol', 'notifications']:
+            payload = OVERLAY / 'usr/share/try-omarchy' / family
+            for hook in json.loads((payload / 'manifest.json').read_text()):
+                for version in [hook, *hook.get('previousVersions', [])]:
+                    data = (payload / version['asset']).read_bytes()
+                    self.assertEqual(digest(data), version['afterSha256'])
+                    if '.qml' in version['asset']:
+                        self.assertIsNone(re.search(rb'(?<![\w.])Color\.', data), version['asset'])
+
+    def test_compatibility_delivery_runs_after_older_repairs_and_before_login(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        paths = finalizer.split('compat_paths=(', 1)[1].split(')', 1)[0]
+        self.assertIn('compat_revision=60', finalizer)
+        self.assertIn('usr/local/lib/try-omarchy/install-qt612-palette', paths)
+        self.assertIn('usr/share/try-omarchy/qt612-palette', paths)
+        self.assertEqual(self.build_spec['upstream']['packageRelease'], 9)
+        service = (OVERLAY / 'etc/systemd/system/try-omarchy-catch-up.service').read_text()
+        self.assertIn('Before=display-manager.service', service)
+        catch_up = OVERLAY / 'usr/local/lib/try-omarchy/catch-up'
+        text = catch_up.read_text()
+        self.assertLess(text.index('"$notifications_installer"'), text.index('"$palette_installer"'))
+        self.assertLess(text.index('"$qol_installer"'), text.index('"$palette_installer"'))
+        self.assertLess(text.index('"$nightlight_installer"'), text.index('"$palette_installer"'))
+        version = self.root / 'compat-version'; version.write_text('60:test\n')
+        state = self.root / 'state'; state.mkdir()
+        calls = self.root / 'calls'
+        fake = self.root / 'installer'; fake.write_text('#!/bin/bash\necho palette >>"' + str(calls) + '"\n')
+        fake.chmod(0o755)
+        env = dict(os.environ, TRY_OMARCHY_PALETTE_INSTALLER=str(fake),
