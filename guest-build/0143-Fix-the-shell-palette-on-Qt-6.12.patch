+
+  // --------------------------------------------------- image selector IPC
+
+  function imagePickerItem() {
+    var loader = panelLoaders["omarchy.image-picker"]
+    return loader && loader.item ? loader.item : null
+  }
+
+  IpcHandler {
+    target: "image-selector"
+
+    function open(imageDirs: string,
