@@ -0,0 +1,86 @@
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+module_spec = importlib.util.spec_from_file_location('aquamarine_contract', GUEST / 'scripts/aquamarine-contract.py')
+contract = importlib.util.module_from_spec(module_spec)
+module_spec.loader.exec_module(contract)
+
+
+class AquamarineContractTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.base = Path(self.temp.name)
+        for name in ('spec.json', 'packages.lock.json', 'scripts/register-aquamarine.sh', 'patches/aquamarine/cursor-hotspot.patch'):
+            target = self.base / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(GUEST / name, target)
+        self.spec = self.base / 'spec.json'
+
+    def change(self, key, value):
+        payload = json.loads(self.spec.read_text())
+        payload['supplyChain']['aquamarine'][key] = value
+        self.spec.write_text(json.dumps(payload))
+
+    def test_source_and_build_inputs_match_transaction(self):
+        pin = contract.validate(self.spec)
+        self.assertEqual(pin['packageVersion'], pin['archVersion'] + '.1')
+        self.assertEqual(pin['provide'], 'libaquamarine.so=14-64')
+
+    def test_source_version_drift_is_rejected(self):
+        self.change('version', '0.16.0')
+        with self.assertRaisesRegex(ValueError, 'package lock'): contract.validate(self.spec)
+
+    def test_archive_url_and_package_release_drift_are_rejected(self):
+        for key, value in [('url', 'https://example.test/source.tar.gz'), ('packageVersion', '0.15.1-2')]:
+            with self.subTest(key=key):
+                shutil.copyfile(GUEST / 'spec.json', self.spec)
+                self.change(key, value)
+                with self.assertRaises(ValueError): contract.validate(self.spec)
+
+    def test_unreviewed_patch_or_build_flags_are_rejected(self):
+        for name in ('patches/aquamarine/cursor-hotspot.patch', 'scripts/register-aquamarine.sh'):
+            with self.subTest(name=name):
+                path = self.base / name
+                original = path.read_bytes(); path.write_bytes(original + b'changed\n')
+                with self.assertRaisesRegex(ValueError, 'mismatch'): contract.validate(self.spec)
+                path.write_bytes(original)
+
+    def test_soname_and_unlocked_build_tools_are_rejected(self):
+        self.change('provide', 'libaquamarine.so=15-64')
+        with self.assertRaisesRegex(ValueError, 'SONAME'): contract.validate(self.spec)
+        shutil.copyfile(GUEST / 'spec.json', self.spec)
+        lock_path = self.base / 'packages.lock.json'
+        lock = json.loads(lock_path.read_text()); del lock['packages']['hyprwayland-scanner']
+        lock_path.write_text(json.dumps(lock))
+        with self.assertRaisesRegex(ValueError, 'build tools'): contract.validate(self.spec)
+
+    def test_cap_failure_is_optional_and_properties_are_guarded(self):
+        patch = (GUEST / 'patches/aquamarine/cursor-hotspot.patch').read_text()
+        self.assertIn('DRM_CLIENT_CAP_CURSOR_PLANE_HOTSPOT', patch)
+        self.assertIn('EOPNOTSUPP', patch)
+        self.assertNotIn('+        return false', patch)
+        self.assertIn('if (cursor->props.values.hotspot_x && cursor->props.values.hotspot_y)', patch)
+        self.assertIn('data.cursorHotspot.x', patch)
+        self.assertIn('data.cursorHotspot.y', patch)
+
+    def test_delivery_registers_package_before_runtime_and_authenticates_offer(self):
+        build = (GUEST / 'build.sh').read_text()
+        self.assertLess(build.index('scripts/register-aquamarine.sh'), build.index('scripts/register-omarchy-runtime.sh'))
+        runtime = (GUEST / 'scripts/register-omarchy-runtime.sh').read_text()
+        self.assertIn('depend = aquamarine>={version}', runtime)
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        self.assertIn('compat_revision=61', finalizer)
+        self.assertIn('cp /usr/share/try-omarchy/repo/*.pkg.tar.zst', finalizer)
+        self.assertIn('usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua', finalizer)
+        repo = (GUEST / 'scripts/register-local-repository.sh').read_text()
+        self.assertIn('expected_archive_count=${#expected_names[@]}', repo)
+        self.assertIn('print("aquamarine")', repo)
+        # The local stanza is appended, never inserted before signed Arch repos.
+        self.assertIn('cat >>"$root/etc/pacman.conf"', repo)
diff --git a/guest/tests/test_aquamarine_upgrade.py b/guest/tests/test_aquamarine_upgrade.py
new file mode 100644
index 0000000..e30acf0
--- /dev/null
+++ b/guest/tests/test_aquamarine_upgrade.py
@@ -0,0 +1,130 @@
+"""Real libalpm transactions with small repository and ABI fixtures.
+
+Run on Arch builders too; other contract hosts skip only this integration tier.
+"""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tarfile
+import tempfile
+import unittest
+
+
+if os.environ.get('REQUIRE_ALPM_TESTS') == '1' and not (os.geteuid() == 0 and all(shutil.which(x) for x in ('pacman', 'repo-add', 'cc'))):
+    raise RuntimeError('required Arch transaction tools unavailable')
+
+
+@unittest.skipUnless(os.geteuid() == 0 and all(shutil.which(x) for x in ('pacman', 'repo-add', 'cc')), 'requires an Arch builder as root')
+class AquamarineUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.base = Path(self.temp.name)
+        self.root = self.base / 'root'
+        for name in ('var/lib/pacman/local', 'var/lib/pacman/sync', 'var/cache/pacman/pkg', 'var/log', 'tmp'):
+            (self.root / name).mkdir(parents=True, exist_ok=True)
+        self.remote = self.base / 'arch'
+        self.local = self.base / 'try-omarchy'
+        self.remote.mkdir(); self.local.mkdir()
+        self.config = self.base / 'pacman.conf'
+        self.config.write_text(f'''[options]
+Architecture = x86_64
+CacheDir = {self.root}/var/cache/pacman/pkg
+SigLevel = Never
+LocalFileSigLevel = Never
+DisableSandbox
+[arch]
+Server = file://{self.remote}
+[try-omarchy]
+Server = file://{self.local}
+''')
+        self.stock = self.package(self.remote, 'aquamarine', '0.15.1-1', 14)
+        self.patched = self.package(self.local, 'aquamarine', '0.15.1-1.1', 14)
+        self.old_hypr = self.package(self.remote, 'hyprland', '1-1', 14, consumer=True)
+        self.old_runtime = self.package(self.local, 'try-omarchy-runtime', '4.0.4-9')
+        self.package(self.local, 'try-omarchy-runtime', '4.0.4-10', runtime=True)
+        self.install(self.stock, self.old_hypr, self.old_runtime)
+        self.repositories()
+
+    def command(self, *args):
+        result = subprocess.run(args, text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        return result.stdout
+
+    def pacman(self, *args):
+        return self.command('pacman', '--noconfirm', '--config', str(self.config), '--root', str(self.root),
+                            '--dbpath', str(self.root / 'var/lib/pacman'), '--logfile', str(self.root / 'var/log/pacman.log'), *args)
+
+    def install(self, *packages):
+        self.pacman('-U', '--noscriptlet', *(str(p) for p in packages))
+
+    def package(self, repository, name, version, abi=None, consumer=False, runtime=False):
+        stage = self.base / f'{name}-{version}'
+        stage.mkdir()
+        info = [f'pkgname = {name}', f'pkgver = {version}', 'pkgdesc = transaction fixture', 'arch = x86_64', 'size = 1']
+        if consumer:
+            info.append(f'depend = libaquamarine.so={abi}-64')
+            c = stage / 'consumer.c'
+            c.write_text('extern int aq(void); int main(void) { return aq() != 42; }\n')
+            lib = self.base / f'libaquamarine.so.{abi}'
+            self.library(lib, abi)
+            binary = stage / 'usr/bin/hyprland-fixture'; binary.parent.mkdir(parents=True)
+            self.command('cc', str(c), str(lib), '-o', str(binary))
+            c.unlink()
+        elif abi:
+            info.append(f'provides = libaquamarine.so={abi}-64')
+            lib = stage / f'usr/lib/libaquamarine.so.{abi}'; lib.parent.mkdir(parents=True)
+            self.library(lib, abi)
+        if runtime:
+            info.append('depend = aquamarine>=0.15.1-1.1')
+        (stage / '.PKGINFO').write_text('\n'.join(info) + '\n')
+        archive = repository / f'{name}-{version}-x86_64.pkg.tar.gz'
+        with tarfile.open(archive, 'w:gz') as tar:
+            tar.add(stage / '.PKGINFO', arcname='.PKGINFO')
+            if (stage / 'usr').exists(): tar.add(stage / 'usr', arcname='usr')
+        return archive
+
+    def library(self, path, abi):
+        c = self.base / 'library.c'; c.write_text('int aq(void) { return 42; }\n')
+        self.command('cc', '-shared', '-fPIC', f'-Wl,-soname,libaquamarine.so.{abi}', str(c), '-o', str(path))
+
+    def repositories(self):
+        for repository in (self.remote, self.local):
+            # Include only the newest runtime in the offered database.
+            packages = sorted(repository.glob('*.pkg.tar.gz'))
+            packages = [p for p in packages if '-runtime-4.0.4-9-' not in p.name]
+            self.command('repo-add', str(repository / f'{repository.name}.db.tar.gz'), *(str(p) for p in packages))
+        self.pacman('-Syy')
+
+    def assert_version(self, expected, abi=14):
+        self.assertEqual(self.pacman('-Q', 'aquamarine').strip(), f'aquamarine {expected}')
+        self.pacman('-Dk')
+        self.command('env', f'LD_LIBRARY_PATH={self.root}/usr/lib', str(self.root / 'usr/bin/hyprland-fixture'))
+        self.assertTrue((self.root / f'usr/lib/libaquamarine.so.{abi}').exists())
+
+    def test_existing_disk_installs_rebuild_and_unchanged_arch_keeps_it(self):
+        self.pacman('-Su')
+        self.assert_version('0.15.1-1.1')
+        self.pacman('-Su')
+        self.assert_version('0.15.1-1.1')
+
+    def test_new_arch_release_replaces_rebuild(self):
+        self.pacman('-Su'); self.assert_version('0.15.1-1.1')
+        self.package(self.remote, 'aquamarine', '0.15.1-2', 14)
+        self.repositories(); self.pacman('-Su')
+        self.assert_version('0.15.1-2')
+
+    def test_new_soname_and_hyprland_upgrade_together(self):
+        self.pacman('-Su'); self.assert_version('0.15.1-1.1')
+        self.package(self.remote, 'aquamarine', '0.16.0-1', 15)
+        self.package(self.remote, 'hyprland', '2-1', 15, consumer=True)
+        self.repositories(); self.pacman('-Su')
+        self.assert_version('0.16.0-1', 15)
+        self.assertFalse((self.root / 'usr/lib/libaquamarine.so.14').exists())
+
+    def test_old_disk_with_new_arch_skips_obsolete_rebuild(self):
+        self.package(self.remote, 'aquamarine', '0.16.0-1', 15)
+        self.package(self.remote, 'hyprland', '2-1', 15, consumer=True)
+        self.repositories(); self.pacman('-Su')
+        self.assert_version('0.16.0-1', 15)
