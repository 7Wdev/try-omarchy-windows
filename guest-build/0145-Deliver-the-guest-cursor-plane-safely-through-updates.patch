diff --git a/guest/scripts/aquamarine-contract.py b/guest/scripts/aquamarine-contract.py
new file mode 100755
index 0000000..d5daed2
--- /dev/null
+++ b/guest/scripts/aquamarine-contract.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Validate the managed rebuild against the reviewed Arch transaction."""
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+
+
+def validate(spec_path):
+    spec_path = Path(spec_path)
+    spec = json.loads(spec_path.read_text())
+    component = spec['supplyChain']['aquamarine']
+    lock = json.loads((spec_path.parent / spec['inputs']['packageLock']).read_text())['packages']
+    version, arch_version = component['version'], component['archVersion']
+    if not re.fullmatch(r'[0-9]+(?:\.[0-9]+)*', version):
+        raise ValueError('invalid aquamarine source version')
+    if lock.get('aquamarine') != arch_version or not arch_version.startswith(version + '-'):
+        raise ValueError('aquamarine source pin differs from package lock')
+    if component['packageVersion'] != arch_version + '.1':
+        raise ValueError('aquamarine rebuild must use the Arch release plus .1')
+    if component['url'] != f'https://github.com/hyprwm/aquamarine/archive/v{version}/aquamarine-{version}.tar.gz':
+        raise ValueError('aquamarine source URL differs from pin')
+    for key in ('sha256', 'patchSha256', 'builderSha256'):
+        if not re.fullmatch('[0-9a-f]{64}', component[key]):
+            raise ValueError(f'invalid aquamarine {key}')
+    for relative, key in ((component['patch'], 'patchSha256'), ('scripts/register-aquamarine.sh', 'builderSha256')):
+        path = Path(relative)
+        if path.is_absolute() or '..' in path.parts:
+            raise ValueError('unsafe aquamarine input path')
+        if hashlib.sha256((spec_path.parent / path).read_bytes()).hexdigest() != component[key]:
+            raise ValueError(f'aquamarine {key} mismatch')
+    if not re.fullmatch(r'libaquamarine\.so\.[0-9]+', component['soname']):
+        raise ValueError('invalid aquamarine SONAME')
+    if component['provide'] != 'libaquamarine.so=' + component['soname'].rsplit('.', 1)[1] + '-64':
+        raise ValueError('aquamarine SONAME provide differs from pin')
+    if component['buildPackages'] != ['cmake', 'hyprwayland-scanner'] or any(name not in lock for name in component['buildPackages']):
+        raise ValueError('aquamarine build tools are not transaction locked')
+    return component
+
+
+if __name__ == '__main__':
+    try:
+        component = validate(sys.argv[1])
+        for key in ('version', 'archVersion', 'packageVersion', 'url', 'sha256', 'patch', 'soname', 'provide'):
+            print(component[key])
+    except (KeyError, ValueError, OSError) as error:
+        raise SystemExit(str(error))
