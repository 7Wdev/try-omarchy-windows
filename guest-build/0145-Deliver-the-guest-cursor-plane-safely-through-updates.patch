diff --git a/guest/scripts/register-aquamarine.sh b/guest/scripts/register-aquamarine.sh
new file mode 100755
index 0000000..569ce89
--- /dev/null
+++ b/guest/scripts/register-aquamarine.sh
@@ -0,0 +1,111 @@
+#!/bin/bash
+# Managed same-name rebuild. Arch stays ahead of the local repository so a
+# newer Arch package always wins, including a new SONAME required by Hyprland.
+set -euo pipefail
+fail() { echo "register-aquamarine: $*" >&2; exit 1; }
+root= work= spec= pacman_config=
+while (($#)); do
+  case "$1" in
+    --root) root=${2:-}; shift 2 ;;
+    --work) work=${2:-}; shift 2 ;;
+    --spec) spec=${2:-}; shift 2 ;;
+    --pacman-config) pacman_config=${2:-}; shift 2 ;;
+    *) fail "unknown option: $1" ;;
+  esac
+done
+[[ $root == /* && -d $root ]] || fail 'unsafe staged root'
+case "$root" in /|/bin|/boot|/etc|/home|/opt|/root|/usr|/var) fail 'unsafe staged root' ;; esac
+[[ $work == /* && -d $work && -f $spec && -f $pacman_config ]] || fail 'missing build inputs'
+guest_dir=$(cd "$(dirname "$spec")" && pwd)
+metadata_text=$(python3 "$guest_dir/scripts/aquamarine-contract.py" "$spec") || fail 'invalid rebuild contract'
+mapfile -t metadata <<<"$metadata_text"
+(( ${#metadata[@]} == 8 )) || fail 'incomplete rebuild contract'
+version=${metadata[0]} arch_version=${metadata[1]} package_version=${metadata[2]}
+url=${metadata[3]} source_sha=${metadata[4]} patch_file=${metadata[5]}
+soname=${metadata[6]} provide=${metadata[7]}
+epoch=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["image"]["sourceDateEpoch"])' "$spec")
+[[ $epoch =~ ^[0-9]+$ ]] || fail 'invalid source date epoch'
+for command in arch-chroot curl install pacman python3 readelf sha256sum tar zstd; do
+  command -v "$command" >/dev/null || fail "$command is required"
+done
+[[ $(arch-chroot "$root" pacman -Q aquamarine) == "aquamarine $arch_version" ]] || fail 'installed Arch version differs from pin'
+# Reuse signed, transaction-verified Arch metadata, including versioned SONAME
+# dependencies. Do not guess dependencies or provide a loose shared object.
+original="$work/pacman-cache/aquamarine-$arch_version-x86_64.pkg.tar.zst"
+[[ -f $original && ! -L $original ]] || fail 'verified Arch package cache archive missing'
+cache="$work/download-cache"
+install -d -m0755 "$cache"
+source_archive="$cache/aquamarine-$version.tar.gz"
+[[ ! -L $source_archive ]] || fail 'symlinked source cache'
+verify_source() { printf '%s  %s\n' "$source_sha" "$1" | sha256sum -c - >/dev/null; }
+if [[ ! -f $source_archive ]] || ! verify_source "$source_archive"; then
+  temporary=$(mktemp "$cache/.aquamarine.XXXXXX")
+  if ! curl --fail --location --proto '=https' --tlsv1.2 --silent --show-error "$url" -o "$temporary" || ! verify_source "$temporary"; then
+    rm -f "$temporary"; fail 'source download or digest check failed'
+  fi
+  chmod 0644 "$temporary"
+  mv "$temporary" "$source_archive"
+fi
+# arch-chroot mounts a private /tmp. Stage under /var/tmp so the source and
+# install tree remain visible across its mount setup and teardown.
+install -d -m1777 "$root/var/tmp"
+stage=$(mktemp -d "$root/var/tmp/try-omarchy-aquamarine.XXXXXX")
+cleanup() { rm -rf "$stage"; }
+trap cleanup EXIT
+relative=${stage#"$root"}
+tar -xzf "$source_archive" --no-same-owner -C "$stage"
+install -m0644 "$guest_dir/$patch_file" "$stage/cursor-hotspot.patch"
+# Compile against the same locked headers/libraries Hyprland uses. Build tools
+# are in the transaction lock too. No host-library or rolling builder leakage.
+arch-chroot "$root" /bin/bash -s -- "$relative" "$version" "$epoch" <<'BUILD'
+set -euo pipefail
+export SOURCE_DATE_EPOCH=$3
+cd "$1/aquamarine-$2"
+patch -p1 --fuzz=0 < ../cursor-hotspot.patch
+cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
+  -DCMAKE_CXX_FLAGS="-ffile-prefix-map=$1/aquamarine-$2=/usr/src/aquamarine"
+cmake --build build --parallel 2
+DESTDIR="$1/package" cmake --install build
+install -Dm0644 LICENSE "$1/package/usr/share/licenses/aquamarine/LICENSE"
+BUILD
+[[ -f $stage/package/usr/lib/$soname ]] || fail 'built library SONAME path differs from pin'
+readelf -d "$stage/package/usr/lib/$soname" | grep -F "Library soname: [$soname]" >/dev/null || fail 'built library SONAME differs from pin'
+tar --zstd -xOf "$original" .PKGINFO > "$stage/original.PKGINFO"
+python3 - "$stage" "$arch_version" "$package_version" "$epoch" "$provide" <<'INFO'
+import pathlib, sys
+stage = pathlib.Path(sys.argv[1])
+lines = (stage / 'original.PKGINFO').read_text().splitlines()
+if f'pkgver = {sys.argv[2]}' not in lines or 'pkgname = aquamarine' not in lines or f'provides = {sys.argv[5]}' not in lines:
+    raise SystemExit('Arch metadata identity or SONAME provide differs from pin')
+replaced = {'pkgver', 'builddate', 'packager', 'size'}
+lines = [line for line in lines if line.split(' = ', 1)[0] not in replaced and not line.startswith('#')]
+size = sum(p.lstat().st_size for p in (stage / 'package/usr').rglob('*') if not p.is_dir())
+lines += [f'pkgver = {sys.argv[3]}', f'builddate = {sys.argv[4]}', 'packager = Try Omarchy reproducible guest builder', f'size = {size}']
+(stage / 'package/.PKGINFO').write_text('\n'.join(lines) + '\n')
+INFO
