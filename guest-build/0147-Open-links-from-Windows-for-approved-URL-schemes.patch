diff --git a/guest/tests/test_url_schemes.py b/guest/tests/test_url_schemes.py
new file mode 100644
index 0000000..44764fb
--- /dev/null
+++ b/guest/tests/test_url_schemes.py
@@ -0,0 +1,409 @@
+"""Links from Windows: the approved-scheme helper and its agent messages."""
+from __future__ import annotations
+
+import base64
+import importlib.util
+import json
+import os
+import pwd
+import shutil
+import socket
+import subprocess
+import tempfile
+import threading
+import time
+import unittest
+from importlib.machinery import SourceFileLoader
+from pathlib import Path
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / "factory-overlay"
+HELPER = OVERLAY / "usr/local/lib/try-omarchy/url-schemes"
+AGENT = OVERLAY / "usr/local/lib/try-omarchy/agent"
+
+_loader = SourceFileLoader("url_schemes", str(HELPER))
+_spec = importlib.util.spec_from_loader("url_schemes", _loader)
+urls = importlib.util.module_from_spec(_spec)
+_loader.exec_module(urls)
+
+# The same table lives in the Windows launcher's Go tests; keep them identical.
+APPROVED = {"zoommtg", "steam"}
+ACCEPT = [
+    (b"zoommtg:join?x=1", "zoommtg:join?x=1"),
+    (b"ZoomMtg:join", "zoommtg:join"),
+    (b"steam://run/10", "steam://run/10"),
+]
+REJECT = [
+    b"-x:y",
+    b" zoommtg:x",
+    "\ufeffzoommtg:x".encode(),
+    b"c:\\x",
+    b"\\\\srv\\share",
+    b"zoommtg%3ax",
+    b"http://a",
+    b"ms-settings:x",
+    b"zoommtg:",
+    b"zoommtg:a b",
+    b'zoommtg:a"b',
+    b"zoommtg:a\\b",
+    b"zoommtg:\xff\xfe",
+    b"zoommtg:" + b"a" * (2049 - len(b"zoommtg:")),
+    b"a:x",
+    b"unapproved:x",
+]
+
+
+def b64(value: bytes | str) -> str:
+    return base64.b64encode(value.encode() if isinstance(value, str) else value).decode()
+
+
+def schemes_line(schemes: list[str]) -> str:
+    return b64(json.dumps(schemes, separators=(",", ":")))
+
+
+class ContractTests(unittest.TestCase):
+    def test_shared_vectors(self) -> None:
+        for raw, expected in ACCEPT:
+            self.assertEqual(urls.valid_open_url(raw, APPROVED), expected, raw)
+        for raw in REJECT:
+            self.assertIsNone(urls.valid_open_url(raw, APPROVED), raw)
+
+    def test_boundaries_and_guest_extras(self) -> None:
+        longest = b"zoommtg:" + b"a" * (2048 - len(b"zoommtg:"))
+        self.assertEqual(urls.valid_open_url(longest, APPROVED), longest.decode())
+        # Approval never overrides the denylist or the grammar.
+        everything = APPROVED | {"http", "ms-settings", "a", "search-ms"}
+        for raw in [b"http://a", b"ms-settings:x", b"a:x", b"search-ms:query=x"]:
+            self.assertIsNone(urls.valid_open_url(raw, everything), raw)
+        # str.lower() maps U+212A KELVIN SIGN to "k"; the ASCII check comes first.
+        for raw in ["zoom\u212amtg:x".encode(), b"zoommtg:a\x7fb", b"zoommtg:a\tb", b"zoommtg:a\nb"]:
+            self.assertIsNone(urls.valid_open_url(raw, APPROVED), raw)
+        self.assertEqual(urls.valid_open_url("zoommtg:caf\u00e9".encode(), APPROVED), "zoommtg:caf\u00e9")
+
+    def test_scheme_grammar_and_denylist(self) -> None:
+        for scheme in ["zoommtg", "steam", "web+app", "a1", "x-y.z", "s" * 32]:
+            self.assertTrue(urls.valid_scheme(scheme), scheme)
+        for scheme in ["a", "A1", "Zoommtg", "1abc", "-x", "s" * 33, "zo om", "zoom\u212amtg", "http", "https",
+                       "file", "mailto", "javascript", "search", "search-ms", "ms-settings", "ms-", "ldaps", 5, None]:
+            self.assertFalse(urls.valid_scheme(scheme), scheme)
+
+
+class HelperCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.root = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.root, True)
+        self.bin = self.root / "bin"
+        self.bin.mkdir()
+        self.apps = self.root / "applications"
+        self.apps.mkdir()
+        self.state = self.root / "run/url-schemes-approved"
+        self.opened = self.root / "opened"
+        self.notified = self.root / "notified"
+        self.queries = self.root / "queries"
+        self.handled = self.root / "handled"
+        self.handled.write_text("zoommtg\nsteam\n")
+        self.fake("xdg-mime", f'echo "$3" >>"{self.queries}"\n'
+                  f'grep -qxF -- "${{3#x-scheme-handler/}}" "{self.handled}" && echo handler.desktop\nexit 0')
+        self.fake("xdg-open", f'printf "%s\\0" "$@" >"{self.opened}.part"\n'
+                  f'ls /proc/$$/fd >"{self.opened}.fds"\nmv "{self.opened}.part" "{self.opened}"')
+        self.fake("notify-send", f'printf "%s|" "$@" >>"{self.notified}"; echo >>"{self.notified}"')
+        # systemd prints values with special characters as $'...'; the helper skips them.
+        self.fake("systemctl", "cat <<'EOF'\nWAYLAND_DISPLAY=wayland-1\nXDG_DATA_DIRS=/nowhere\nODD=$'a\\nb'\nEOF")
+        self.rates = 0
+        self.env = dict(os.environ,
+                        TRY_OMARCHY_URL_STATE=str(self.state),
+                        TRY_OMARCHY_URL_USER=pwd.getpwuid(os.geteuid()).pw_name,
+                        TRY_OMARCHY_XDG_OPEN=str(self.bin / "xdg-open"),
+                        TRY_OMARCHY_XDG_MIME=str(self.bin / "xdg-mime"),
+                        TRY_OMARCHY_NOTIFY=str(self.bin / "notify-send"),
+                        TRY_OMARCHY_SYSTEMCTL=str(self.bin / "systemctl"),
+                        TRY_OMARCHY_URL_APP_DIRS=str(self.apps))
+        self.desktop("zoom.desktop", "x-scheme-handler/zoommtg;application/x-zoom;")
+        self.desktop("steam.desktop", "x-scheme-handler/steam;x-scheme-handler/http;")
+
+    def fake(self, name: str, body: str) -> None:
+        path = self.bin / name
+        path.write_text("#!/bin/bash\n" + body + "\n")
+        path.chmod(0o755)
+
+    def desktop(self, name: str, mime: str, extra: str = "") -> None:
+        (self.apps / name).write_text(f"[Desktop Entry]\nType=Application\nName={name}\nMimeType={mime}\n{extra}")
+
+    def helper(self, mode: str, data: str | None, **extra: str) -> subprocess.CompletedProcess:
+        env = dict(self.env, **extra)
+        return subprocess.run([str(HELPER), mode], input=None if data is None else data + "\n", env=env,
+                              capture_output=True, text=True, timeout=30)
+
+    def approve(self, schemes: list[str]) -> None:
+        result = self.helper("approve", schemes_line(schemes))
+        self.assertEqual(result.returncode, 0, result.stderr)
+
+    def open(self, url: bytes | str, rate: Path | None = None) -> subprocess.CompletedProcess:
+        if rate is None:
+            # A fresh gate per call, so the one-per-second limit is tested on its own.
+            self.rates += 1
+            rate = self.root / f"rate{self.rates}"
+        return self.helper("open", b64(url), TRY_OMARCHY_URL_RATE=str(rate))
+
+    def wait_opened(self) -> list[str]:
+        deadline = time.monotonic() + 5
+        while not self.opened.exists():
+            self.assertLess(time.monotonic(), deadline, "xdg-open was not called")
+            time.sleep(0.02)
+        return self.opened.read_bytes().split(b"\0")[:-1]
+
+    def report(self) -> list[str]:
+        result = self.helper("report", None)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        line = result.stdout.rstrip("\n")
+        self.assertNotIn("\n", line)
+        self.assertLessEqual(len(line), 8192)
+        self.assertTrue(line.startswith("url-schemes "), line)
+        return json.loads(base64.b64decode(line.removeprefix("url-schemes "), validate=True))
+
+
+class ApproveTests(HelperCase):
+    def test_valid_snapshot_installs_and_invalid_update_removes_it(self) -> None:
+        self.approve(["zoommtg", "steam", "zoommtg"])
+        self.assertEqual(self.state.read_text(), '["steam","zoommtg"]')
+        self.approve([])
+        self.assertEqual(self.state.read_text(), "[]")
+        invalid = ["!!!", schemes_line(["http"]), schemes_line(["ms-settings"]), schemes_line(["Zoommtg"]),
+                   b64('{"zoommtg":1}'), b64("[1]"), b64("not json"), schemes_line([f"s{n:02}" for n in range(33)]),
+                   schemes_line(["zoommtg"]).rstrip("="), b64("[" + '"zoommtg",' * 500 + '"steam"]'), ""]
+        for data in invalid:
+            self.approve(["zoommtg"])
+            result = self.helper("approve", data)
+            self.assertEqual(result.returncode, 1, data)
+            self.assertFalse(self.state.exists(), data)
+        self.approve(["zoommtg"])
+        result = self.helper("approve", schemes_line(["steam"]) + "\n" + schemes_line(["zoommtg"]))
+        self.assertEqual(result.returncode, 1)
+        self.assertFalse(self.state.exists())
+
+
+class OpenTests(HelperCase):
+    def test_open_passes_the_url_as_one_argument(self) -> None:
+        self.approve(["zoommtg"])
+        url = "ZoomMtg:join?confno=1&pwd=$(id);`id`|x*y'z"
+        result = self.open(url)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.wait_opened(), [b"zoommtg:join?confno=1&pwd=$(id);`id`|x*y'z"])
+        # Only the standard streams and bash's own script descriptor reach the opener.
+        fds = set(self.opened.with_suffix(".fds").read_text().split())
+        self.assertLessEqual(fds, {"0", "1", "2", "255"})
+        self.assertFalse(self.notified.exists())
+        self.assertNotIn("confno", result.stderr)
+
+    def test_rejections_never_reach_xdg_open(self) -> None:
+        url = "zoommtg:join?secret=abc"
+        result = self.open(url)
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("not-ready", result.stderr)
+        self.approve(["steam"])
+        result = self.open(url)
+        self.assertIn("not-allowed", result.stderr)
+        self.approve(["zoommtg"])
+        self.handled.write_text("steam\n")
+        result = self.open(url)
+        self.assertIn("no-handler", result.stderr)
+        self.handled.write_text("zoommtg\n")
+        self.fake("systemctl", "exit 1")
+        result = self.open(url)
+        self.assertIn("no-session", result.stderr)
+        result = self.helper("open", "@@@", TRY_OMARCHY_URL_RATE=str(self.root / "rate-bad"))
+        self.assertIn("bad-encoding", result.stderr)
+        for raw in REJECT:
+            self.assertEqual(self.open(raw).returncode, 1, raw)
+        time.sleep(0.2)
+        self.assertFalse(self.opened.exists())
+        notices = self.notified.read_text().splitlines()
+        self.assertEqual(len(notices), 5 + len(REJECT))
+        for notice in notices:
+            self.assertEqual(notice, f"Try Omarchy|{urls.REJECTED}|")
+        self.assertNotIn("secret", self.notified.read_text())
+
+    def test_one_open_per_second(self) -> None:
+        self.approve(["zoommtg"])
+        rate = self.root / "rate"
+        self.assertEqual(self.open("zoommtg:first", rate).returncode, 0)
+        self.wait_opened()
+        self.opened.unlink()
+        result = self.open("zoommtg:second", rate)
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("rate-limited", result.stderr)
+        self.assertFalse(self.notified.exists())
+        time.sleep(1.1)
+        self.assertEqual(self.open("zoommtg:third", rate).returncode, 0)
+        self.assertEqual(self.wait_opened(), [b"zoommtg:third"])
+
+    def test_concurrent_opens_share_one_gate(self) -> None:
+        self.approve(["zoommtg"])
+        rate = self.root / "rate"
+        results = []
+        threads = [threading.Thread(target=lambda: results.append(self.open("zoommtg:x", rate).returncode))
+                   for _ in range(6)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+        self.assertEqual(sorted(results), [0, 1, 1, 1, 1, 1])
+
+
+class ReportTests(HelperCase):
+    def test_reports_only_effective_handlers(self) -> None:
+        self.desktop("other.desktop", "x-scheme-handler/obsidian;x-scheme-handler/MS-Teams;x-scheme-handler/a;")
+        self.desktop("hidden.desktop", "", "[Other Group]\nMimeType=x-scheme-handler/sneaky;\n")
+        (self.apps / "notes.txt").write_text("[Desktop Entry]\nMimeType=x-scheme-handler/text;\n")
+        (self.apps / "huge.desktop").write_text("[Desktop Entry]\nMimeType=x-scheme-handler/huge;\n" + "#" * 70000)
+        os.mkfifo(self.apps / "fifo.desktop")
+        self.assertEqual(self.report(), ["steam", "zoommtg"])
+        queried = set(self.queries.read_text().split())
+        self.assertEqual(queried, {"x-scheme-handler/obsidian", "x-scheme-handler/steam", "x-scheme-handler/zoommtg"})
+
+    def test_report_is_capped(self) -> None:
+        names = [f"sch{n:02}" for n in range(40)]
+        for name in names:
+            self.desktop(f"{name}.desktop", f"x-scheme-handler/{name};")
+        self.handled.write_text("\n".join(name for name in names if name != "sch05") + "\n")
+        reported = self.report()
+        self.assertEqual(len(reported), 32)
+        self.assertEqual(reported, sorted(reported))
+        self.assertNotIn("sch05", reported)
+
+    def test_failed_queries_report_an_empty_list(self) -> None:
+        self.handled.write_text("")
+        self.assertEqual(self.report(), [])
+        self.fake("xdg-mime", "sleep 10")
+        started = time.monotonic()
+        self.assertEqual(self.report(), [])
+        self.assertLess(time.monotonic() - started, 20)
