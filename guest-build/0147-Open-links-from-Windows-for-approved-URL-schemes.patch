 reply() {
   # The network loop keeps the channel on fd 3; the test entry point has none.
-  if [[ -e /dev/fd/3 ]]; then printf '%s\n' "$1" >&3; else printf '%s\n' "$1"; fi
+  # The health loop writes to the same socket, so one lock keeps lines whole.
+  if [[ -e /dev/fd/3 ]]; then
+    { flock 9; printf '%s\n' "$1" >&3; } 9>>"$write_lock"
+  else
+    printf '%s\n' "$1"
+  fi
 }
 
