+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/agent
@@ -11,16 +11,24 @@ host=${TRY_OMARCHY_AGENT_HOST:-10.0.2.2}
 port=${TRY_OMARCHY_AGENT_PORT:-4451}
 set_time=${TRY_OMARCHY_SET_TIME:-date -s}
