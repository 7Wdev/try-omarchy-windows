+class AgentLinkTests(HelperCase):
+    def agent_env(self, **extra: str) -> dict[str, str]:
+        return dict(self.env, **dict(dict(TRY_OMARCHY_URL_SCHEMES=str(HELPER),
+                                          TRY_OMARCHY_URL_RATE=str(self.root / "rate")), **extra))
+
+    def handle(self, *lines: str) -> subprocess.CompletedProcess:
+        return subprocess.run([str(AGENT), "--handle"], input="".join(line + "\n" for line in lines),
+                              env=self.agent_env(), capture_output=True, text=True, timeout=60)
+
+    def test_agent_speaks_version_6(self) -> None:
+        self.assertIn("\nversion=6\n", AGENT.read_text())
+
+    def test_approval_reports_and_invalid_update_disables(self) -> None:
+        result = self.handle("url-approved " + schemes_line(["zoommtg"]))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        reports = [line for line in result.stdout.splitlines() if line.startswith("url-schemes ")]
+        self.assertEqual(reports, ["url-schemes " + schemes_line(["steam", "zoommtg"])])
+        self.assertEqual(self.state.read_text(), '["zoommtg"]')
+        result = self.handle("url-approved " + schemes_line(["http"]))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertNotIn("url-schemes", result.stdout)
+        self.assertFalse(self.state.exists())
+
+    def test_bare_or_malformed_approval_disables_links(self) -> None:
+        valid = "url-approved " + schemes_line(["zoommtg"])
+        for line in ["url-approved", "url-approved ", "url-approved\t" + schemes_line(["zoommtg"]),
+                     "url-approved  " + schemes_line(["zoommtg"])]:
+            self.assertEqual(self.handle(valid).returncode, 0)
+            self.assertTrue(self.state.exists())
+            result = self.handle(line)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertFalse(self.state.exists(), repr(line))
+            self.assertNotIn("url-schemes", result.stdout)
+
+    def test_bare_or_malformed_open_is_rejected(self) -> None:
+        for line in ["open-url", "open-url ", "open-url\t" + b64("zoommtg:join")]:
+            self.rates += 1
+            env = self.agent_env(TRY_OMARCHY_URL_RATE=str(self.root / f"agent-rate{self.rates}"))
+            result = subprocess.run([str(AGENT), "--handle"],
+                                    input=f"url-approved {schemes_line(['zoommtg'])}\n{line}\n",
+                                    env=env, capture_output=True, text=True, timeout=60)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertIn("did not open a link from Windows", result.stderr, repr(line))
+        time.sleep(0.2)
+        self.assertFalse(self.opened.exists())
+
+    def test_open_follows_the_snapshot_sent_before_it(self) -> None:
+        result = self.handle("url-approved " + schemes_line(["zoommtg"]), "open-url " + b64("zoommtg:join?x=1"))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.wait_opened(), [b"zoommtg:join?x=1"])
+        self.opened.unlink()
+        time.sleep(1.1)
+        result = self.handle("url-approved W10=", "open-url " + b64("zoommtg:join?x=1"))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("did not open a link from Windows", result.stderr)
+        time.sleep(0.2)
+        self.assertFalse(self.opened.exists())
