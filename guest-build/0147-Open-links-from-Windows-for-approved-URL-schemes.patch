+class AgentFramingTests(unittest.TestCase):
+    """Health reports and link reports share the socket without splitting lines."""
+
+    def test_concurrent_writers_keep_lines_whole(self) -> None:
+        root = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, root, True)
+        report = "url-schemes " + "A" * 8000
+        health = "compositor " + "B" * 8000000
+        probe = root / "probe"
+        probe.write_text(f"#!/bin/bash\nprintf 'compositor %s\\n' \"$(head -c 8000000 /dev/zero | tr '\\0' B)\"\n")
+        helper = root / "url-schemes"
+        helper.write_text("#!/bin/bash\ncat >/dev/null 2>&1\n"
+                          f"[[ $1 == report ]] && printf 'url-schemes %s\\n' \"$(head -c 8000 /dev/zero | tr '\\0' A)\"\n"
+                          "exit 0\n")
+        for path in (probe, helper):
+            path.chmod(0o755)
+        approvals = 40
+        with socket.socket() as server:
+            server.bind(("127.0.0.1", 0))
+            server.listen(1)
+            server.settimeout(10)
+            env = dict(os.environ, TRY_OMARCHY_AGENT_HOST="127.0.0.1", TRY_OMARCHY_AGENT_PORT=str(server.getsockname()[1]),
+                       TRY_OMARCHY_HEALTH_PROBE=str(probe), TRY_OMARCHY_URL_SCHEMES=str(helper),
+                       TRY_OMARCHY_URL_STATE=str(root / "run/state"),
+                       TRY_OMARCHY_AGENT_WRITE_LOCK=str(root / "run/agent-write.lock"))
+            agent = subprocess.Popen([str(AGENT)], env=env, stdin=subprocess.DEVNULL,
+                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
+            try:
+                connection, _ = server.accept()
+                with connection:
+                    connection.settimeout(10)
+                    received = b""
+                    deadline = time.monotonic() + 30
+                    # Ask for link reports while the large health line is still being written.
+                    while b"\ncompositor " not in received and time.monotonic() < deadline:
+                        received += connection.recv(16384)
+                    connection.sendall(b"".join(b"url-approved W10=\n" for _ in range(approvals)))
+                    while (received.count(b"\nurl-schemes ") < approvals or b"\ncompositor " not in received
+                           or not received.endswith(b"\n")) and time.monotonic() < deadline:
+                        chunk = connection.recv(16384)
+                        if not chunk:
+                            break
+                        received += chunk
+                        time.sleep(0.001)
+            finally:
+                os.killpg(agent.pid, 9)
+                agent.wait(timeout=5)
+        lines = received.decode().split("\n")[:-1]
+        self.assertEqual(lines[0], "hello 6")
+        for line in lines[1:]:
+            self.assertIn(line, (report, health), line[:40] + "...")
+        self.assertEqual(lines.count(report), approvals)
+        self.assertGreaterEqual(lines.count(health), 1)
+
+
