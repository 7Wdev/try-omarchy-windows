       fi
       ;;
+    url-approved\ *)
+      # Links stay disabled unless this connection's latest snapshot installed.
+      if printf '%s\n' "${line#url-approved }" | timeout 5 "$url_schemes" approve 3>&-; then
+        report=$(timeout 20 "$url_schemes" report 3>&-)
+        if [[ $report == 'url-schemes '* && ${#report} -le 8192 && ${report#url-schemes } =~ ^[A-Za-z0-9+/=]+$ ]]; then
+          reply "$report"
+        fi
+      else
+        rm -f -- "$url_state"
+        echo 'could not apply approved link types' >&2
+      fi
+      ;;
+    open-url\ *)
+      printf '%s\n' "${line#open-url }" | timeout 5 "$url_schemes" open 3>&- ||
+        echo 'did not open a link from Windows' >&2
+      ;;
+    url-approved|url-approved[[:space:]]*)
+      # A missing or malformed snapshot still replaces the previous one: disabled.
+      rm -f -- "$url_state"
+      echo 'could not apply approved link types' >&2
+      ;;
+    open-url|open-url[[:space:]]*)
+      echo 'did not open a link from Windows' >&2
+      ;;
     battery-details\ *)
       printf '%s\n' "${line#battery-details }" | /usr/local/lib/try-omarchy/battery-apply --details ||
         echo 'could not apply host battery details' >&2
@@ -101,16 +133,20 @@ if [[ ${1:-} == --handle ]]; then
   exit 0
 fi
 
+mkdir -p -- "${write_lock%/*}" 2>/dev/null || true
 # A restarted agent may reconnect to an older launcher with no details message.
 /usr/local/lib/try-omarchy/battery-apply --offline || true
 while :; do
+  # Every connection starts with links disabled until the launcher sends approvals.
+  rm -f -- "$url_state"
   exec 3<>"/dev/tcp/$host/$port" 2>/dev/null || { sleep 10; continue; }
   printf 'hello %s\n' "$version" >&3
   # Probe separately so clock/app handling and disk reclaim cannot hold up
   # health reports. The helper bounds Hyprland IPC to two seconds.
   (
     while :; do
-      "$health_probe" >&3
+      status=$("$health_probe")
+      [[ -n $status ]] && reply "$status"
       sleep 5
     done
   ) &
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/url-schemes b/guest/factory-overlay/usr/local/lib/try-omarchy/url-schemes
new file mode 100755
index 0000000..db98fcc
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/url-schemes
@@ -0,0 +1,383 @@
+#!/usr/bin/env python3
+"""Open links from Windows only for URL schemes the user approved in host Settings.
+
+The agent runs this as root:
+  approve  reads one base64 JSON scheme list from stdin and installs it as the
+           approval state for the current connection; anything invalid removes it.
+  report   prints "url-schemes <base64 JSON>" with the schemes whose links a
+           guest desktop app opens by default.
+  open     reads one base64 URL from stdin and passes it to xdg-open as the
+           desktop user when its scheme is approved and still has a handler.
+Logs carry reason codes only, never a URL.
+"""
+import base64
+import binascii
+import fcntl
+import json
+import os
+import pwd
+import re
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+
+# Shared with the Windows launcher; both sides must accept exactly the same input.
+SCHEME = re.compile(r"[a-z][a-z0-9+.-]{1,31}")
+URL_SCHEME = re.compile(rb"[A-Za-z][A-Za-z0-9+.-]{1,31}")
+DENIED = frozenset("""
+    http https file mailto ftp ftps sftp data javascript vbscript about blob ws wss
+    smb nfs news nntp telnet rlogin ldap ldaps shell res mk its search search-ms
+""".split())
+MAX_SCHEMES = 32
+MAX_URL = 2048
+HANDLER = "x-scheme-handler/"
+
+STATE = os.environ.get("TRY_OMARCHY_URL_STATE", "/run/try-omarchy/url-schemes-approved")
+RATE = os.environ.get("TRY_OMARCHY_URL_RATE", "/run/try-omarchy/url-open.rate")
+USER = os.environ.get("TRY_OMARCHY_URL_USER", "omarchy")
+XDG_OPEN = os.environ.get("TRY_OMARCHY_XDG_OPEN", "/usr/bin/xdg-open")
+XDG_MIME = os.environ.get("TRY_OMARCHY_XDG_MIME", "/usr/bin/xdg-mime")
+NOTIFY = os.environ.get("TRY_OMARCHY_NOTIFY", "/usr/bin/notify-send")
+SYSTEMCTL = os.environ.get("TRY_OMARCHY_SYSTEMCTL", "/usr/bin/systemctl")
+
+# Discovery bounds: candidates come from plain readdir of the XDG application dirs.
+MAX_DIRS = 16
+MAX_FILES = 2000
+MAX_DESKTOP_FILE = 64 * 1024
+MAX_QUERIES = 64
+QUERY_TIMEOUT = 2
+REPORT_BUDGET = 10
+REJECTED = "A link from Windows was not opened. Check Links from Windows in Try Omarchy Settings."
+
+
+class Rejected(Exception):
+    """A request refused for a logged reason code."""
+
+
+def valid_scheme(value) -> bool:
+    return (isinstance(value, str) and SCHEME.fullmatch(value) is not None
+            and value not in DENIED and not value.startswith("ms-"))
+
+
+def valid_open_url(raw: bytes, approved) -> str | None:
+    """Return the URL with its scheme lowercased, or None. Nothing else is rewritten."""
+    if not isinstance(raw, bytes) or len(raw) > MAX_URL:
+        return None
+    try:
+        text = raw.decode("utf-8")
+    except UnicodeDecodeError:
+        return None
+    if any(byte < 0x21 or byte in (0x22, 0x5C, 0x7F) for byte in raw):
+        return None
+    scheme, colon, rest = raw.partition(b":")
+    # Check ASCII before lowercasing: str.lower() maps U+212A KELVIN SIGN to "k".
+    if not colon or not rest or URL_SCHEME.fullmatch(scheme) is None:
+        return None
+    scheme = scheme.lower().decode("ascii")
+    if not valid_scheme(scheme) or scheme not in approved:
+        return None
+    return scheme + text[len(scheme):]
+
+
+def scheme_list(raw: bytes) -> list[str]:
+    value = json.loads(raw)
+    if not isinstance(value, list) or len(value) > MAX_SCHEMES:
+        raise ValueError("invalid scheme list")
+    for scheme in value:
+        if not valid_scheme(scheme):
+            raise ValueError("invalid scheme")
+    return sorted(set(value))
+
+
+def read_line(limit: int) -> str:
+    data = sys.stdin.readline(limit + 1).rstrip("\r\n")
+    if not data or len(data) > limit or sys.stdin.read(1):
+        raise ValueError("invalid input")
+    return data
+
+
+def remove_state() -> None:
+    try:
+        os.unlink(STATE)
+    except FileNotFoundError:
+        pass
+    except OSError:
+        # The agent removes the state again when this helper fails.
+        print("url-schemes: could not remove approval state", file=sys.stderr)
+
+
+def approve() -> int:
+    try:
+        raw = base64.b64decode(read_line(8192), validate=True)
+        if len(raw) > 4096:
+            raise ValueError("approval list too large")
+        schemes = scheme_list(raw)
+        directory = os.path.dirname(STATE)
+        os.makedirs(directory, mode=0o755, exist_ok=True)
+        fd, temp = tempfile.mkstemp(prefix=".url-schemes-", dir=directory)
+        try:
+            with os.fdopen(fd, "w", encoding="ascii") as output:
+                output.write(json.dumps(schemes, separators=(",", ":")))
+            os.chmod(temp, 0o644)
+            os.replace(temp, STATE)
+        finally:
+            if os.path.exists(temp):
+                os.unlink(temp)
+    except (OSError, ValueError, binascii.Error) as error:
+        # A rejected or unwritable snapshot never leaves an older approval active.
+        remove_state()
+        print(f"url-schemes: approval rejected: {type(error).__name__}", file=sys.stderr)
+        return 1
+    return 0
+
+
+def approved_schemes() -> list[str]:
+    fd = os.open(STATE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+    with os.fdopen(fd, "rb") as state:
+        if not stat.S_ISREG(os.fstat(state.fileno()).st_mode):
+            raise ValueError("state is not a file")
+        raw = state.read(4097)
+    if len(raw) > 4096:
+        raise ValueError("state too large")
+    return scheme_list(raw)
+
+
+def desktop_user() -> pwd.struct_passwd:
+    return pwd.getpwnam(USER)
+
+
+def user_options(user: pwd.struct_passwd) -> dict:
+    # Tests run as the desktop user itself; dropping to the same identity is a no-op.
+    if user.pw_uid == os.geteuid():
+        return {}
+    return {"user": user.pw_uid, "group": user.pw_gid, "extra_groups": []}
+
+
+def session_environment(user: pwd.struct_passwd) -> dict[str, str]:
+    """The desktop user's systemd session environment, as their apps see it."""
+    base = {"PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8",
+            "HOME": user.pw_dir, "USER": user.pw_name, "LOGNAME": user.pw_name,
+            "XDG_RUNTIME_DIR": f"/run/user/{user.pw_uid}",
+            "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{user.pw_uid}/bus"}
+    environment = dict(base)
+    try:
+        result = subprocess.run([SYSTEMCTL, "--user", "show-environment"], env=base,
+                                stdin=subprocess.DEVNULL, capture_output=True, text=True,
+                                timeout=3, cwd="/", **user_options(user))
+    except (OSError, subprocess.SubprocessError):
+        return environment
+    if result.returncode != 0:
+        return environment
+    for line in result.stdout.splitlines()[:512]:
+        key, separator, value = line.partition("=")
+        # systemd quotes values with special characters as $'...'; skip those.
+        if separator and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) and not value.startswith("$'"):
+            environment[key] = value
+    # The identity always comes from the password database.
+    environment.update({key: base[key] for key in ("HOME", "USER", "LOGNAME", "XDG_RUNTIME_DIR")})
+    return environment
+
+
+def default_handler(scheme: str, user: pwd.struct_passwd, environment: dict[str, str]) -> bool:
+    try:
+        result = subprocess.run([XDG_MIME, "query", "default", HANDLER + scheme], env=environment,
+                                stdin=subprocess.DEVNULL, capture_output=True, text=True,
+                                timeout=QUERY_TIMEOUT, cwd=user.pw_dir if os.path.isdir(user.pw_dir) else "/",
+                                **user_options(user))
+    except (OSError, subprocess.SubprocessError):
+        return False
+    return result.returncode == 0 and result.stdout.strip() != ""
+
+
+def application_dirs(environment: dict[str, str]) -> list[str]:
+    home = environment["HOME"]
+    data_home = environment.get("XDG_DATA_HOME") or os.path.join(home, ".local/share")
+    data_dirs = (environment.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
+    roots = [data_home, *data_dirs, "/usr/local/share", "/usr/share",
+             os.path.join(home, ".local/share/flatpak/exports/share"), "/var/lib/flatpak/exports/share"]
+    if "TRY_OMARCHY_URL_APP_DIRS" in os.environ:
+        return os.environ["TRY_OMARCHY_URL_APP_DIRS"].split(":")[:MAX_DIRS]
+    result = []
+    for root in roots:
+        path = os.path.join(root, "applications")
+        if os.path.isabs(root) and path not in result:
+            result.append(path)
+    return result[:MAX_DIRS]
+
+
+def declared_schemes(content: bytes) -> set[str]:
+    found, in_entry = set(), False
+    for line in content.splitlines():
+        line = line.strip()
+        if line.startswith(b"["):
+            in_entry = line == b"[Desktop Entry]"
+        elif in_entry and line.startswith(b"MimeType="):
+            for item in line[len(b"MimeType="):].split(b";"):
+                item = item.strip()
+                if item[:len(HANDLER)].lower() == HANDLER.encode():
+                    scheme = item[len(HANDLER):]
+                    if URL_SCHEME.fullmatch(scheme):
+                        scheme = scheme.lower().decode("ascii")
+                        if valid_scheme(scheme):
+                            found.add(scheme)
+    return found
+
+
+def candidates(environment: dict[str, str]) -> list[str]:
+    found, files = set(), 0
+    for directory in application_dirs(environment):
+        try:
+            entries = os.scandir(directory)
+        except OSError:
+            continue
+        with entries:
+            for entry in entries:
+                if not entry.name.endswith(".desktop"):
+                    continue
+                files += 1
+                if files > MAX_FILES:
+                    return sorted(found)
+                try:
+                    # Non-blocking, so a FIFO named *.desktop cannot stall the scan.
+                    fd = os.open(entry.path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
+                    with os.fdopen(fd, "rb") as desktop:
+                        if not stat.S_ISREG(os.fstat(desktop.fileno()).st_mode):
+                            continue
+                        content = desktop.read(MAX_DESKTOP_FILE + 1)
+                except OSError:
+                    continue
+                if len(content) <= MAX_DESKTOP_FILE:
+                    found |= declared_schemes(content)
+    return sorted(found)
+
+
+def scan() -> int:
+    """Runs as the desktop user: list candidate schemes with an effective default handler."""
+    user = desktop_user()
+    environment = dict(os.environ)
+    deadline = time.monotonic() + REPORT_BUDGET
+    handled = []
+    for scheme in candidates(environment)[:MAX_QUERIES]:
+        if len(handled) >= MAX_SCHEMES or time.monotonic() > deadline:
+            break
+        if default_handler(scheme, user, environment):
+            handled.append(scheme)
+    print(json.dumps(handled, separators=(",", ":")))
+    return 0
+
+
+def report() -> int:
+    schemes = []
+    try:
+        user = desktop_user()
+        environment = session_environment(user)
+        for key in ("TRY_OMARCHY_URL_USER", "TRY_OMARCHY_URL_APP_DIRS", "TRY_OMARCHY_XDG_MIME"):
+            if key in os.environ:
+                environment[key] = os.environ[key]
+        # Desktop files under the user's home are read as that user, never as root.
+        result = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "scan"],
+                                env=environment, stdin=subprocess.DEVNULL, capture_output=True,
+                                timeout=REPORT_BUDGET + QUERY_TIMEOUT + 3, cwd="/",
+                                **user_options(user))
+        if result.returncode != 0 or len(result.stdout) > 4096:
+            raise ValueError("scan failed")
+        schemes = scheme_list(result.stdout)
+    except (OSError, KeyError, ValueError, subprocess.SubprocessError) as error:
+        print(f"url-schemes: report empty: {type(error).__name__}", file=sys.stderr)
+    payload = base64.b64encode(json.dumps(schemes, separators=(",", ":")).encode()).decode()
+    print(f"url-schemes {payload}")
+    return 0
+
+
+def rate_limited() -> bool:
+    """Allow one open per second across helpers, using boot-relative time."""
+    directory = os.path.dirname(RATE)
+    os.makedirs(directory, mode=0o755, exist_ok=True)
+    fd = os.open(RATE, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
+    with os.fdopen(fd, "r+") as gate:
+        fcntl.flock(gate, fcntl.LOCK_EX)
+        now = time.monotonic()
+        try:
+            last = float(gate.read(64))
+        except ValueError:
+            last = None
+        if last is not None and 0 <= now - last < 1:
+            return True
+        gate.seek(0)
+        gate.truncate()
+        gate.write(f"{now:.6f}")
+        gate.flush()
+    return False
+
+
+def notify(user: pwd.struct_passwd, environment: dict[str, str]) -> None:
+    try:
+        subprocess.run([NOTIFY, "Try Omarchy", REJECTED], env=environment, stdin=subprocess.DEVNULL,
+                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3, cwd="/",
+                       **user_options(user))
+    except (OSError, subprocess.SubprocessError):
+        pass
+
+
+def open_url() -> int:
+    try:
+        if rate_limited():
+            print("url-schemes: open rejected: rate-limited", file=sys.stderr)
+            return 1
+    except OSError:
+        print("url-schemes: open rejected: rate-gate", file=sys.stderr)
+        return 1
+    try:
+        user = desktop_user()
+    except KeyError:
+        print("url-schemes: open rejected: no-user", file=sys.stderr)
+        return 1
+    environment = session_environment(user)
+    try:
+        try:
+            raw = base64.b64decode(read_line(4096), validate=True)
+        except (ValueError, binascii.Error):
+            raise Rejected("bad-encoding")
+        try:
+            approved = approved_schemes()
+        except (OSError, ValueError):
+            raise Rejected("not-ready")
+        url = valid_open_url(raw, approved)
+        if url is None:
+            raise Rejected("not-allowed")
+        if not (environment.get("WAYLAND_DISPLAY") or environment.get("DISPLAY")):
+            raise Rejected("no-session")
+        if not default_handler(url.partition(":")[0], user, environment):
+            raise Rejected("no-handler")
+        try:
+            subprocess.Popen([XDG_OPEN, url], env=environment, stdin=subprocess.DEVNULL,
+                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True,
+                             start_new_session=True, cwd=user.pw_dir if os.path.isdir(user.pw_dir) else "/",
+                             **user_options(user))
+        except (OSError, subprocess.SubprocessError):
+            raise Rejected("spawn-failed")
+    except Rejected as rejection:
+        print(f"url-schemes: open rejected: {rejection}", file=sys.stderr)
+        notify(user, environment)
+        return 1
+    return 0
+
+
+def main() -> int:
+    mode = sys.argv[1] if len(sys.argv) == 2 else ""
+    if mode == "approve":
+        return approve()
+    if mode == "report":
+        return report()
+    if mode == "scan":
+        return scan()
+    if mode == "open":
+        return open_url()
+    print("usage: url-schemes approve|report|open", file=sys.stderr)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
