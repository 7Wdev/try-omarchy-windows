+/* Keep virtio-sound capture periods moving even without a host microphone.
+ * Use the same virtual-clock pacing and format-aware silence as audio-none.
+ */
+static void sdl_silence_in(SDLVoiceIn *sdl)
+{
+    HWVoiceIn *hw = &sdl->hw;
+    size_t bytes = audio_rate_get_bytes(&sdl->silence_rate, &hw->info,
+                                       hw->size_emul - hw->pending_emul);
+
+    while (bytes) {
+        size_t len = MIN(bytes, hw->size_emul - hw->pos_emul);
+
+        audio_pcm_info_clear_buf(&hw->info, hw->buf_emul + hw->pos_emul,
+                                 len / hw->info.bytes_per_frame);
+        hw->pos_emul = (hw->pos_emul + len) % hw->size_emul;
+        hw->pending_emul += len;
+        bytes -= len;
+    }
+}
+
+/* SDL's cached inventory check is cheap; an attempted WASAPI open may block.
+ * Leave ten seconds after a failed open before trying a listed endpoint again.
+ */
+static void sdl_backoff_in(SDLVoiceIn *sdl)
+{
+    int seconds = SDL_GetNumAudioDevices(1) > 0 ? 10 : 1;
+
+    sdl->next_route_check = g_get_monotonic_time() + seconds * G_USEC_PER_SEC;
+}
