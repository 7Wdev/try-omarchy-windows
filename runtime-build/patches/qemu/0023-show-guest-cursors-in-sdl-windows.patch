+/* SDL has one current cursor. Definitions and visibility belong to a head. */
+static bool sdl_cursor_active(struct sdl2_console *scon)
+{
+    return scon->real_window &&
+           SDL_GetMouseFocus() == scon->real_window;
+}
+
+static void sdl_cursor_free(struct sdl2_console *scon)
+{
+    if (scon->guest_sprite) {
+        if (SDL_GetCursor() == scon->guest_sprite) {
+            SDL_SetCursor(sdl_cursor_hidden);
+            SDL_ShowCursor(SDL_DISABLE);
+        }
+        SDL_FreeCursor(scon->guest_sprite);
+        scon->guest_sprite = NULL;
+    }
+    scon->cursor_width = scon->cursor_height = 0;
+}
+
+static void sdl_cursor_rebuild(struct sdl2_console *scon)
+{
+    QEMUCursor *c = scon->cursor;
+    SDL_Surface *sprite;
+    int ww, wh, gw, gh, width, height, hot_x, hot_y;
+    double sx, sy;
+
+    if (!c || !scon->real_window || !scon->surface) {
+        return;
+    }
+    SDL_GetWindowSize(scon->real_window, &ww, &wh);
+    gw = surface_width(scon->surface);
+    gh = surface_height(scon->surface);
+#ifdef CONFIG_OPENGL
+    if (scon->opengl && scon->scanout_mode) {
+        /* egl_fb_blit stretches the complete scanout to the window. */
+        gw = scon->guest_fb.width;
+        gh = scon->guest_fb.height;
+    }
+#endif
+    if (ww <= 0 || wh <= 0 || gw <= 0 || gh <= 0) {
+        return;
+    }
+    sx = (double)ww / gw;
+    sy = (double)wh / gh;
+#ifdef CONFIG_OPENGL
+    if (!scon->opengl || !scon->scanout_mode)
+#endif
+    {
+        /* SDL_RenderSetLogicalSize and surface_gl_setup_viewport letterbox. */
+        sx = sy = MIN(sx, sy);
+    }
+    width = MAX(1, (int)(c->width * sx + 0.5));
+    height = MAX(1, (int)(c->height * sy + 0.5));
+    if (width == scon->cursor_width && height == scon->cursor_height) {
+        return;
+    }
+    sdl_cursor_free(scon);
+    /* Remember failures too: do not retry every refresh at the same size. */
+    scon->cursor_width = width;
+    scon->cursor_height = height;
+    sprite = SDL_CreateRGBSurface(0, width, height, 32,
+                                 0xff0000, 0x00ff00, 0xff, 0xff000000);
+    if (!sprite) {
+        return;
+    }
+    for (int y = 0; y < height; y++) {
+        uint32_t *row = (uint32_t *)((uint8_t *)sprite->pixels + y * sprite->pitch);
+        for (int x = 0; x < width; x++) {
+            row[x] = c->data[(y * c->height / height) * c->width +
+                             x * c->width / width];
+        }
+    }
+    hot_x = MIN(width - 1, c->hot_x * width / c->width);
+    hot_y = MIN(height - 1, c->hot_y * height / c->height);
+    scon->guest_sprite = SDL_CreateColorCursor(sprite, hot_x, hot_y);
+    SDL_FreeSurface(sprite);
+}
