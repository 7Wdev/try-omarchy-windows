+/* One glBufferSubData per guest page is slow, so send the range in one call.
+ * Returns false if the staging copy could not be allocated. */
+static bool iov_buffer_upload_once(GLenum target, const struct iovec *iov,
+                                   int num_iovs, size_t offset,
+                                   const struct pipe_box *box)
+{
+   size_t size = box->width;
+   void *staging;
+
+   while (num_iovs > 0 && iov->iov_len <= offset) {
+      offset -= iov->iov_len;
+      iov++;
+      num_iovs--;
+   }
+   if (num_iovs > 0 && iov->iov_len - offset >= size) {
+      glBufferSubData(target, box->x, size, (char *)iov->iov_base + offset);
+      return true;
+   }
+
+   staging = malloc(size);
+   if (!staging)
+      return false;
+   size = vrend_read_from_iovec(iov, num_iovs, offset, staging, size);
+   glBufferSubData(target, box->x, size, staging);
+   free(staging);
+   return true;
+}
