enum D3D12_PIPELINE_STATE_SUBOBJECT_TYPE {
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE = 0,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS = 1,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS = 2,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DS = 3,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_HS = 4,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_GS = 5,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CS = 6,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_STREAM_OUTPUT = 7,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND = 8,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_MASK = 9,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER = 10,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL = 11,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_INPUT_LAYOUT = 12,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_IB_STRIP_CUT_VALUE = 13,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY = 14,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS = 15,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL_FORMAT = 16,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_DESC = 17,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_NODE_MASK = 18,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CACHED_PSO = 19,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_FLAGS = 20,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL1 = 21,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VIEW_INSTANCING = 22,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL2 = 27,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER1 = 28,
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER2 = 29,
};

struct ID3D12RootSignature {
   std::atomic<int> refs{1};
   std::vector<std::pair<GUID, std::vector<uint8_t>>> priv;
   std::mutex lock;
   void AddRef() { ++refs; }
   int Release() {
      int r = --refs;
      if (r == 0)
         delete this;
      return r;
   }
   HRESULT SetPrivateData(const GUID &g, UINT size, const void *data) {
      std::lock_guard<std::mutex> lk(lock);
      const uint8_t *p = (const uint8_t *)data;
      std::vector<uint8_t> v(p, p + size);
      for (auto &kv : priv) {
         if (kv.first == g) {
            kv.second = v;
            return S_OK;
         }
      }
      priv.push_back({g, v});
      return S_OK;
   }
   HRESULT GetPrivateData(const GUID &g, UINT *size, void *out) {
      std::lock_guard<std::mutex> lk(lock);
      for (auto &kv : priv) {
         if (kv.first == g) {
            if (!out) {
               *size = (UINT)kv.second.size();
               return S_OK;
            }
            if (*size < kv.second.size())
               return E_FAIL;
            memcpy(out, kv.second.data(), kv.second.size());
            *size = (UINT)kv.second.size();
            return S_OK;
         }
      }
      return E_FAIL;
   }
};

struct D3D12_GRAPHICS_PIPELINE_STATE_DESC {
   ID3D12RootSignature *pRootSignature = nullptr;
   D3D12_SHADER_BYTECODE VS{};
   D3D12_SHADER_BYTECODE PS{};
   D3D12_SHADER_BYTECODE DS{};
   D3D12_SHADER_BYTECODE HS{};
   D3D12_SHADER_BYTECODE GS{};
   D3D12_STREAM_OUTPUT_DESC StreamOutput{};
   D3D12_BLEND_DESC BlendState{};
   UINT SampleMask = 0xffffffffu;
   D3D12_RASTERIZER_DESC RasterizerState{};
   D3D12_DEPTH_STENCIL_DESC DepthStencilState{};
   D3D12_INPUT_LAYOUT_DESC InputLayout{};
   D3D12_INDEX_BUFFER_STRIP_CUT_VALUE IBStripCutValue = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_DISABLED;
   D3D12_PRIMITIVE_TOPOLOGY_TYPE PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
   UINT NumRenderTargets = 0;
   DXGI_FORMAT RTVFormats[8]{};
   DXGI_FORMAT DSVFormat = DXGI_FORMAT_UNKNOWN;
   DXGI_SAMPLE_DESC SampleDesc{};
   UINT NodeMask = 0;
   D3D12_CACHED_PIPELINE_STATE CachedPSO{};
   D3D12_PIPELINE_STATE_FLAGS Flags = D3D12_PIPELINE_STATE_FLAG_NONE;
};

struct D3D12_COMPUTE_PIPELINE_STATE_DESC {
   ID3D12RootSignature *pRootSignature = nullptr;
   D3D12_SHADER_BYTECODE CS{};
   UINT NodeMask = 0;
   D3D12_CACHED_PIPELINE_STATE CachedPSO{};
   D3D12_PIPELINE_STATE_FLAGS Flags = D3D12_PIPELINE_STATE_FLAG_NONE;
};

struct D3D12_PIPELINE_STATE_STREAM_DESC {
   size_t SizeInBytes = 0;
   void *pPipelineStateSubobjectStream = nullptr;
};

struct CD3DX12_PIPELINE_STATE_STREAM3 {
   ID3D12RootSignature *pRootSignature = nullptr;
   D3D12_SHADER_BYTECODE VS{}, HS{}, DS{}, GS{}, PS{}, AS{}, MS{}, CS{};
   D3D12_STREAM_OUTPUT_DESC StreamOutput{};
   D3D12_INPUT_LAYOUT_DESC InputLayout{};
   D3D12_INDEX_BUFFER_STRIP_CUT_VALUE IBStripCutValue = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_DISABLED;
   D3D12_PRIMITIVE_TOPOLOGY_TYPE PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
   D3D12_BLEND_DESC BlendState{};
   d3d12_depth_stencil_desc_type DepthStencilState{};
   DXGI_FORMAT DSVFormat = DXGI_FORMAT_UNKNOWN;
   D3D12_RASTERIZER_DESC RasterizerState{};
   D3D12_RT_FORMAT_ARRAY RTVFormats{};
   DXGI_SAMPLE_DESC SampleDesc{};
   UINT SampleMask = 0xffffffffu;
   UINT NodeMask = 0;
   D3D12_CACHED_PIPELINE_STATE CachedPSO{};
   D3D12_VIEW_INSTANCING_DESC ViewInstancingDesc{};
   D3D12_PIPELINE_STATE_FLAGS Flags = D3D12_PIPELINE_STATE_FLAG_NONE;

   D3D12_GRAPHICS_PIPELINE_STATE_DESC GraphicsDescV0() const {
      D3D12_GRAPHICS_PIPELINE_STATE_DESC g;
      g.pRootSignature = pRootSignature;
      g.VS = VS; g.PS = PS; g.DS = DS; g.HS = HS; g.GS = GS;
      g.StreamOutput = StreamOutput;
      g.BlendState = BlendState;
      g.SampleMask = SampleMask;
      g.RasterizerState = RasterizerState;
      g.DepthStencilState.DepthEnable = DepthStencilState.DepthEnable;
      g.DepthStencilState.DepthWriteMask = DepthStencilState.DepthWriteMask;
      g.DepthStencilState.DepthFunc = DepthStencilState.DepthFunc;
      g.DepthStencilState.StencilEnable = DepthStencilState.StencilEnable;
      g.DepthStencilState.StencilReadMask = DepthStencilState.FrontFace.StencilReadMask;
      g.DepthStencilState.StencilWriteMask = DepthStencilState.FrontFace.StencilWriteMask;
      g.InputLayout = InputLayout;
      g.IBStripCutValue = IBStripCutValue;
      g.PrimitiveTopologyType = PrimitiveTopologyType;
      g.NumRenderTargets = RTVFormats.NumRenderTargets;
      for (unsigned i = 0; i < 8; i++)
         g.RTVFormats[i] = RTVFormats.RTFormats[i];
      g.DSVFormat = DSVFormat;
      g.SampleDesc = SampleDesc;
      g.NodeMask = NodeMask;
      g.CachedPSO = CachedPSO;
      g.Flags = Flags;
      return g;
   }
};

static std::atomic<int> g_live_psos{0};

struct ID3D12PipelineState {
   std::atomic<int> refs{1};
   std::vector<uint8_t> captured_vs;
   std::vector<uint8_t> captured_cs;
   std::string captured_semantic;
   UINT captured_vi_count = 0;
   float captured_depth_bias = 0.0f;
   UINT8 captured_stencil_read = 0;
   UINT captured_rt0 = 0;
   ID3D12PipelineState() { ++g_live_psos; }
   void AddRef() { ++refs; }
   int Release() {
      int r = --refs;
      if (r == 0) {
         --g_live_psos;
         delete this;
      }
      return r;
   }
};

static const GUID dzn_root_signature_blob_guid_mirror =
   { 0x8d4e1f23, 0x6a95, 0x4b18, { 0x9c, 0x12, 0x7e, 0x45, 0xa1, 0x30, 0x8b, 0x5d } };

template <typename T>
struct test_subobj {
   D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type;
   T d;
};

struct ID3D12Device4 {
   std::atomic<int> root_sig_calls{0};
   std::atomic<int> gfx_calls{0};
   std::atomic<int> compute_calls{0};
   std::atomic<int> stream_calls{0};
   std::function<void()> on_stream_enter;

   HRESULT CreateRootSignature(UINT, const void *blob, size_t len, ID3D12RootSignature **out) {
      ++root_sig_calls;
      ID3D12RootSignature *rs = new ID3D12RootSignature;
      const GUID d3d12_guid = { 0x3f1c2a7e, 0x9b64, 0x4d0a, { 0x8e, 0x21, 0x5c, 0x7b, 0x90, 0x14, 0xd6, 0x3a } };
      rs->SetPrivateData(d3d12_guid, (UINT)len, blob);
      rs->SetPrivateData(dzn_root_signature_blob_guid_mirror, (UINT)len, blob);
      *out = rs;
      return S_OK;
   }
   HRESULT CreateGraphicsPipelineState(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *d, ID3D12PipelineState **out) {
      ++gfx_calls;
      ID3D12PipelineState *pso = new ID3D12PipelineState;
      if (d->VS.pShaderBytecode && d->VS.BytecodeLength)
         pso->captured_vs.assign((const uint8_t *)d->VS.pShaderBytecode,
                                 (const uint8_t *)d->VS.pShaderBytecode + d->VS.BytecodeLength);
      if (d->InputLayout.NumElements && d->InputLayout.pInputElementDescs &&
          d->InputLayout.pInputElementDescs[0].SemanticName)
         pso->captured_semantic = d->InputLayout.pInputElementDescs[0].SemanticName;
      pso->captured_rt0 = d->RTVFormats[0];
      *out = pso;
      return S_OK;
   }
   HRESULT CreateComputePipelineState(const D3D12_COMPUTE_PIPELINE_STATE_DESC *d, ID3D12PipelineState **out) {
      ++compute_calls;
      ID3D12PipelineState *pso = new ID3D12PipelineState;
      if (d->CS.pShaderBytecode && d->CS.BytecodeLength)
         pso->captured_cs.assign((const uint8_t *)d->CS.pShaderBytecode,
                                 (const uint8_t *)d->CS.pShaderBytecode + d->CS.BytecodeLength);
      *out = pso;
      return S_OK;
   }
   HRESULT CreatePipelineState(const D3D12_PIPELINE_STATE_STREAM_DESC *s, ID3D12PipelineState **out) {
      ++stream_calls;
      if (on_stream_enter)
         on_stream_enter();
      ID3D12PipelineState *pso = new ID3D12PipelineState;
      const uint8_t *buf = (const uint8_t *)s->pPipelineStateSubobjectStream;
      size_t pos = 0;
      while (pos < s->SizeInBytes) {
         pos = ALIGN_POT(pos, alignof(void *));
         if (pos + sizeof(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE) > s->SizeInBytes)
            break;
         D3D12_PIPELINE_STATE_SUBOBJECT_TYPE t;
         memcpy(&t, buf + pos, sizeof(t));
         auto adv = [&](size_t sz) -> const uint8_t * {
            const uint8_t *ptr = buf + pos + sizeof(t);
            (void)sz;
            return ptr;
         };
         (void)adv;
         switch (t) {
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE:
            pos += sizeof(test_subobj<ID3D12RootSignature *>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS: {
            test_subobj<D3D12_SHADER_BYTECODE> obj;
            memcpy(&obj, buf + pos, sizeof(obj));
            if (obj.d.pShaderBytecode && obj.d.BytecodeLength)
               pso->captured_vs.assign((const uint8_t *)obj.d.pShaderBytecode,
                                       (const uint8_t *)obj.d.pShaderBytecode + obj.d.BytecodeLength);
            pos += sizeof(obj);
            break;
         }
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS:
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DS:
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_HS:
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_GS:
            pos += sizeof(test_subobj<D3D12_SHADER_BYTECODE>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CS: {
            test_subobj<D3D12_SHADER_BYTECODE> obj;
            memcpy(&obj, buf + pos, sizeof(obj));
            if (obj.d.pShaderBytecode && obj.d.BytecodeLength)
               pso->captured_cs.assign((const uint8_t *)obj.d.pShaderBytecode,
                                       (const uint8_t *)obj.d.pShaderBytecode + obj.d.BytecodeLength);
            pos += sizeof(obj);
            break;
         }
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_INPUT_LAYOUT: {
            test_subobj<D3D12_INPUT_LAYOUT_DESC> obj;
            memcpy(&obj, buf + pos, sizeof(obj));
            if (obj.d.NumElements && obj.d.pInputElementDescs && obj.d.pInputElementDescs[0].SemanticName)
               pso->captured_semantic = obj.d.pInputElementDescs[0].SemanticName;
            pos += sizeof(obj);
            break;
         }
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VIEW_INSTANCING: {
            test_subobj<D3D12_VIEW_INSTANCING_DESC> obj;
            memcpy(&obj, buf + pos, sizeof(obj));
            pso->captured_vi_count = obj.d.ViewInstanceCount;
            pos += sizeof(obj);
            break;
         }
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_STREAM_OUTPUT:
            pos += sizeof(test_subobj<D3D12_STREAM_OUTPUT_DESC>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND:
            pos += sizeof(test_subobj<D3D12_BLEND_DESC>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_MASK:
            pos += sizeof(test_subobj<UINT>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER:
            pos += sizeof(test_subobj<D3D12_RASTERIZER_DESC>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER1:
            pos += sizeof(test_subobj<D3D12_RASTERIZER_DESC1>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER2: {
            test_subobj<D3D12_RASTERIZER_DESC2> obj;
            memcpy(&obj, buf + pos, sizeof(obj));
            pso->captured_depth_bias = obj.d.DepthBias;
            pos += sizeof(obj);
            break;
         }
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL:
            pos += sizeof(test_subobj<D3D12_DEPTH_STENCIL_DESC>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL1:
            pos += sizeof(test_subobj<D3D12_DEPTH_STENCIL_DESC1>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL2: {
            test_subobj<D3D12_DEPTH_STENCIL_DESC2> obj;
            memcpy(&obj, buf + pos, sizeof(obj));
            pso->captured_stencil_read = obj.d.FrontFace.StencilReadMask;
            pos += sizeof(obj);
            break;
         }
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_IB_STRIP_CUT_VALUE:
            pos += sizeof(test_subobj<D3D12_INDEX_BUFFER_STRIP_CUT_VALUE>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY:
            pos += sizeof(test_subobj<D3D12_PRIMITIVE_TOPOLOGY_TYPE>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS: {
            test_subobj<D3D12_RT_FORMAT_ARRAY> obj;
            memcpy(&obj, buf + pos, sizeof(obj));
            pso->captured_rt0 = obj.d.RTFormats[0];
            pos += sizeof(obj);
            break;
         }
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL_FORMAT:
            pos += sizeof(test_subobj<DXGI_FORMAT>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_DESC:
            pos += sizeof(test_subobj<DXGI_SAMPLE_DESC>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_NODE_MASK:
            pos += sizeof(test_subobj<UINT>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CACHED_PSO:
            pos += sizeof(test_subobj<D3D12_CACHED_PIPELINE_STATE>);
            break;
         case D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_FLAGS:
            pos += sizeof(test_subobj<D3D12_PIPELINE_STATE_FLAGS>);
            break;
         default:
            pos = s->SizeInBytes;
            break;
         }
      }
      *out = pso;
      return S_OK;
   }
};

struct blake3_hasher {
   std::vector<uint8_t> data;
};

static inline void _mesa_blake3_init(blake3_hasher *h) { h->data.clear(); }
static inline void _mesa_blake3_update(blake3_hasher *h, const void *p, size_t n) {
   const uint8_t *b = (const uint8_t *)p;
   h->data.insert(h->data.end(), b, b + n);
}
static inline void _mesa_blake3_final(blake3_hasher *h, uint8_t out[BLAKE3_OUT_LEN]) {
   uint64_t s[4] = {
      0x6a09e667f3bcc908ull, 0xbb67ae8584caa73bull,
      0x3c6ef372fe94f82bull, 0xa54ff53a5f1d36f1ull,
   };
   for (size_t i = 0; i < h->data.size(); i++) {
      uint64_t x = h->data[i] + 1u + (uint64_t)i * 0x9e3779b97f4a7c15ull;
      s[i & 3] ^= x;
      s[0] = (s[0] * 0xbf58476d1ce4e5b9ull) ^ (s[(i + 1) & 3] >> 27);
      s[1] = (s[1] * 0x94d049bb133111ebull) ^ (s[(i + 2) & 3] << 13);
      s[2] += s[0] ^ (s[3] >> 17);
      s[3] ^= s[1] + (s[2] << 7);
   }
   memcpy(out, s, 32);
}
static inline void _mesa_blake3_compute(const void *p, size_t n, uint8_t out[BLAKE3_OUT_LEN]) {
   blake3_hasher h;
   _mesa_blake3_init(&h);
   _mesa_blake3_update(&h, p, n);
   _mesa_blake3_final(&h, out);
}

static inline void disk_cache_get_function_identifier(void *fn, blake3_hasher *h) {
   uintptr_t tag = fn ? 0x12345678u : 0u;
   _mesa_blake3_update(h, &tag, sizeof(tag));
}

static inline const char *util_get_process_name() { return "prewarm_unit_app"; }
static inline int64_t os_time_get_nano() { return 1000000; }
static inline bool debug_get_bool_option(const char *name, bool dfault) {
   const char *v = getenv(name);
   if (!v)
      return dfault;
   if (!strcmp(v, "0") || !strcmp(v, "false") || !strcmp(v, "no"))
      return false;
   return true;
}

enum test_queue_mode { Q_SYNC, Q_DEFER, Q_ASYNC_THREAD };
static test_queue_mode g_queue_mode = Q_SYNC;

constexpr unsigned UTIL_QUEUE_INIT_RESIZE_IF_FULL = 1;
constexpr unsigned UTIL_QUEUE_INIT_SET_FULL_THREAD_AFFINITY = 2;

struct util_queue_fence { int unused = 0; };
typedef void (*util_queue_execute_func)(void *job, void *gdata, int thread_index);

struct util_queue {
   void *gdata = nullptr;
   struct pending_job { void *job; util_queue_execute_func fn; };
   std::vector<pending_job> deferred;
   std::vector<std::thread> threads;
};

static inline void util_queue_fence_init(struct util_queue_fence *) {}
static inline void util_queue_fence_destroy(struct util_queue_fence *) {}
static inline bool util_queue_init(struct util_queue *q, const char *, unsigned, unsigned, unsigned, void *gdata) {
   q->gdata = gdata;
   return true;
}
static inline void util_queue_add_job(struct util_queue *q, void *job, struct util_queue_fence *,
                                      util_queue_execute_func execute, util_queue_execute_func, size_t) {
   if (g_queue_mode == Q_SYNC)
      execute(job, q->gdata, 0);
   else if (g_queue_mode == Q_DEFER)
      q->deferred.push_back({job, execute});
   else
      q->threads.emplace_back([job, gdata = q->gdata, execute]() { execute(job, gdata, 0); });
}
static inline void util_queue_finish(struct util_queue *q) {
   for (auto &t : q->threads)
      if (t.joinable())
         t.join();
   q->threads.clear();
   for (auto &j : q->deferred)
      j.fn(j.job, q->gdata, 0);
   q->deferred.clear();
}
static inline void util_queue_destroy(struct util_queue *q) { util_queue_finish(q); }

