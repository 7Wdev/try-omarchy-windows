namespace dzn_fmt_unit {
enum D3D12_FEATURE_TYPE { D3D12_FEATURE_FORMAT_SUPPORT = 1 };
enum D3D12_FORMAT_SUPPORT1 { D3D12_FORMAT_SUPPORT1_RENDER_TARGET = 0x4000 };
enum D3D12_FORMAT_SUPPORT2 { D3D12_FORMAT_SUPPORT2_UAV_ATOMIC_ADD = 0x20 };
struct D3D12_FEATURE_DATA_FORMAT_SUPPORT {
   DXGI_FORMAT Format = DXGI_FORMAT_UNKNOWN;
   D3D12_FORMAT_SUPPORT1 Support1 = (D3D12_FORMAT_SUPPORT1)0;
   D3D12_FORMAT_SUPPORT2 Support2 = (D3D12_FORMAT_SUPPORT2)0;
};
struct mtx_t { std::mutex m; };
static inline void mtx_lock(mtx_t *l) { l->m.lock(); }
static inline void mtx_unlock(mtx_t *l) { l->m.unlock(); }
struct FakeFmtDev {
   int calls = 0;
   HRESULT next_hr = S_OK;
   D3D12_FORMAT_SUPPORT1 s1 = D3D12_FORMAT_SUPPORT1_RENDER_TARGET;
   D3D12_FORMAT_SUPPORT2 s2 = D3D12_FORMAT_SUPPORT2_UAV_ATOMIC_ADD;
};
struct dzn_physical_device {
   FakeFmtDev *dev = nullptr;
   mtx_t format_cache_lock;
   struct {
      D3D12_FORMAT_SUPPORT1 support1 = (D3D12_FORMAT_SUPPORT1)0;
      D3D12_FORMAT_SUPPORT2 support2 = (D3D12_FORMAT_SUPPORT2)0;
      bool valid = false;
   } dxgi_format_cache[256];
};
static inline HRESULT ID3D12Device1_CheckFeatureSupport(FakeFmtDev *d, D3D12_FEATURE_TYPE,
                                                        D3D12_FEATURE_DATA_FORMAT_SUPPORT *info, size_t) {
   ++d->calls;
   if (FAILED(d->next_hr))
      return d->next_hr;
   info->Support1 = (D3D12_FORMAT_SUPPORT1)((uint32_t)d->s1 + (uint32_t)info->Format);
   info->Support2 = d->s2;
   return S_OK;
}
// ACTUAL_DZN_FORMAT_CACHE
} // namespace dzn_fmt_unit

static void remove_tree(const std::string &path) {
   DIR *d = opendir(path.c_str());
   if (!d) {
      unlink(path.c_str());
      return;
   }
   while (struct dirent *ent = readdir(d)) {
      if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, ".."))
         continue;
      std::string child = path + "/" + ent->d_name;
      struct stat st{};
      if (lstat(child.c_str(), &st) == 0 && S_ISDIR(st.st_mode))
         remove_tree(child);
      else
         unlink(child.c_str());
   }
   closedir(d);
   rmdir(path.c_str());
}

static std::string find_single_bin(const std::string &dir) {
   DIR *d = opendir(dir.c_str());
   assert(d != nullptr);
   std::string found;
   while (struct dirent *ent = readdir(d)) {
      size_t n = strlen(ent->d_name);
      if (n > 4 && !strcmp(ent->d_name + n - 4, ".bin")) {
         assert(found.empty());
         found = dir + "/" + ent->d_name;
      }
   }
   closedir(d);
   assert(!found.empty());
   return found;
}

static std::string make_temp_dir(const char *tag) {
   std::string tmpl = std::string("/tmp/vdxg_prewarm_") + tag + "_XXXXXX";
   std::vector<char> buf(tmpl.begin(), tmpl.end());
   buf.push_back('\0');
   char *res = mkdtemp(buf.data());
   assert(res != nullptr);
   return std::string(res);
}

template <typename T>
static size_t emit_test_subobj(std::vector<uint8_t> &buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type, const T &val) {
   test_subobj<T> item{};
   item.type = type;
   item.d = val;
   size_t pos = ALIGN_POT(buf.size(), alignof(void *));
   buf.resize(pos + sizeof(item), 0);
   memcpy(buf.data() + pos, &item, sizeof(item));
   return buf.size();
}

static void build_dzn_gfx_stream(std::vector<uint8_t> &buf, ID3D12RootSignature *rs,
                                 const std::vector<uint8_t> &vs, const std::vector<uint8_t> &ps,
                                 const D3D12_INPUT_LAYOUT_DESC &il,
                                 const D3D12_VIEW_INSTANCING_DESC &vi,
                                 const D3D12_RASTERIZER_DESC2 &ra2,
                                 const D3D12_DEPTH_STENCIL_DESC2 &ds2,
                                 const D3D12_RT_FORMAT_ARRAY &rts) {
   buf.clear();
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE, rs);
   D3D12_SHADER_BYTECODE vsbc{ vs.data(), vs.size() };
   D3D12_SHADER_BYTECODE psbc{ ps.data(), ps.size() };
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS, vsbc);
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS, psbc);
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_INPUT_LAYOUT, il);
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VIEW_INSTANCING, vi);
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER2, ra2);
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL2, ds2);
   D3D12_BLEND_DESC blend{};
   blend.RenderTarget[0].BlendEnable = 1;
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND, blend);
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS, rts);
   DXGI_SAMPLE_DESC sd{ 4, 0 };
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_DESC, sd);
   D3D12_PRIMITIVE_TOPOLOGY_TYPE pt = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY, pt);
   D3D12_PIPELINE_STATE_FLAGS fl = D3D12_PIPELINE_STATE_FLAG_NONE;
   emit_test_subobj(buf, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_FLAGS, fl);
}

int main() {
   std::string root = make_temp_dir("main");
   std::string runtime = root + "/runtime";
   std::string cache_fallback = root + "/cache";
   mkdir(runtime.c_str(), 0755);
   mkdir(cache_fallback.c_str(), 0755);
   unsetenv("VDXG_PSO_CACHE_DIR");
   setenv("XDG_RUNTIME_DIR", runtime.c_str(), 1);
   setenv("MESA_SHADER_CACHE_DIR", cache_fallback.c_str(), 1);
   setenv("D3D12_PSO_PREWARM", "1", 1);
   setenv("DZN_PSO_PREWARM", "1", 1);
   setenv("MESA_SHADER_CACHE_DISABLE", "0", 1);

   const std::vector<uint8_t> rs_blob{ 0x52, 0x53, 0x30, 0x31, 0xaa, 0xbb };
   const std::vector<uint8_t> vs_code{ 0x44, 0x58, 0x42, 0x43, 0x01, 0x02 };
   const std::vector<uint8_t> ps_code{ 0x44, 0x58, 0x42, 0x43, 0x03, 0x04 };
   const std::vector<uint8_t> cs_code{ 0x44, 0x58, 0x42, 0x43, 0x05, 0x06, 0x07 };

   // Cases 1, 2, 3, 4: d3d12_pso_prewarm (.ready gating, graphics+compute record & prewarm hit)
   {
      ID3D12Device4 dev;
      ID3D12RootSignature *rs = nullptr;
      dev.CreateRootSignature(0, rs_blob.data(), rs_blob.size(), &rs);

      d3d12_unit::d3d12_screen scr;
      scr.dev = &dev;
      g_queue_mode = Q_SYNC;
      d3d12_unit::d3d12_pso_prewarm_init(&scr);
      assert(scr.pso_prewarm != nullptr);

      D3D12_INPUT_ELEMENT_DESC elem{};
      elem.SemanticName = "POSITION";
      elem.Format = DXGI_FORMAT_R32G32B32_FLOAT;
      CD3DX12_PIPELINE_STATE_STREAM3 gfx;
      gfx.pRootSignature = rs;
      gfx.VS = D3D12_SHADER_BYTECODE{ vs_code.data(), vs_code.size() };
      gfx.PS = D3D12_SHADER_BYTECODE{ ps_code.data(), ps_code.size() };
      gfx.InputLayout = D3D12_INPUT_LAYOUT_DESC{ &elem, 1 };
      gfx.RTVFormats.NumRenderTargets = 1;
      gfx.RTVFormats.RTFormats[0] = DXGI_FORMAT_B8G8R8A8_UNORM;

      // Case 1: cold gfx records + in-screen repeat hits live PSO
      ID3D12PipelineState *p1 = d3d12_unit::d3d12_pso_prewarm_create_gfx(&scr, gfx, false);
      assert(p1 && dev.gfx_calls == 1);
      ID3D12PipelineState *p1_hit = d3d12_unit::d3d12_pso_prewarm_create_gfx(&scr, gfx, false);
      assert(p1_hit == p1 && dev.gfx_calls == 1);
      p1->Release();
      p1_hit->Release();

      // Case 2: cold compute records + repeat hits
      D3D12_COMPUTE_PIPELINE_STATE_DESC cdesc{};
      cdesc.pRootSignature = rs;
      cdesc.CS = D3D12_SHADER_BYTECODE{ cs_code.data(), cs_code.size() };
      ID3D12PipelineState *c1 = d3d12_unit::d3d12_pso_prewarm_create_compute(&scr, cdesc);
      assert(c1 && dev.compute_calls == 1);
      ID3D12PipelineState *c1_hit = d3d12_unit::d3d12_pso_prewarm_create_compute(&scr, cdesc);
      assert(c1_hit == c1 && dev.compute_calls == 1);
      c1->Release();
      c1_hit->Release();

      d3d12_unit::d3d12_pso_prewarm_fini(&scr);
      assert(g_live_psos == 0);

      // Case 4: verify .ready gating chose fallback (vdxg-pso did NOT have .ready yet)
      struct stat st{};
      assert(stat((cache_fallback + "/d3d12_pso").c_str(), &st) == 0);
      assert(stat((runtime + "/vdxg-pso/d3d12_pso").c_str(), &st) != 0);

      // Case 3: reload on fresh screen prewarms both gfx + compute in worker queue
      dev.gfx_calls = 0;
      dev.compute_calls = 0;
      d3d12_unit::d3d12_pso_prewarm_init(&scr);
      assert(dev.gfx_calls == 1 && dev.compute_calls == 1);
      ID3D12PipelineState *p2 = d3d12_unit::d3d12_pso_prewarm_create_gfx(&scr, gfx, false);
      ID3D12PipelineState *c2 = d3d12_unit::d3d12_pso_prewarm_create_compute(&scr, cdesc);
      assert(p2 && c2 && dev.gfx_calls == 1 && dev.compute_calls == 1);
      assert(p2->captured_vs == vs_code && p2->captured_semantic == "POSITION");
      assert(c2->captured_cs == cs_code);
      p2->Release();
      c2->Release();
      d3d12_unit::d3d12_pso_prewarm_fini(&scr);
      assert(g_live_psos == 0);

      // Now create runtime/vdxg-pso/.ready and verify it takes priority on next init
      std::string rt_pso = runtime + "/vdxg-pso";
      mkdir(rt_pso.c_str(), 0755);
      int rfd = open((rt_pso + "/.ready").c_str(), O_CREAT | O_WRONLY, 0644);
      assert(rfd >= 0);
      close(rfd);
      d3d12_unit::d3d12_pso_prewarm_init(&scr);
      d3d12_unit::d3d12_pso_prewarm_fini(&scr);
      assert(stat((rt_pso + "/d3d12_pso").c_str(), &st) == 0);

      rs->Release();
   }

   // Cases 5, 6, 7, 8, 9: dzn_pso_prewarm (stream gfx + compute, worker prewarm, claim, wait, corrupt stop)
   {
      std::string dzn_dir = make_temp_dir("dzn");
      setenv("VDXG_PSO_CACHE_DIR", dzn_dir.c_str(), 1);

      ID3D12Device4 dev;
      ID3D12RootSignature *rs = nullptr;
      dev.CreateRootSignature(0, rs_blob.data(), rs_blob.size(), &rs);

      D3D12_INPUT_ELEMENT_DESC elem{};
      elem.SemanticName = "TEXCOORD";
      elem.Format = DXGI_FORMAT_R32G32B32_FLOAT;
      D3D12_INPUT_LAYOUT_DESC il{ &elem, 1 };
      D3D12_VIEW_INSTANCE_LOCATION vi_loc{ 2, 1 };
      D3D12_VIEW_INSTANCING_DESC vi{ 1, &vi_loc, D3D12_VIEW_INSTANCING_FLAG_NONE };
      D3D12_RASTERIZER_DESC2 ra2{};
      ra2.DepthBias = -2.5f;
      D3D12_DEPTH_STENCIL_DESC2 ds2{};
      ds2.FrontFace.StencilReadMask = 0x5a;
      D3D12_RT_FORMAT_ARRAY rts{};
      rts.NumRenderTargets = 1;
      rts.RTFormats[0] = DXGI_FORMAT_B8G8R8A8_UNORM;

      std::vector<uint8_t> gfx_stream, cs_stream;
      build_dzn_gfx_stream(gfx_stream, rs, vs_code, ps_code, il, vi, ra2, ds2, rts);
      emit_test_subobj(cs_stream, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE, rs);
      D3D12_SHADER_BYTECODE csbc{ cs_code.data(), cs_code.size() };
      emit_test_subobj(cs_stream, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_CS, csbc);
      D3D12_PIPELINE_STATE_FLAGS cfl = D3D12_PIPELINE_STATE_FLAG_NONE;
      emit_test_subobj(cs_stream, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_FLAGS, cfl);

      D3D12_PIPELINE_STATE_STREAM_DESC gfx_desc{ gfx_stream.size(), gfx_stream.data() };
      D3D12_PIPELINE_STATE_STREAM_DESC cs_desc{ cs_stream.size(), cs_stream.data() };

      // Case 5: cold record + live hit
      g_queue_mode = Q_SYNC;
      dzn_unit::dzn_pso_prewarm *pw = dzn_unit::dzn_pso_prewarm_init(&dev, 0x10de, 0x2c59, 1, 0xa1, 62114, 3);
      assert(pw != nullptr);
      ID3D12PipelineState *dp1 = nullptr, *dp1_hit = nullptr, *dc1 = nullptr;
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &gfx_desc, &dp1)) && dp1);
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &gfx_desc, &dp1_hit)) && dp1_hit == dp1);
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &cs_desc, &dc1)) && dc1);
      assert(dev.stream_calls == 2);
      dp1->Release();
      dp1_hit->Release();
      dc1->Release();
      dzn_unit::dzn_pso_prewarm_fini(pw);
      assert(g_live_psos == 0);

      // Case 6: reload prewarms both and preserves every stream subobject field
      dev.stream_calls = 0;
      pw = dzn_unit::dzn_pso_prewarm_init(&dev, 0x10de, 0x2c59, 1, 0xa1, 62114, 3);
      assert(dev.stream_calls == 2);
      ID3D12PipelineState *dp2 = nullptr, *dc2 = nullptr;
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &gfx_desc, &dp2)) && dp2);
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &cs_desc, &dc2)) && dc2);
      assert(dev.stream_calls == 2);
      assert(dp2->captured_vs == vs_code && dp2->captured_semantic == "TEXCOORD");
      assert(dp2->captured_vi_count == 1 && dp2->captured_depth_bias == -2.5f);
      assert(dp2->captured_stencil_read == 0x5a && dp2->captured_rt0 == DXGI_FORMAT_B8G8R8A8_UNORM);
      assert(dc2->captured_cs == cs_code);
      dp2->Release();
      dc2->Release();
      dzn_unit::dzn_pso_prewarm_fini(pw);
      assert(g_live_psos == 0);

      // Case 7: deferred worker leaves entry PSO_PENDING; caller claims & compiles once on demand
      g_queue_mode = Q_DEFER;
      dev.stream_calls = 0;
      pw = dzn_unit::dzn_pso_prewarm_init(&dev, 0x10de, 0x2c59, 1, 0xa1, 62114, 3);
      assert(dev.stream_calls == 0);
      ID3D12PipelineState *dp3 = nullptr;
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &gfx_desc, &dp3)) && dp3);
      assert(dev.stream_calls == 1);
      dp3->Release();
      dzn_unit::dzn_pso_prewarm_fini(pw);
      assert(dev.stream_calls == 1 && g_live_psos == 0);

      // Case 8: isolated single pipeline under Q_ASYNC_THREAD; worker hits PSO_BUSY and main waits
      std::string dzn_wait_dir = make_temp_dir("dzn_wait");
      setenv("VDXG_PSO_CACHE_DIR", dzn_wait_dir.c_str(), 1);
      g_queue_mode = Q_SYNC;
      pw = dzn_unit::dzn_pso_prewarm_init(&dev, 0x10de, 0x2c59, 1, 0xa1, 62114, 3);
      ID3D12PipelineState *seed_pso = nullptr;
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &gfx_desc, &seed_pso)) && seed_pso);
      seed_pso->Release();
      dzn_unit::dzn_pso_prewarm_fini(pw);
      assert(g_live_psos == 0);

      std::mutex b_mtx;
      std::condition_variable b_cv;
      bool worker_entered = false, release_worker = false;
      dev.stream_calls = 0;
      dev.on_stream_enter = [&]() {
         std::unique_lock<std::mutex> lk(b_mtx);
         worker_entered = true;
         b_cv.notify_all();
         b_cv.wait(lk, [&]() { return release_worker; });
      };
      g_queue_mode = Q_ASYNC_THREAD;
      pw = dzn_unit::dzn_pso_prewarm_init(&dev, 0x10de, 0x2c59, 1, 0xa1, 62114, 3);
      {
         std::unique_lock<std::mutex> lk(b_mtx);
         b_cv.wait(lk, [&]() { return worker_entered; });
      }
      ID3D12PipelineState *waited_pso = nullptr;
      std::thread waiter([&]() {
         assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &gfx_desc, &waited_pso)));
      });
      {
         std::lock_guard<std::mutex> lk(b_mtx);
         release_worker = true;
         b_cv.notify_all();
      }
      waiter.join();
      assert(waited_pso != nullptr);
      waited_pso->Release();
      dev.on_stream_enter = nullptr;
      dzn_unit::dzn_pso_prewarm_fini(pw);
      assert(dev.stream_calls == 1 && g_live_psos == 0);
      remove_tree(dzn_wait_dir);
      setenv("VDXG_PSO_CACHE_DIR", dzn_dir.c_str(), 1);

      // Case 9: tamper one byte near start of persisted record -> BLAKE3 stops loading cleanly
      g_queue_mode = Q_SYNC;
      std::string bin_path = find_single_bin(dzn_dir + "/dzn_pso");
      int bfd = open(bin_path.c_str(), O_RDWR);
      assert(bfd >= 0);
      uint8_t byte_at_44 = 0;
      assert(pread(bfd, &byte_at_44, 1, 44) == 1);
      byte_at_44 ^= 0xff;
      assert(pwrite(bfd, &byte_at_44, 1, 44) == 1);
      close(bfd);

      dev.stream_calls = 0;
      pw = dzn_unit::dzn_pso_prewarm_init(&dev, 0x10de, 0x2c59, 1, 0xa1, 62114, 3);
      assert(dev.stream_calls == 0); // Stopped at corrupted first record
      ID3D12PipelineState *recover = nullptr;
      assert(SUCCEEDED(dzn_unit::dzn_pso_prewarm_create(pw, &dev, &gfx_desc, &recover)) && recover);
      assert(dev.stream_calls == 1);
      recover->Release();
      dzn_unit::dzn_pso_prewarm_fini(pw);
      assert(g_live_psos == 0);

      rs->Release();
      remove_tree(dzn_dir);
      unsetenv("VDXG_PSO_CACHE_DIR");
   }

   // Cases 10, 11, 12: dzn_physical_device_check_dxgi_format cache
   {
      dzn_fmt_unit::FakeFmtDev fdev;
      dzn_fmt_unit::dzn_physical_device pdev;
      pdev.dev = &fdev;

      // Case 10: < 256 format hits cache on 2nd query
      dzn_fmt_unit::D3D12_FEATURE_DATA_FORMAT_SUPPORT q1{};
      q1.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
      assert(dzn_fmt_unit::dzn_physical_device_check_dxgi_format(&pdev, &q1) == S_OK);
      assert(fdev.calls == 1 &&
             (uint32_t)q1.Support1 == (uint32_t)dzn_fmt_unit::D3D12_FORMAT_SUPPORT1_RENDER_TARGET + 87u);
      dzn_fmt_unit::D3D12_FEATURE_DATA_FORMAT_SUPPORT q2{};
      q2.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
      assert(dzn_fmt_unit::dzn_physical_device_check_dxgi_format(&pdev, &q2) == S_OK);
      assert(fdev.calls == 1 && q2.Support1 == q1.Support1 && q2.Support2 == q1.Support2);

      // Case 11: >= 256 bypasses fixed 256-slot table safely
      dzn_fmt_unit::D3D12_FEATURE_DATA_FORMAT_SUPPORT q_high{};
      q_high.Format = DXGI_FORMAT_CUSTOM_HIGH;
      assert(dzn_fmt_unit::dzn_physical_device_check_dxgi_format(&pdev, &q_high) == S_OK);
      assert(dzn_fmt_unit::dzn_physical_device_check_dxgi_format(&pdev, &q_high) == S_OK);
      assert(fdev.calls == 3);

      // Case 12: failure HRESULT is not cached
      fdev.next_hr = E_FAIL;
      dzn_fmt_unit::D3D12_FEATURE_DATA_FORMAT_SUPPORT q_err{};
      q_err.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
      assert(dzn_fmt_unit::dzn_physical_device_check_dxgi_format(&pdev, &q_err) == E_FAIL);
      assert(fdev.calls == 4 && !pdev.dxgi_format_cache[45].valid);
      fdev.next_hr = S_OK;
      assert(dzn_fmt_unit::dzn_physical_device_check_dxgi_format(&pdev, &q_err) == S_OK);
      assert(fdev.calls == 5 && pdev.dxgi_format_cache[45].valid);
   }

   remove_tree(root);
   std::puts("PREWARM_CPU_PASS cases=12");
   return 0;
}
