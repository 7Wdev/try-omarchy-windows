#!/bin/sh
# Fast-launch router installed in /run/virtio-dxg/bin/<app> (via /usr/local/bin
# overlay when virtio_dxg.boost=0 is absent). Delegates supported launches to
# vdxg-fastlaunch (< 1 ms native C IPC) and falls back cleanly to /usr/bin/<app>.
prog=${0##*/}
if [ "${VIRTIO_DXG_BOOST:-1}" != 0 ]; then
    rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    fast=$rt/vdxg-boost/vdxg-fastlaunch
    if [ -x "$fast" ]; then
        exec "$fast" "$prog" "$@"
    fi
fi
if [ -x "/run/virtio-dxg/omarchy-orig/$prog" ]; then
    exec "/run/virtio-dxg/omarchy-orig/$prog" "$@"
fi
exec "/usr/bin/$prog" "$@"
