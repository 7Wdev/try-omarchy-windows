#!/bin/bash
# browser-boost: keep the default browser (when Chromium) warm in the background
# without a visible window, wait until its SingletonSocket is accepting connections,
# and warm its first tab/compositor path once so even the first browser or PWA
# click opens in well under 100 ms.
set -u

case $(xdg-settings get default-web-browser 2>/dev/null) in
chromium.desktop|"") ;;
*) exit 0 ;;
esac
[ -x /usr/bin/chromium ] || exit 0
# Already running (opened by the user before this ran): nothing to do.
pgrep -u "$(id -u)" -x chromium >/dev/null && exit 0

rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$rt"
for _ in $(seq 1 150); do
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$rt/$WAYLAND_DISPLAY" ]; then
        break
    fi
    for s in "$rt"/wayland-*; do
        case $s in *.lock) continue ;; esac
        if [ -S "$s" ]; then
            export WAYLAND_DISPLAY="${s##*/}"
            break 2
        fi
    done
    sleep 0.2
done

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$rt/hypr" ]; then
    his=$(ls -1 "$rt/hypr" 2>/dev/null | head -1 || true)
    [ -n "$his" ] && export HYPRLAND_INSTANCE_SIGNATURE="$his"
fi

sleep "${BOOST_DELAY:-1}"
pgrep -u "$(id -u)" -x chromium >/dev/null && exit 0

/usr/bin/chromium \
    --enable-features=TouchpadOverscrollHistoryNavigation,SpareRendererForSitePerProcess,ParallelDownloading,BackForwardCache \
    --enable-gpu-rasterization --enable-zero-copy --num-raster-threads=4 \
    --disk-cache-size=536870912 --no-startup-window --keep-alive-for-test &
cpid=$!

sock="${XDG_CONFIG_HOME:-$HOME/.config}/chromium/SingletonSocket"
for _ in $(seq 1 100); do
    kill -0 "$cpid" 2>/dev/null || exit 0
    [ -S "$sock" ] && break
    sleep 0.1
done

# Dynamically discover all PWA/webapp origins from .desktop entries + YouTube/Discord CDN
# origins, resolve DNS (AF_INET), and warm TLS/HTTP2/SPARE renderer off-screen cleanly.
if [ -S "$sock" ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v python3 >/dev/null 2>&1; then
    (
        python3 - <<'PY' >/dev/null 2>&1 || true
import glob, os, re, socket, subprocess, time, urllib.parse

rt = os.environ["XDG_RUNTIME_DIR"]
his = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
sock_path = os.path.join(rt, "hypr", his, ".socket2.sock")

origins = {
    "https://youtube.com",
    "https://www.youtube.com",
    "https://i.ytimg.com",
    "https://yt3.ggpht.com",
    "https://fonts.gstatic.com",
    "https://fonts.googleapis.com",
    "https://discord.com",
    "https://cdn.discordapp.com",
    "https://gateway.discord.gg",
    "https://assets.discord.com",
}
data_dirs = [os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "/usr/share"]
for d in data_dirs:
    for df in glob.glob(os.path.join(d, "applications", "*.desktop")):
        try:
            txt = open(df, encoding="utf-8", errors="ignore").read()
        except OSError:
            continue
        for m in re.finditer(r"https://[^\s\"']+", txt):
            p = urllib.parse.urlsplit(m.group(0))
            if p.netloc:
                origins.add(f"{p.scheme}://{p.netloc}")

hosts = sorted({urllib.parse.urlsplit(o).hostname for o in origins if urllib.parse.urlsplit(o).hostname})
for h in hosts:
    try:
        socket.getaddrinfo(h, 443, socket.AF_INET)
    except OSError:
        pass

links = "".join(f'<link rel="preconnect" href="{o}" crossorigin>' for o in sorted(origins)[:24])
warm_url = "data:text/html,<!doctype html><head>" + urllib.parse.quote(links) + "</head>"

def hypr_move_warm(a):
    expr = f'hl.dispatch(hl.dsp.window.move({{ workspace = "special:vdxg_warm", follow = false, window = "address:0x{a}" }}))'
    r = subprocess.run(["hyprctl", "eval", expr], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip().startswith("ok"):
        subprocess.run(["hyprctl", "dispatch", "movetoworkspacesilent",
                        f"special:vdxg_warm,address:0x{a}"], capture_output=True)

def hypr_close(a):
    expr = f'hl.dispatch(hl.dsp.window.close({{ window = "address:0x{a}" }}))'
    r = subprocess.run(["hyprctl", "eval", expr], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip().startswith("ok"):
        subprocess.run(["hyprctl", "dispatch", "closewindow",
                        f"address:0x{a}"], capture_output=True)

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sock_path)
s.settimeout(0.05)
p = subprocess.Popen(["/usr/bin/chromium", "--class=vdxg-warm-browser",
                      "--new-window", warm_url],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
buf, addr = b"", None
deadline = time.monotonic() + 6.0
while time.monotonic() < deadline and addr is None:
    try:
        buf += s.recv(65536)
    except socket.timeout:
        continue
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        if line.startswith(b"openwindow>>"):
            f = line[12:].decode(errors="replace").split(",", 3)
            if len(f) >= 3 and "chrom" in f[2].lower():
                addr = f[0].removeprefix("0x")
                break
s.close()
if addr:
    hypr_move_warm(addr)
    time.sleep(0.8)
    hypr_close(addr)
try:
    p.wait(timeout=3)
except subprocess.TimeoutExpired:
    pass

while True:
    time.sleep(120)
    for h in hosts:
        try:
            socket.getaddrinfo(h, 443, socket.AF_INET)
        except OSError:
            pass
PY
    ) &
fi

wait "$cpid"
