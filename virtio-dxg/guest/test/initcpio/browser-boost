#!/bin/bash
# browser-boost: keep the default Chromium browser service warm in the background
# without opening any visible or hidden browser/PWA windows, unify user/system flags
# with hardware GPU, V8 Maglev, spare-renderer pooling, and same-site reuse, and
# continuously warm local DNS for all installed .desktop webapps so any PWA and any
# number of concurrent windows start and hydrate rapidly.
set -u

case $(xdg-settings get default-web-browser 2>/dev/null) in
chromium.desktop|"") ;;
*) exit 0 ;;
esac
[ -x /usr/bin/chromium ] || exit 0
pgrep -u "$(id -u)" -x chromium >/dev/null && exit 0

rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$rt"
for _ in $(seq 1 150); do
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$rt/$WAYLAND_DISPLAY" ]; then
        break
    fi
    for s in "$rt"/wayland-*; do
        case $s in *.lock) continue ;; esac
        if [ -S "$s" ]; then
            export WAYLAND_DISPLAY="${s##*/}"
            break 2
        fi
    done
    sleep 0.2
done

sleep "${BOOST_DELAY:-1}"
for _ in $(seq 1 15); do
    [ -f "$rt/vdxg-pso/.ready" ] && break
    sleep 0.2
done
pgrep -u "$(id -u)" -x chromium >/dev/null && exit 0

# Build a single deduplicated argv list by merging /etc/chromium-flags.conf and
# $XDG_CONFIG_HOME/chromium-flags.conf so --enable-features is never duplicated.
if command -v python3 >/dev/null 2>&1 && [ -x /usr/lib/chromium/chromium ]; then
    mapfile -d '' -t chrome_args < <(python3 - <<'PY'
import os, shlex, sys

cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
conf_files = ["/etc/chromium-flags.conf", os.path.join(cfg, "chromium-flags.conf")]

default_features = [
    "TouchpadOverscrollHistoryNavigation",
    "SpareRendererForSitePerProcess",
    "MultipleSpareRPHs:count/4",
    "ProcessPerSiteUpToMainFrameThreshold:ProcessPerSiteMainFrameThreshold/12",
    "ParallelDownloading",
    "BackForwardCache",
    "V8VmFuture",
    "UseDnsHttpsSvcb",
]
base_flags = [
    "--ignore-gpu-blocklist",
    "--enable-gpu-rasterization",
    "--enable-zero-copy",
    "--num-raster-threads=4",
    "--disable-accelerated-video-encode",
    "--disable-quic",
    "--disk-cache-size=536870912",
    "--js-flags=--maglev",
]

enable_map = {}   # feature_base -> full token
disable_set = []
other = []

def add_features(raw, target_dict=None, target_list=None):
    for item in raw.split(","):
        item = item.strip()
        if not item:
            continue
        if target_dict is not None:
            base = item.split(":", 1)[0].split("/", 1)[0]
            if base not in target_dict or ":" in item:
                target_dict[base] = item
        elif item not in target_list:
            target_list.append(item)

for path in conf_files:
    if not os.path.isfile(path):
        continue
    try:
        lines = open(path, encoding="utf-8", errors="ignore").read().splitlines()
    except OSError:
        continue
    for line in lines:
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        try:
            toks = shlex.split(s)
        except ValueError:
            toks = s.split()
        for t in toks:
            if t.startswith("--enable-features="):
                add_features(t[18:], target_dict=enable_map)
            elif t.startswith("--disable-features="):
                add_features(t[19:], target_list=disable_set)
            elif t in ("--no-startup-window", "--keep-alive-for-test"):
                continue
            elif t not in other:
                other.append(t)

for f in default_features:
    base = f.split(":", 1)[0].split("/", 1)[0]
    if base not in enable_map or ":" in f:
        enable_map[base] = f

for bf in base_flags:
    if bf not in other:
        other.append(bf)

out = other + ["--enable-features=" + ",".join(enable_map.values())]
if disable_set:
    out.append("--disable-features=" + ",".join(disable_set))
out.extend(["--no-startup-window", "--keep-alive-for-test"])
sys.stdout.buffer.write(b"\0".join(a.encode() for a in out) + b"\0")
PY
    )
    export CHROME_WRAPPER="${CHROME_WRAPPER:-/usr/bin/chromium}"
    export CHROME_VERSION_EXTRA="${CHROME_VERSION_EXTRA:-Arch Linux}"
    /usr/lib/chromium/chromium "${chrome_args[@]}" &
    cpid=$!
else
    /usr/bin/chromium \
        --ignore-gpu-blocklist \
        --disable-quic \
        --enable-features=TouchpadOverscrollHistoryNavigation,SpareRendererForSitePerProcess,MultipleSpareRPHs:count/4,ProcessPerSiteUpToMainFrameThreshold:ProcessPerSiteMainFrameThreshold/12,ParallelDownloading,BackForwardCache,V8VmFuture,UseDnsHttpsSvcb \
        --js-flags=--maglev \
        --enable-gpu-rasterization --enable-zero-copy --num-raster-threads=4 \
        --disable-accelerated-video-encode \
        --disk-cache-size=536870912 --no-startup-window --keep-alive-for-test &
    cpid=$!
fi

sock="${XDG_CONFIG_HOME:-$HOME/.config}/chromium/SingletonSocket"
for _ in $(seq 1 100); do
    kill -0 "$cpid" 2>/dev/null || exit 0
    [ -S "$sock" ] && break
    sleep 0.1
done

# Dynamically discover all installed .desktop webapps/origins (with zero visible or
# hidden browser windows) and keep systemd-resolved + host DNS warm for instant navigation.
if [ -S "$sock" ] && command -v python3 >/dev/null 2>&1; then
    (
        python3 - "$cpid" <<'PY' >/dev/null 2>&1 || true
import concurrent.futures, glob, os, re, signal, socket, sys, time, urllib.parse

cpid = int(sys.argv[1])
stop = False
def handle_sig(sig, frame):
    global stop
    stop = True
signal.signal(signal.SIGTERM, handle_sig)
signal.signal(signal.SIGINT, handle_sig)

SEED_HOSTS = {
    "youtube.com",
    "www.youtube.com",
    "i.ytimg.com",
    "yt3.ggpht.com",
    "fonts.gstatic.com",
    "fonts.googleapis.com",
    "discord.com",
    "cdn.discordapp.com",
    "gateway.discord.gg",
    "assets.discord.com",
}

def desktop_dirs():
    return [
        os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "applications"),
        "/usr/local/share/applications",
        "/usr/share/applications",
    ]

def scan_hosts():
    hosts = set(SEED_HOSTS)
    mtimes = {}
    for d in desktop_dirs():
        try:
            mtimes[d] = os.stat(d).st_mtime_ns
        except OSError:
            continue
        for df in glob.glob(os.path.join(d, "*.desktop")):
            try:
                txt = open(df, encoding="utf-8", errors="ignore").read()
            except OSError:
                continue
            for m in re.finditer(r"https?://[^\s\"']+", txt):
                h = urllib.parse.urlsplit(m.group(0)).hostname
                if h:
                    hosts.add(h.lower())
    return sorted(hosts), mtimes

def dir_mtimes():
    out = {}
    for d in desktop_dirs():
        try:
            out[d] = os.stat(d).st_mtime_ns
        except OSError:
            pass
    return out

def resolve_one(h):
    try:
        socket.getaddrinfo(h, 443, socket.AF_INET)
    except OSError:
        pass

def resolve_hosts(hosts):
    if not hosts:
        return
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        list(pool.map(resolve_one, hosts))

hosts, last_mtimes = scan_hosts()
resolve_hosts(hosts)
last_dns = time.monotonic()

while not stop:
    try:
        os.kill(cpid, 0)
    except OSError:
        break
    time.sleep(5)
    now = time.monotonic()
    cur_mtimes = dir_mtimes()
    if cur_mtimes != last_mtimes:
        hosts, last_mtimes = scan_hosts()
        resolve_hosts(hosts)
        last_dns = now
    elif now - last_dns >= 45.0:
        resolve_hosts(hosts)
        last_dns = now
PY
    ) &
fi

wait "$cpid"
