#!/bin/bash
# desktop-boost: runtime session warmers for virtio-dxg (controlled by
# virtio_dxg.boost=0). Subcommands:
#   psocache  sync d3d12/dzn PSO + caps caches to tmpfs and compile C helpers
#   files     keep Nautilus GApplication service resident
#   terminal  keep foot/alacritty/ghostty servers warm and seed ghostty-gl.env
#   apps      keep VS Code warm and flock-queued Wayland gate workers for
#             omacalc, gnome-calculator, vkcube, and blender
#   wine      pre-warm wineserver and extend lifetime of active Wine prefixes
set -u

rt_base() {
    printf '%s\n' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
}

boost_dir() {
    printf '%s/vdxg-boost\n' "$(rt_base)"
}

ensure_boost_helpers() {
    local bdir src tmpd
    bdir=$(boost_dir)
    mkdir -p -m 0700 "$bdir" || return 1
    if [ -f "$bdir/.compiled" ] &&
       [ -x "$bdir/vdxg-fastlaunch" ] &&
       [ -f "$bdir/libvdxg-gapp-hold.so" ] &&
       [ -f "$bdir/libvdxg-wl-gate.so" ]; then
        return 0
    fi
    src=/run/virtio-dxg/vdxg_boost_helpers.c
    [ -f "$src" ] || return 1
    command -v gcc >/dev/null 2>&1 || return 1
    (
        flock -x 9 || exit 1
        if [ -f "$bdir/.compiled" ] &&
           [ -x "$bdir/vdxg-fastlaunch" ] &&
           [ -f "$bdir/libvdxg-gapp-hold.so" ] &&
           [ -f "$bdir/libvdxg-wl-gate.so" ]; then
            exit 0
        fi
        tmpd="$bdir/.build.$$"
        mkdir -p "$tmpd" || exit 1
        gcc -shared -fPIC -O2 -Wall -DBUILD_GAPP_HOLD "$src" \
            -o "$tmpd/libvdxg-gapp-hold.so" -ldl -lpthread >/dev/null 2>&1 &&
            mv -f "$tmpd/libvdxg-gapp-hold.so" "$bdir/libvdxg-gapp-hold.so" || true
        gcc -shared -fPIC -O2 -Wall -DBUILD_WL_GATE "$src" \
            -o "$tmpd/libvdxg-wl-gate.so" -ldl -lpthread >/dev/null 2>&1 &&
            mv -f "$tmpd/libvdxg-wl-gate.so" "$bdir/libvdxg-wl-gate.so" || true
        gcc -O2 -Wall -DBUILD_FASTLAUNCH "$src" \
            -o "$tmpd/vdxg-fastlaunch" >/dev/null 2>&1 &&
            chmod 0755 "$tmpd/vdxg-fastlaunch" &&
            mv -f "$tmpd/vdxg-fastlaunch" "$bdir/vdxg-fastlaunch" || true
        rm -rf "$tmpd"
        if [ -x "$bdir/vdxg-fastlaunch" ]; then
            : >"$bdir/.compiled"
        fi
    ) 9>"$bdir/.build.lock"
}

wait_wayland() {
    local rt i=0
    rt=$(rt_base)
    export XDG_RUNTIME_DIR="$rt"
    while [ $i -lt 150 ]; do
        if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$rt/$WAYLAND_DISPLAY" ]; then
            return 0
        fi
        for s in "$rt"/wayland-*; do
            case $s in *.lock) continue ;; esac
            if [ -S "$s" ]; then
                export WAYLAND_DISPLAY="${s##*/}"
                return 0
            fi
        done
        sleep 0.2
        i=$((i + 1))
    done
    return 1
}

wait_hyprland() {
    local rt his
    wait_wayland || return 1
    rt=$(rt_base)
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$rt/hypr" ]; then
        his=$(ls -1 "$rt/hypr" 2>/dev/null | head -1 || true)
        [ -n "$his" ] && export HYPRLAND_INSTANCE_SIGNATURE="$his"
    fi
    return 0
}

sync_file_if_newer() {
    local src=$1 dst=$2 tmp src_sz dst_sz
    [ -f "$src" ] || return 0
    src_sz=$(stat -c %s -- "$src" 2>/dev/null || echo 0)
    dst_sz=$(stat -c %s -- "$dst" 2>/dev/null || echo -1)
    if [ ! -f "$dst" ] || [ "$src" -nt "$dst" ] || [ "$src_sz" -gt "$dst_sz" ]; then
        tmp="${dst%/*}/.${dst##*/}.tmp.$$"
        cp -p -- "$src" "$tmp" 2>/dev/null && mv -f -- "$tmp" "$dst" || rm -f -- "$tmp"
    fi
}

run_psocache() {
    local rt persist sub f
    rt="$(rt_base)/vdxg-pso"
    persist="${MESA_SHADER_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/mesa_shader_cache}"
    mkdir -p -m 0700 "$rt" "$persist" "$rt/d3d12_pso" "$rt/dzn_pso" \
        "$persist/d3d12_pso" "$persist/dzn_pso" || exit 1

    ensure_boost_helpers || true

    for sub in d3d12_pso dzn_pso; do
        for f in "$persist/$sub"/*.bin; do
            sync_file_if_newer "$f" "$rt/$sub/${f##*/}"
        done
    done
    sync_file_if_newer "$persist/d3d12_caps.bin" "$rt/d3d12_caps.bin"
    # Only advertise the tmpfs directory once persistent records are staged.
    : >"$rt/.ready" 2>/dev/null || true

    if command -v fc-list >/dev/null 2>&1 &&
       fc-list : family 2>&1 >/dev/null | grep -q 'newer version'; then
        fc-cache -f >/dev/null 2>&1 &
    fi

    sync_back() {
        local s rf
        for s in d3d12_pso dzn_pso; do
            for rf in "$rt/$s"/*.bin; do
                sync_file_if_newer "$rf" "$persist/$s/${rf##*/}"
            done
        done
        sync_file_if_newer "$rt/d3d12_caps.bin" "$persist/d3d12_caps.bin"
    }

    trap 'sync_back; exit 0' EXIT TERM INT HUP
    while :; do
        sleep "${PSO_SYNC_INTERVAL:-20}" &
        wait $! || break
        sync_back
    done
}

run_files() {
    local bdir
    wait_hyprland || exit 0
    ensure_boost_helpers || true
    bdir=$(boost_dir)
    # systemd user env sets GDK_BACKEND=wayland,x11,* which Nautilus's libgxdp rejects.
    unset GDK_BACKEND
    sleep "${FILES_BOOST_DELAY:-1}"

    if [ -x /usr/bin/nautilus ]; then
        (
            while :; do
                if ! pgrep -u "$(id -u)" -f '/usr/bin/nautilus --gapplication-service' >/dev/null 2>&1; then
                    if [ -f "$bdir/libvdxg-gapp-hold.so" ]; then
                        LD_PRELOAD="$bdir/libvdxg-gapp-hold.so" /usr/bin/nautilus --gapplication-service >/dev/null 2>&1
                    else
                        /usr/bin/nautilus --gapplication-service >/dev/null 2>&1
                    fi
                fi
                sleep 1
            done
        ) &
        for _ in $(seq 1 150); do
            busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
                org.freedesktop.DBus NameHasOwner s org.gnome.Nautilus 2>/dev/null | grep -q 'true' && break
            sleep 0.2
        done
        if busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
            org.freedesktop.DBus NameHasOwner s org.gnome.Nautilus 2>/dev/null | grep -q 'true'; then
            : >"$bdir/files.ready" 2>/dev/null || true
        fi
    fi

    wait
}

run_terminal() {
    local rt bdir
    rt=$(rt_base)
    bdir=$(boost_dir)
    unset GDK_BACKEND
    # Mesa d3d12 exposes OpenGL 4.6 core, so Ghostty never needs the 4.2->4.3 override;
    # seeding ghostty-gl.env avoids a surfaceless EGL probe subprocess on first launch.
    if [ -d "$rt" ]; then
        local gdir="$rt/try-omarchy" gfile="$rt/try-omarchy/ghostty-gl.env" gtmp
        mkdir -p -m 0700 "$gdir" 2>/dev/null || true
        if [ ! -f "$gfile" ]; then
            gtmp="$gfile.tmp.$$"
            printf '# virtio-dxg d3d12 offers OpenGL 4.6 core; no override\n' >"$gtmp" 2>/dev/null &&
                mv -f -- "$gtmp" "$gfile" || rm -f -- "$gtmp"
        fi
    fi

    wait_hyprland || exit 0
    ensure_boost_helpers || true

    if [ -x /usr/bin/foot ] &&
       ! pgrep -u "$(id -u)" -f 'foot.*--server' >/dev/null 2>&1 &&
       [ ! -S "$rt/foot-${WAYLAND_DISPLAY:-wayland-0}.sock" ]; then
        /usr/bin/foot --server >/dev/null 2>&1 &
    fi

    if [ -x /usr/bin/alacritty ] &&
       ! pgrep -u "$(id -u)" -f 'alacritty.*--daemon' >/dev/null 2>&1; then
        /usr/bin/alacritty --socket "$bdir/alacritty.sock" --daemon >/dev/null 2>&1 &
        for _ in $(seq 1 40); do
            [ -S "$bdir/alacritty.sock" ] && break
            sleep 0.1
        done
    fi

    if [ -x /usr/bin/ghostty ]; then
        (
            while :; do
                if ! pgrep -u "$(id -u)" -x ghostty >/dev/null 2>&1; then
                    /usr/bin/ghostty --gtk-single-instance=true --initial-window=false \
                        --quit-after-last-window-closed=false >/dev/null 2>&1
                fi
                sleep 1
            done
        ) &
        for _ in $(seq 1 150); do
            busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
                org.freedesktop.DBus NameHasOwner s com.mitchellh.ghostty 2>/dev/null | grep -q 'true' && break
            sleep 0.2
        done
        if busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
            org.freedesktop.DBus NameHasOwner s com.mitchellh.ghostty 2>/dev/null | grep -q 'true'; then
            : >"$bdir/ghostty.ready" 2>/dev/null || true
        fi
    fi
    wait
}

gate_pool_loop() {
    local bdir sock=$1
    shift
    bdir=$(boost_dir)
    [ -f "$bdir/libvdxg-wl-gate.so" ] || return 0
    while :; do
        (
            unset GDK_BACKEND
            LD_PRELOAD="$bdir/libvdxg-wl-gate.so" VDXG_WL_GATE_SOCK="$sock" exec "$@"
        ) >/dev/null 2>&1 || true
        sleep "${GATE_RESPAWN_DELAY:-0.05}"
    done
}

run_apps() {
    local rt bdir p
    rt=$(rt_base)
    bdir=$(boost_dir)
    wait_hyprland || exit 0
    ensure_boost_helpers || exit 0
    for _ in $(seq 1 50); do
        [ -f "$rt/vdxg-pso/.ready" ] && break
        sleep 0.2
    done

    if [ -x /usr/share/code/code ] && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] &&
       ! ls "$rt"/vscode-*-main.sock >/dev/null 2>&1; then
        ws="$bdir/__vdxg_warm__.code-workspace"
        printf '{"folders":[]}\n' >"$ws"
        if command -v python3 >/dev/null 2>&1; then
            python3 - "$ws" <<'PY' >/dev/null 2>&1 || true
import json, os, socket, subprocess, sys, time

ws = sys.argv[1]
rt = os.environ["XDG_RUNTIME_DIR"]
his = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
sock_path = os.path.join(rt, "hypr", his, ".socket2.sock")

def set_rule(pat):
    expr = f'hl.window_rule({{ name = "vdxg_warm_code", match = {{ class = [[{pat}]] }}, workspace = "special:vdxg_warm silent" }})'
    subprocess.run(["hyprctl", "eval", expr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

try:
    existing = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"], text=True))
except Exception:
    existing = []
if any("code" in c.get("class", "").lower() for c in existing):
    sys.exit(0)

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(sock_path)
    s.settimeout(0.05)
except OSError:
    s.close()
    s = None

set_rule("^(com\\.microsoft\\.VSCode|[Cc]ode)$")
try:
    subprocess.Popen(
        ["/usr/share/code/code", "--ozone-platform=wayland", ws],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
    )
    buf = b""
    deadline = time.monotonic() + 8.0
    mapped = False
    while s is not None and time.monotonic() < deadline and not mapped:
        try:
            buf += s.recv(65536)
        except socket.timeout:
            continue
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            if line.startswith(b"openwindow>>"):
                f = line[12:].decode(errors="replace").split(",", 3)
                if len(f) >= 3 and "code" in f[2].lower():
                    if not f[1].lower().startswith("special:"):
                        a = f[0].removeprefix("0x")
                        subprocess.run(
                            ["hyprctl", "eval", f'hl.dispatch(hl.dsp.window.move({{ workspace = "special:vdxg_warm", follow = false, window = "address:0x{a}" }}))'],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        )
                    mapped = True
                    break
finally:
    if s is not None:
        s.close()
    set_rule("^__vdxg_none__$")
PY
        else
            hyprctl eval 'hl.window_rule({ name = "vdxg_warm_code", match = { title = [[.*__vdxg_warm__.*]] }, workspace = "special:vdxg_warm silent" })' >/dev/null 2>&1 || true
            /usr/share/code/code --ozone-platform=wayland "$ws" >/dev/null 2>&1 &
        fi
    fi

    if [ -f "$bdir/libvdxg-wl-gate.so" ] && [ -x /usr/bin/omacalc ]; then
        gate_pool_loop "$bdir/gate-omacalc.sock" /usr/bin/omacalc &
        ( sleep 0.5; gate_pool_loop "$bdir/gate-omacalc.sock" /usr/bin/omacalc ) &
    fi

    if [ -f "$bdir/libvdxg-wl-gate.so" ] && [ -x /usr/bin/gnome-calculator ]; then
        gate_pool_loop "$bdir/gate-gnome-calculator.sock" /usr/bin/gnome-calculator &
        ( sleep 0.6; gate_pool_loop "$bdir/gate-gnome-calculator.sock" /usr/bin/gnome-calculator ) &
    fi

    if [ -f "$bdir/libvdxg-wl-gate.so" ] && [ -x /usr/bin/vkcube ]; then
        gate_pool_loop "$bdir/gate-vkcube.sock" /usr/bin/vkcube &
        ( sleep 0.4; gate_pool_loop "$bdir/gate-vkcube.sock" /usr/bin/vkcube ) &
    fi

    if [ -f "$bdir/libvdxg-wl-gate.so" ] && [ -x /usr/bin/blender ]; then
        ( sleep 5.5; gate_pool_loop "$bdir/gate-blender-factory.sock" /usr/bin/blender --factory-startup ) &
        ( sleep 8.0; gate_pool_loop "$bdir/gate-blender-factory.sock" /usr/bin/blender --factory-startup ) &
        ( sleep 10.5; gate_pool_loop "$bdir/gate-blender-factory.sock" /usr/bin/blender --factory-startup ) &
        ( sleep 13.0; gate_pool_loop "$bdir/gate-blender.sock" /usr/bin/blender ) &
    fi

    # Monitor .desktop directories every 5s so any newly installed app or webapp
    # has its binary/libraries paged in and its HTTPS DNS resolved automatically.
    (
        python3 - <<'PY' >/dev/null 2>&1 || true
import glob, os, re, shlex, shutil, socket, subprocess, time, urllib.parse
dirs = [os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "applications"),
        "/usr/local/share/applications", "/usr/share/applications"]
seen = {}
for d in dirs:
    for p in glob.glob(os.path.join(d, "*.desktop")):
        try: seen[p] = os.stat(p).st_mtime_ns
        except OSError: pass
while True:
    time.sleep(5)
    for d in dirs:
        for p in glob.glob(os.path.join(d, "*.desktop")):
            try: mt = os.stat(p).st_mtime_ns
            except OSError: continue
            if seen.get(p) == mt:
                continue
            seen[p] = mt
            try: txt = open(p, encoding="utf-8", errors="ignore").read()
            except OSError: continue
            for m in re.finditer(r"https://[^\s\"']+", txt):
                h = urllib.parse.urlsplit(m.group(0)).hostname
                if h:
                    try: socket.getaddrinfo(h, 443, socket.AF_INET)
                    except OSError: pass
            for line in txt.splitlines():
                if line.startswith("Exec="):
                    try: exe = shlex.split(line[5:])[0]
                    except Exception: exe = ""
                    path = shutil.which(exe) if exe else None
                    if path and os.path.isfile(path):
                        try:
                            subprocess.run(["sh", "-c", 'ldd "$1" 2>/dev/null | awk "$3 ~ /^\\// {print $3}" | xargs -r cat >/dev/null 2>&1', "_", path], timeout=5)
                            with open(path, "rb") as f:
                                while f.read(1 << 20): pass
                        except Exception:
                            pass
                    break
PY
    ) &

    wait
}

run_wine() {
    local uid pid pfx bin wbin d
    declare -A boosted
    uid=$(id -u)
    wait_hyprland || true

    for d in "$HOME/vdxg-test" "$HOME/.wine"; do
        [ -d "$d" ] || continue
        if [ -d "$d/wine/bin" ] && [ -x "$d/wine/bin/wineserver" ] && [ -d "$d/prefix/drive_c" ]; then
            WINEPREFIX="$d/prefix" "$d/wine/bin/wineserver" -p >/dev/null 2>&1 &
            cat "$d"/*.dll "$d"/*.so /usr/lib/wsl/drivers/nv*_amd64_*/nvoglv64.dll /mnt/vdxgdrivers/nvoglv64.dll >/dev/null 2>&1 &
            (
                sleep 0.5
                cd "$d" || exit 0
                WINEPREFIX="$d/prefix" WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=" \
                    timeout 6 "$d/wine/bin/wine" cmd.exe /c exit >/dev/null 2>&1 || true
                sleep 2
                if [ -f "$d/nvvkprobe.exe" ] && command -v timeout >/dev/null 2>&1; then
                    WINEPREFIX="$d/prefix" WINEDEBUG=-all WINEDLLOVERRIDES="vulkan-1=n;mscoree,mshtml=" \
                        timeout 10 "$d/wine/bin/wine" "$d/nvvkprobe.exe" >/dev/null 2>&1 || true
                fi
            ) &
        elif [ "$d" = "$HOME/.wine" ] && [ -d "$d/drive_c" ] && command -v wineserver >/dev/null 2>&1; then
            WINEPREFIX="$d" wineserver -p >/dev/null 2>&1 &
        fi
    done

    while :; do
        for pid in $(pgrep -u "$uid" -x wineserver 2>/dev/null || true); do
            [ -z "${boosted[$pid]:-}" ] || continue
            boosted[$pid]=1
            bin=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
            [ -n "$bin" ] && [ -x "$bin" ] || continue
            pfx=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^WINEPREFIX=//p' | head -1)
            if [ -n "$pfx" ]; then
                WINEPREFIX="$pfx" "$bin" -p >/dev/null 2>&1 &
            else
                "$bin" -p >/dev/null 2>&1 &
            fi
        done
        sleep 5
    done
}

case "${1:-}" in
psocache) run_psocache ;;
files)    run_files ;;
terminal) run_terminal ;;
apps)     run_apps ;;
wine)     run_wine ;;
*)        echo "usage: $0 {psocache|files|terminal|apps|wine}" >&2; exit 2 ;;
esac
